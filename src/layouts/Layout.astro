---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "热播影视与4K原盘资源导航 - 高清极速转存", 
  description = "免费提供海量高清4K电影、电视剧、动漫、纪录片无损转存下载与在线播放导航，每日极速更新。" 
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="影视资源,夸克网盘,UC网盘,4K电影下载,电视剧转存,免费电影,网盘分享" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="flex flex-col min-h-screen bg-[#0b0f19] text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0b0f19]/80 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-orange-500 to-amber-400 flex items-center justify-center shadow-lg shadow-orange-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 text-white fill-current" viewBox="0 0 24 24">
              <path d="M4 6.47v11.06c0 .77.85 1.25 1.51.84l8.84-5.53c.63-.39.63-1.3 0-1.69L5.51 5.63C4.85 5.22 4 5.7 4 6.47z"/>
            </svg>
          </div>
          <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-slate-400">
            星光影库
          </span>
        </a>

        <!-- 导航菜单 -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-orange-400 transition-colors">全部精选</a>
          <a href="/explore" class="text-orange-400 hover:text-orange-300 transition-colors flex items-center gap-1.5 font-semibold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>片库检索</span>
          </a>
          <a href="/explore?cat=电影" class="hover:text-orange-400 transition-colors">电影</a>
          <a href="/explore?cat=电视剧" class="hover:text-orange-400 transition-colors">电视剧</a>
          <a href="/explore?cat=动漫" class="hover:text-orange-400 transition-colors">动漫</a>
          <a href="/explore?cat=纪录片" class="hover:text-orange-400 transition-colors">纪录片</a>
        </nav>

        <!-- 检索与搜索入口 -->
        <div class="flex items-center gap-2.5">
          <a href="https://t.me/xkykMovie" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/30 text-xs font-semibold text-sky-400 hover:text-sky-300 transition-all flex items-center gap-1.5 shadow-sm">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
            <span>TG 影迷群</span>
          </a>
          <a href="/explore" class="px-3 py-1.5 rounded-lg bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-xs font-semibold text-orange-400 transition-all flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>高级筛选</span>
          </a>
          <a href="/#search-section" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/60 text-xs font-medium text-slate-300 transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="hidden sm:inline">搜索片源</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 主体内容 -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- 底部 Footer -->
    <footer class="mt-20 border-t border-slate-800/80 bg-[#070a12] py-12 text-slate-500 text-xs text-center">
      <div class="max-w-7xl mx-auto px-4 space-y-3">
        <p class="font-medium text-slate-400 text-sm">星光影库 · 专注于高清影视与合规资源极速分享</p>
        <p>官方 Telegram 4K 影迷交流群：<a href="https://t.me/xkykMovie" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:underline font-semibold">@xkykMovie</a>（每日同步新片广播与求片互助）</p>
        <p>免责声明：本站所有资源均来自互联网公开网盘分享，本站仅提供检索导航服务，不存储、不上载任何音视频文件。</p>
        <p class="text-slate-600">© 2026 Starlight Media. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
