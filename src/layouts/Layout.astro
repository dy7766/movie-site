---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "热播影视与4K原盘资源导航 - 高清极速转存", 
  description = "免费提供海量高清4K电影、电视剧、动漫、纪录片无损转存下载与在线播放导航，每日极速更新。" 
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="影视资源,夸克网盘,UC网盘,4K电影下载,电视剧转存,免费电影,网盘分享" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="flex flex-col min-h-screen bg-[#0b0f19] text-slate-100 antialiased selection:bg-orange-500 selection:text-white">
    <!-- 顶部导航 -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0b0f19]/80 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="relative flex items-center justify-center">
            <div class="absolute -inset-1 bg-gradient-to-r from-amber-500/20 to-orange-500/20 rounded-full blur-md opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <svg class="w-8 h-8 relative group-hover:scale-110 group-hover:drop-shadow-[0_0_12px_rgba(249,115,22,0.6)] transition-all duration-300" viewBox="0 0 48 48" fill="none">
              <defs>
                <linearGradient id="headerStarlightGrad" x1="0" y1="0" x2="48" y2="48" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FCD34D"/>
                  <stop offset="60%" stop-color="#F97316"/>
                  <stop offset="100%" stop-color="#EA580C"/>
                </linearGradient>
              </defs>
              <path d="M24 4C24 15 29 20 40 24C29 28 24 33 24 44C24 33 19 28 8 24C19 20 24 15 24 4Z" fill="url(#headerStarlightGrad)"/>
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-slate-400 group-hover:from-white group-hover:to-orange-200 transition-colors">
            星光影库
          </span>
        </a>

        <!-- 导航菜单 -->
        <nav class="flex items-center gap-3 sm:gap-5 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-orange-400 transition-colors whitespace-nowrap">全部精选</a>
          <a href="/explore" class="text-orange-400 hover:text-orange-300 transition-colors flex items-center gap-1.5 font-semibold whitespace-nowrap">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>片库检索</span>
          </a>

          <!-- 交互式搜索组件：紧随片库检索后面 -->
          <div class="relative flex items-center" id="navSearchContainer">
            <!-- 未展开时的交互触发按钮 -->
            <button 
              id="navSearchTrigger" 
              type="button"
              class="px-2.5 py-1.5 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/60 text-xs font-medium text-slate-300 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-sm hover:border-orange-500/40"
              title="点击展开搜索输入框"
            >
              <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span class="whitespace-nowrap">搜索片源</span>
            </button>

            <!-- 展开后的交互式搜索框与确定按钮 -->
            <div 
              id="navSearchBox" 
              class="hidden items-center gap-1.5 bg-slate-900 border border-orange-500/80 rounded-xl px-2 py-1 shadow-lg shadow-orange-500/10 transition-all"
            >
              <svg class="w-3.5 h-3.5 text-orange-400 shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input 
                type="text" 
                id="navSearchInput" 
                placeholder="输入片名/演员/导演..." 
                class="bg-transparent text-xs text-white placeholder-slate-500 focus:outline-none w-28 sm:w-48"
              />
              <button 
                id="navSearchConfirm" 
                type="button" 
                class="px-2.5 py-1 rounded-lg bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold transition-all cursor-pointer shadow-sm shrink-0"
              >
                确定
              </button>
              <button 
                id="navSearchClose" 
                type="button" 
                class="text-slate-400 hover:text-white text-xs px-1 cursor-pointer shrink-0"
                title="收起"
              >
                ✕
              </button>
            </div>
          </div>
        </nav>

        <!-- 检索与社区入口 -->
        <div class="flex items-center gap-2.5">
          <a href="https://t.me/xkykMovie" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/30 text-xs font-semibold text-sky-400 hover:text-sky-300 transition-all flex items-center gap-1.5 shadow-sm">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
            <span>TG 影迷群</span>
          </a>
          <a href="/explore" class="px-3 py-1.5 rounded-lg bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30 text-xs font-semibold text-orange-400 transition-all flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>高级筛选</span>
          </a>
        </div>
      </div>
    </header>

    <!-- 主体内容 -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- 底部 Footer -->
    <footer class="mt-20 border-t border-slate-800/80 bg-[#070a12] py-12 text-slate-500 text-xs text-center">
      <div class="max-w-7xl mx-auto px-4 space-y-3.5">
        <div class="flex items-center justify-center gap-2">
          <svg class="w-4 h-4 text-orange-400" viewBox="0 0 48 48" fill="none">
            <path d="M24 4C24 15 29 20 40 24C29 28 24 33 24 44C24 33 19 28 8 24C19 20 24 15 24 4Z" fill="currentColor"/>
          </svg>
          <span class="font-medium text-slate-300 text-sm">星光影库 · 专注于高清影视与合规资源极速分享</span>
        </div>

        <!-- 官方联络与交流矩阵 -->
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="text-slate-500">影迷社区:</span>
            <a href="https://t.me/xkykMovie" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300 hover:underline font-medium flex items-center gap-1">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
              <span>@xkykMovie</span>
            </a>
          </span>
          <span class="text-slate-700 hidden sm:inline">|</span>
          <span class="flex items-center gap-1.5">
            <span class="text-slate-500">求片与反馈:</span>
            <a href="mailto:service@xkykmovie.com" class="text-amber-400 hover:text-amber-300 hover:underline font-mono">service@xkykmovie.com</a>
          </span>
          <span class="text-slate-700 hidden sm:inline">|</span>
          <span class="flex items-center gap-1.5">
            <span class="text-slate-500">商务合作:</span>
            <a href="mailto:contact@xkykmovie.com" class="text-amber-400 hover:text-amber-300 hover:underline font-mono">contact@xkykmovie.com</a>
          </span>
        </div>

        <p class="text-slate-500 max-w-2xl mx-auto leading-relaxed">免责声明：本站所有资源均来自互联网公开网盘分享，本站仅提供检索导航服务，不存储、不上载任何音视频文件。若有侵权请通过上述邮箱联系处理。</p>
        <p class="text-slate-600">© 2026 Starlight Media (xkykmovie.com). All rights reserved.</p>
      </div>
    </footer>

    <!-- 顶部全局交互式搜索控制逻辑 -->
    <script is:inline>
      const navTrigger = document.getElementById('navSearchTrigger');
      const navBox = document.getElementById('navSearchBox');
      const navInput = document.getElementById('navSearchInput');
      const navConfirm = document.getElementById('navSearchConfirm');
      const navClose = document.getElementById('navSearchClose');

      function openNavSearch() {
        if (!navTrigger || !navBox || !navInput) return;
        navTrigger.classList.add('hidden');
        navBox.classList.remove('hidden');
        navBox.classList.add('flex');
        navInput.focus();
      }

      function closeNavSearch() {
        if (!navTrigger || !navBox || !navInput) return;
        navBox.classList.add('hidden');
        navBox.classList.remove('flex');
        navTrigger.classList.remove('hidden');
        if (!navInput.value.trim()) {
          executeSearch('');
        }
      }

      function executeSearch(val) {
        const q = (val !== undefined ? val : (navInput ? navInput.value : '')).trim();
        const isHomePage = window.location.pathname === '/' || window.location.pathname === '';
        if (isHomePage) {
          window.dispatchEvent(new CustomEvent('site:search', { detail: { keyword: q } }));
          // 平滑滚动至资源列表
          const target = document.getElementById('resources-section');
          if (target) {
            const top = target.getBoundingClientRect().top + window.pageYOffset - 70;
            window.scrollTo({ top, behavior: 'smooth' });
          }
        } else {
          window.location.href = `/?q=${encodeURIComponent(q)}#resources-section`;
        }
      }

      navTrigger?.addEventListener('click', openNavSearch);
      navClose?.addEventListener('click', closeNavSearch);
      navConfirm?.addEventListener('click', () => executeSearch());
      navInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeSearch();
        } else if (e.key === 'Escape') {
          closeNavSearch();
        }
      });

      // 自动同步 URL 中的搜索关键字 ?q=...
      try {
        const urlParams = new URLSearchParams(window.location.search);
        const qParam = urlParams.get('q');
        if (qParam && navInput) {
          navInput.value = qParam;
          openNavSearch();
        }
      } catch (_) {}
    </script>
  </body>
</html>
