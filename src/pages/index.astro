---
import Layout from '../layouts/Layout.astro';
import { getMovies } from '../lib/db.js';

let movies = [];
try {
  movies = await getMovies({ limit: 1000 });
} catch (e) {
  console.error('Failed to fetch movies from db:', e);
}

const categories = ['全部', '电影', '电视剧', '动漫', '综艺', '纪录片'];
---

<Layout title="星光影库 - 4K高清影视与网盘无损资源分享">
  <!-- Hero Section (移动端隐藏以首屏直达影视海报，桌面端保留紧凑版) -->
  <section class="hidden md:block relative py-4 sm:py-6 overflow-hidden border-b border-slate-800/60 bg-gradient-to-b from-slate-900/40 via-[#0b0f19] to-[#0b0f19]">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-orange-500/10 via-transparent to-transparent pointer-events-none"></div>
    
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-2">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-[11px] font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
        每日精选 · 4K原盘无损转存 · 极速免广告切片云播
      </div>

      <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold tracking-tight text-white">
        发现海量热门影视 · 
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-orange-400 to-amber-300">
          一键秒存至你的私人网盘
        </span>
      </h1>

      <p class="text-slate-400 text-xs sm:text-sm max-w-xl mx-auto">
        零广告打扰，支持夸克网盘、UC网盘原画高速转存与极速在线播放，每日持续同步最新院线大片与热播剧集。
      </p>
    </div>
  </section>

  <!-- 资源列表与分类筛选 -->
  <section class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-3.5 sm:py-7" id="resources-section">
    <!-- 筛选控制栏：分类与资源可用性 -->
    <div class="space-y-4 mb-8">
      <!-- 分类标签 -->
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
          {categories.map((cat, idx) => (
            <button 
              class={`category-tab px-4 py-1.5 rounded-xl text-xs font-medium transition-all ${
                idx === 0 
                  ? 'bg-orange-500 text-white shadow-sm shadow-orange-500/30' 
                  : 'bg-slate-900/80 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800'
              }`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>

        <div class="text-xs text-slate-400 font-medium">
          已收录 <span id="movieCount" class="text-orange-400 font-semibold">{movies.length}</span> 部精选资源
        </div>
      </div>

      <!-- 资源可用性显式过滤 -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none text-xs border-t border-slate-800/60 pt-3">
        <span class="text-slate-400 font-medium whitespace-nowrap min-w-[56px]">资源可用：</span>
        <button type="button" class="avail-tab px-3 py-1 rounded-lg text-xs font-semibold bg-orange-500 text-white shadow-sm transition-all" data-avail="all">
          全部资源
        </button>
        <button type="button" class="avail-tab px-3 py-1 rounded-lg text-xs font-medium bg-slate-900/80 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800 transition-all" data-avail="playable">
          🟢 仅可在线播放
        </button>
        <button type="button" class="avail-tab px-3 py-1 rounded-lg text-xs font-medium bg-slate-900/80 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800 transition-all" data-avail="savable">
          ⚡ 仅可网盘转存
        </button>
        <button type="button" class="avail-tab px-3 py-1 rounded-lg text-xs font-medium bg-slate-900/80 text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-800 transition-all" data-avail="both">
          🎬 双料全能 (可播可存)
        </button>
      </div>
    </div>

    <!-- 电影网格卡片 (移动端双列大图瀑布流) -->
    <div id="movieGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-6">
      {movies.map((m) => (
        <article class="movie-card group bg-slate-900/60 rounded-2xl overflow-hidden border border-slate-800/80 hover:border-orange-500/40 hover:shadow-xl hover:shadow-orange-500/5 transition-all flex flex-col"
          data-title={m.title}
          data-actors={m.actors || ''}
          data-category={m.category || '电影'}
          data-playable={m.online_play_url ? 'true' : 'false'}
          data-savable={(m.share_link || m.share_link_uc) ? 'true' : 'false'}
          data-released={m.is_released === false ? 'false' : 'true'}
        >
          <!-- 封面海报容器 (点击进入详情页) -->
          <a href={`/movie/${m.id}`} class="relative aspect-[2/3] w-full overflow-hidden bg-slate-800 block">
            <img 
              src={m.poster_url || 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=400&auto=format&fit=crop'} 
              alt={m.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <!-- 评分角标 -->
            {m.score && (
              <div class="absolute top-2 right-2 px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-md border border-white/10 text-amber-400 text-xs font-bold flex items-center gap-1 shadow">
                ★ {Number(m.score).toFixed(1)}
              </div>
            )}
            <!-- 待播 / 网盘 / 在线播放多状态角标 -->
            {m.is_released === false ? (
              <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-purple-900/90 border border-purple-500/40 backdrop-blur-md text-purple-200 text-[10px] font-bold tracking-wide shadow flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
                待播 / 待映
              </div>
            ) : (m.online_play_url && (m.share_link || m.share_link_uc)) ? (
              <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-gradient-to-r from-emerald-600 to-teal-500 backdrop-blur-md text-white text-[10px] font-bold tracking-wide uppercase shadow flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
                可播可存
              </div>
            ) : m.online_play_url ? (
              <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-indigo-600/90 backdrop-blur-md text-white text-[10px] font-semibold tracking-wide shadow flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-200 animate-pulse"></span>
                可在线播放
              </div>
            ) : (m.share_link && m.share_link_uc) ? (
              <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-gradient-to-r from-orange-600 to-amber-500 backdrop-blur-md text-white text-[10px] font-bold tracking-wide uppercase shadow flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                双网盘秒传
              </div>
            ) : m.share_link ? (
              <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-orange-600/90 backdrop-blur-md text-white text-[10px] font-semibold tracking-wide uppercase shadow">
                夸克秒传
              </div>
            ) : m.share_link_uc ? (
              <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-amber-500/90 backdrop-blur-md text-slate-950 text-[10px] font-bold tracking-wide uppercase shadow">
                UC秒传
              </div>
            ) : (
              <div class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-slate-900/90 backdrop-blur-md border border-slate-700/60 text-slate-400 text-[10px] font-medium tracking-wide shadow">
                待补资源
              </div>
            )}
          </a>

          <!-- 卡片信息 -->
          <div class="p-3.5 flex flex-col flex-grow justify-between space-y-2">
            <div>
              <a href={`/movie/${m.id}`} class="block">
                <h3 class="text-sm font-bold text-white group-hover:text-orange-400 transition-colors line-clamp-1">
                  {m.title}
                </h3>
              </a>
              <p class="text-xs text-slate-400 line-clamp-1 mt-0.5">
                {m.year ? `${m.year} · ` : ''}{m.country ? `${m.country} · ` : ''}{m.actors || '暂无主演信息'}
              </p>

              <!-- 资源标签：待上映 / 连载中 / 已完结 / 可播放 / 可转存 -->
              <div class="flex items-center gap-1.5 flex-wrap pt-1.5">
                {m.is_released === false ? (
                  <span class="inline-flex items-center gap-1 text-[10px] font-medium text-purple-400 bg-purple-500/10 border border-purple-500/30 px-1.5 py-0.5 rounded">
                    ⏳ 待上映 / 待播
                  </span>
                ) : (
                  <>
                    {(m.category === '电视剧' || m.category === '动漫' || m.category === '综艺') && (
                      m.is_finished === false ? (
                        <span class="inline-flex items-center gap-1 text-[10px] font-medium text-rose-400 bg-rose-500/10 border border-rose-500/30 px-1.5 py-0.5 rounded">
                          🔥 连载中{m.current_episode ? ` · 更至${m.current_episode}${m.category === '综艺' ? '期' : '集'}` : ''}
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1 text-[10px] font-medium text-sky-400 bg-sky-500/10 border border-sky-500/30 px-1.5 py-0.5 rounded">
                          ✅ 已完结{m.total_episodes ? ` · 全${m.total_episodes}${m.category === '综艺' ? '期' : '集'}` : ''}
                        </span>
                      )
                    )}
                    {m.online_play_url && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-medium text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-1.5 py-0.5 rounded">
                        <span class="w-1 h-1 rounded-full bg-emerald-400"></span>可播放
                      </span>
                    )}
                    {(m.share_link || m.share_link_uc) && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-medium text-amber-400 bg-amber-500/10 border border-amber-500/30 px-1.5 py-0.5 rounded">
                        <span class="w-1 h-1 rounded-full bg-amber-400"></span>可转存
                      </span>
                    )}
                    {(!m.online_play_url && !m.share_link && !m.share_link_uc) && (
                      <span class="inline-flex items-center gap-1 text-[10px] font-medium text-slate-400 bg-slate-800/80 border border-slate-700/50 px-1.5 py-0.5 rounded">
                        待补资源
                      </span>
                    )}
                  </>
                )}
              </div>
            </div>

            <!-- 转存按钮或暂无资源说明 -->
            {m.is_released === false ? (
              <a 
                href={`/movie/${m.id}`}
                class="w-full py-2 rounded-xl bg-purple-950/30 hover:bg-purple-900/40 text-purple-400 hover:text-purple-300 border border-purple-500/30 text-xs font-semibold text-center transition-all flex items-center justify-center gap-1.5"
              >
                <span>🕒 待上映 · 查看详情</span>
              </a>
            ) : (m.share_link && m.share_link_uc) ? (
              <a 
                href={`/movie/${m.id}`}
                class="w-full py-2 rounded-xl bg-gradient-to-r from-orange-500/20 via-amber-500/20 to-orange-500/20 hover:from-orange-500 hover:to-amber-500 text-orange-400 hover:text-white border border-orange-500/30 hover:border-orange-500 text-xs font-bold text-center transition-all flex items-center justify-center gap-1.5 shadow-sm"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
                </svg>
                <span>双网盘转存 (夸克/UC)</span>
              </a>
            ) : m.share_link ? (
              <a 
                href={m.share_link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full py-2 rounded-xl bg-orange-500/10 hover:bg-orange-500 text-orange-400 hover:text-white border border-orange-500/30 hover:border-orange-500 text-xs font-semibold text-center transition-all flex items-center justify-center gap-1.5 shadow-sm"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
                </svg>
                <span>立即转存</span>
              </a>
            ) : m.share_link_uc ? (
              <a 
                href={m.share_link_uc} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500 text-amber-400 hover:text-slate-950 border border-amber-500/30 hover:border-amber-500 text-xs font-bold text-center transition-all flex items-center justify-center gap-1.5 shadow-sm"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
                </svg>
                <span>UC立即转存</span>
              </a>
            ) : m.online_play_url ? (
              <a 
                href={`/movie/${m.id}#onlinePlayerSection`}
                class="w-full py-2 rounded-xl bg-indigo-500/10 hover:bg-indigo-600 text-indigo-400 hover:text-white border border-indigo-500/30 hover:border-indigo-500 text-xs font-semibold text-center transition-all flex items-center justify-center gap-1.5 shadow-sm group-hover:bg-indigo-600 group-hover:text-white"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <span>在线播放</span>
              </a>
            ) : (
              <a 
                href={`/movie/${m.id}`}
                class="w-full py-2 rounded-xl bg-slate-800/60 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-700/60 text-xs font-medium text-center transition-all flex items-center justify-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>暂无资源 · 待上线</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- 分页导航控件 -->
    <div id="homePagination" class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-800/80 pt-6">
      <div class="text-xs text-slate-400">
        显示第 <span id="homePageRangeText" class="text-slate-200 font-semibold">1-20</span> 部，共 <span id="homeTotalItemsText" class="text-orange-400 font-bold">{movies.length}</span> 部资源
      </div>

      <div class="flex items-center gap-1.5 flex-wrap justify-center" id="homePageBtnGroup">
        <!-- 动态生成页码 -->
      </div>
    </div>

    <!-- 空状态提示 -->
    <div id="emptyState" class={`text-center py-20 ${movies.length === 0 ? '' : 'hidden'}`}>
      <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-600 mb-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
        </svg>
      </div>
      <h3 class="text-base font-semibold text-slate-300">暂未找到相关资源</h3>
      <p class="text-xs text-slate-500 mt-1">数据正在陆续录入中，请稍后刷新查看...</p>
    </div>
  </section>

  <!-- 前端交互逻辑（分类筛选、多维过滤、全局联动搜索与翻页） -->
  <script is:inline>
    const categoryTabs = document.querySelectorAll('.category-tab');
    const availTabs = document.querySelectorAll('.avail-tab');
    const cards = Array.from(document.querySelectorAll('.movie-card'));
    const emptyState = document.getElementById('emptyState');
    const movieCount = document.getElementById('movieCount');

    const paginationBox = document.getElementById('homePagination');
    const pageBtnGroup = document.getElementById('homePageBtnGroup');
    const pageRangeText = document.getElementById('homePageRangeText');
    const totalItemsText = document.getElementById('homeTotalItemsText');

    const PAGE_SIZE = 20;
    let currentPage = 1;
    let currentCategory = '全部';
    let currentAvail = 'all';
    let currentKeyword = '';
    let currentMatchedCards = [];

    function renderPaginationUI(totalItems, page, onPageChange) {
      const totalPages = Math.ceil(totalItems / PAGE_SIZE) || 1;

      if (totalItems <= PAGE_SIZE) {
        if (paginationBox) paginationBox.classList.add('hidden');
        return;
      }
      if (paginationBox) paginationBox.classList.remove('hidden');

      const start = (page - 1) * PAGE_SIZE + 1;
      const end = Math.min(page * PAGE_SIZE, totalItems);
      if (pageRangeText) pageRangeText.textContent = `${start}-${end}`;
      if (totalItemsText) totalItemsText.textContent = totalItems;

      if (!pageBtnGroup) return;
      pageBtnGroup.innerHTML = '';

      // 上一页
      const prevBtn = document.createElement('button');
      prevBtn.type = 'button';
      prevBtn.disabled = page === 1;
      prevBtn.className = `px-3 py-1.5 rounded-xl text-xs font-semibold border transition-all ${
        page === 1 
          ? 'opacity-30 cursor-not-allowed bg-slate-900 border-slate-800 text-slate-500' 
          : 'bg-slate-800 hover:bg-slate-700 border-slate-700 text-slate-300 hover:text-white'
      }`;
      prevBtn.innerHTML = `上一页`;
      prevBtn.onclick = () => onPageChange(page - 1);
      pageBtnGroup.appendChild(prevBtn);

      // 计算页码列表
      let pages = [];
      if (totalPages <= 7) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        pages.push(1);
        if (page > 3) pages.push('...');
        const startP = Math.max(2, page - 1);
        const endP = Math.min(totalPages - 1, page + 1);
        for (let i = startP; i <= endP; i++) {
          if (!pages.includes(i)) pages.push(i);
        }
        if (page < totalPages - 2) pages.push('...');
        if (!pages.includes(totalPages)) pages.push(totalPages);
      }

      pages.forEach(p => {
        if (p === '...') {
          const dots = document.createElement('span');
          dots.className = 'px-1.5 text-xs text-slate-500 font-mono';
          dots.textContent = '...';
          pageBtnGroup.appendChild(dots);
        } else {
          const pageBtn = document.createElement('button');
          pageBtn.type = 'button';
          const isActive = p === page;
          pageBtn.className = `w-8 h-8 rounded-xl text-xs font-bold transition-all ${
            isActive 
              ? 'bg-orange-500 text-white shadow-lg shadow-orange-500/25 border border-orange-400' 
              : 'bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800'
          }`;
          pageBtn.textContent = p;
          pageBtn.onclick = () => onPageChange(p);
          pageBtnGroup.appendChild(pageBtn);
        }
      });

      // 下一页
      const nextBtn = document.createElement('button');
      nextBtn.type = 'button';
      nextBtn.disabled = page === totalPages;
      nextBtn.className = `px-3 py-1.5 rounded-xl text-xs font-semibold border transition-all ${
        page === totalPages 
          ? 'opacity-30 cursor-not-allowed bg-slate-900 border-slate-800 text-slate-500' 
          : 'bg-slate-800 hover:bg-slate-700 border-slate-700 text-slate-300 hover:text-white'
      }`;
      nextBtn.innerHTML = `下一页`;
      nextBtn.onclick = () => onPageChange(page + 1);
      pageBtnGroup.appendChild(nextBtn);
    }

    function displayPage(page, shouldScroll = false) {
      currentPage = page;
      const startIdx = (currentPage - 1) * PAGE_SIZE;
      const endIdx = startIdx + PAGE_SIZE;

      cards.forEach(card => card.classList.add('hidden'));

      currentMatchedCards.forEach((card, idx) => {
        if (idx >= startIdx && idx < endIdx) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      renderPaginationUI(currentMatchedCards.length, currentPage, (newPage) => {
        displayPage(newPage, true);
      });

      if (shouldScroll) {
        const target = document.getElementById('resources-section');
        if (target) {
          const top = target.getBoundingClientRect().top + window.pageYOffset - 80;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }
    }

    function filterCards(resetToPage1 = true) {
      currentMatchedCards = [];

      cards.forEach(card => {
        const title = card.getAttribute('data-title')?.toLowerCase() || '';
        const actors = card.getAttribute('data-actors')?.toLowerCase() || '';
        const cat = card.getAttribute('data-category') || '';
        const isPlayable = card.getAttribute('data-playable') === 'true';
        const isSavable = card.getAttribute('data-savable') === 'true';

        const matchCat = currentCategory === '全部' || cat === currentCategory;
        const matchSearch = !currentKeyword || title.includes(currentKeyword) || actors.includes(currentKeyword);
        
        let matchAvail = true;
        if (currentAvail === 'playable') {
          matchAvail = isPlayable;
        } else if (currentAvail === 'savable') {
          matchAvail = isSavable;
        } else if (currentAvail === 'both') {
          matchAvail = (isPlayable && isSavable);
        }

        if (matchCat && matchSearch && matchAvail) {
          currentMatchedCards.push(card);
        }
      });

      // 无论何种筛选，未公映/未开播资源一律往后压
      currentMatchedCards.sort((a, b) => {
        const aUnreleased = a.getAttribute('data-released') === 'false' ? 1 : 0;
        const bUnreleased = b.getAttribute('data-released') === 'false' ? 1 : 0;
        return aUnreleased - bUnreleased;
      });

      if (movieCount) movieCount.textContent = currentMatchedCards.length;
      if (emptyState) {
        if (currentMatchedCards.length === 0) emptyState.classList.remove('hidden');
        else emptyState.classList.add('hidden');
      }

      if (resetToPage1) currentPage = 1;
      displayPage(currentPage, false);
    }

    // 全局交互式搜索事件联动监听
    window.addEventListener('site:search', (e) => {
      currentKeyword = (e.detail?.keyword || '').trim().toLowerCase();
      filterCards(true);
    });

    // 页面初次初始化时若带 ?q= 则自动应用关键字搜索
    try {
      const qVal = new URLSearchParams(window.location.search).get('q');
      if (qVal) {
        currentKeyword = qVal.trim().toLowerCase();
      }
    } catch (_) {}

    // 分类切换
    categoryTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach(t => {
          t.classList.remove('bg-orange-500', 'text-white', 'shadow-sm', 'shadow-orange-500/30');
          t.classList.add('bg-slate-900/80', 'text-slate-400', 'border', 'border-slate-800');
        });
        tab.classList.remove('bg-slate-900/80', 'text-slate-400', 'border', 'border-slate-800');
        tab.classList.add('bg-orange-500', 'text-white', 'shadow-sm', 'shadow-orange-500/30');

        currentCategory = tab.getAttribute('data-category');
        filterCards(true);
      });
    });

    // 资源可用性过滤切换
    availTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        availTabs.forEach(t => {
          t.classList.remove('bg-orange-500', 'text-white', 'shadow-sm', 'font-semibold');
          t.classList.add('bg-slate-900/80', 'text-slate-400', 'border', 'border-slate-800', 'font-medium');
        });
        tab.classList.remove('bg-slate-900/80', 'text-slate-400', 'border', 'border-slate-800', 'font-medium');
        tab.classList.add('bg-orange-500', 'text-white', 'shadow-sm', 'font-semibold');

        currentAvail = tab.getAttribute('data-avail') || 'all';
        filterCards(true);
      });
    });

    // 页面初次初始化
    filterCards(false);
  </script>
</Layout>
