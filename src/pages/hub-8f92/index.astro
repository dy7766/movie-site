      }

      function renderPagination(totalPages) {
        if (totalPages <= 1) {
          paginationButtons.innerHTML = '';
          return;
        }

        let btns = '';
        btns += `
          <button 
            onclick="goToPage(${state.currentPage - 1})" 
            ${state.currentPage === 1 ? 'disabled class="opacity-40 cursor-not-allowed"' : 'class="hover:bg-slate-800 text-slate-300 cursor-pointer"'}
            class="px-2.5 py-1 text-xs rounded-lg bg-slate-900 border border-slate-800 transition"
          >
            上一页
          </button>
        `;

        for (let i = 1; i <= totalPages; i++) {
          if (i === 1 || i === totalPages || (i >= state.currentPage - 2 && i <= state.currentPage + 2)) {
            const isActive = i === state.currentPage;
            btns += `
              <button 
                onclick="goToPage(${i})" 
                class="px-2.5 py-1 text-xs rounded-lg transition font-mono cursor-pointer ${
                  isActive 
                    ? 'bg-orange-500 text-white font-bold' 
                    : 'bg-slate-900 text-slate-300 border border-slate-800 hover:bg-slate-800'
                }"
              >
                ${i}
              </button>
            `;
          } else if (i === state.currentPage - 3 || i === state.currentPage + 3) {
            btns += `<span class="text-xs text-slate-600 px-1">...</span>`;
          }
        }

        btns += `
          <button 
            onclick="goToPage(${state.currentPage + 1})" 
            ${state.currentPage === totalPages ? 'disabled class="opacity-40 cursor-not-allowed"' : 'class="hover:bg-slate-800 text-slate-300 cursor-pointer"'}
            class="px-2.5 py-1 text-xs rounded-lg bg-slate-900 border border-slate-800 transition"
          >
            下一页
          </button>
        `;

        paginationButtons.innerHTML = btns;
      }

      window.goToPage = function(p) {
        state.currentPage = p;
        render();
        window.scrollTo({ top: tableViewWrapper.offsetTop - 120, behavior: 'smooth' });
      };

      // ==========================================
      // 4. 详情抽屉 (按三大名词清晰归纳)
      // ==========================================
      window.openDetailModal = function(id) {
        const m = rawMovies.find(item => item.id === id);
        if (!m) return;

        // 顶栏
        document.getElementById('modalCategory').textContent = m.category || '电影';
        document.getElementById('modalTitle').textContent = m.title;
        document.getElementById('modalYear').textContent = m.year ? `${m.year} 年` : '';

        // 1. 库内影视元数据
        document.getElementById('modalPoster').src = m.poster_url || '/favicon.svg';
        document.getElementById('modalId').textContent = m.id;
        document.getElementById('modalOriginalTitle').textContent = m.original_title || '-';
        document.getElementById('modalScore').textContent = m.score ? `★ ${parseFloat(m.score).toFixed(1)}` : '暂无评分';
        document.getElementById('modalCountry').textContent = m.country || '华语';
        document.getElementById('modalActors').textContent = m.actors || '暂无演职员信息';
        document.getElementById('modalIntro').textContent = m.intro || '暂无剧情简介。';

        const metaBadge = document.getElementById('modalMetaBadge');
        if (m.has_metadata) {
          metaBadge.className = 'px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
          metaBadge.textContent = '✅ 已过审发布';
        } else {
          metaBadge.className = 'px-2 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30';
          metaBadge.textContent = '⏳ 待补元数据';
        }

        const isTv = m.category === '电视剧' || m.category === '综艺' || m.category === '动漫';
        let tvStr = '单部作品';
        if (isTv) {
          tvStr = m.is_finished ? `已完结 (全 ${m.total_episodes || m.current_episode} 集)` : `连载追更中 (更新至第 ${m.current_episode || 1} 集 / 全 ${m.total_episodes || '?'} 集)`;
        }
        document.getElementById('modalSeriesStatus').textContent = tvStr;

        // 2. 自有网盘转存资产
        const qkLink = document.getElementById('modalQuarkLink');
        const qkStatus = document.getElementById('modalQuarkStatus');
        const qkCopy = document.getElementById('modalQuarkCopy');
        if (m.share_link) {
          qkStatus.textContent = '已挂载';
          qkStatus.className = 'text-[10px] text-purple-400';
          qkLink.href = m.share_link;
          qkLink.classList.remove('opacity-40', 'pointer-events-none');
          qkCopy.onclick = () => copyToClipboard(m.share_link, '已复制夸克转存专属链接');
        } else {
          qkStatus.textContent = '未挂载';
          qkStatus.className = 'text-[10px] text-slate-500';
          qkLink.href = '#';
          qkLink.classList.add('opacity-40', 'pointer-events-none');
          qkCopy.onclick = () => showToast('暂无夸克链接', '⚠️');
        }

        const ucLink = document.getElementById('modalUcLink');
        const ucStatus = document.getElementById('modalUcStatus');
        const ucCopy = document.getElementById('modalUcCopy');
        if (m.share_link_uc) {
          ucStatus.textContent = '已挂载';
          ucStatus.className = 'text-[10px] text-cyan-400';
          ucLink.href = m.share_link_uc;
          ucLink.classList.remove('opacity-40', 'pointer-events-none');
          ucCopy.onclick = () => copyToClipboard(m.share_link_uc, '已复制 UC 转存专属链接');
        } else {
          ucStatus.textContent = '未挂载';
          ucStatus.className = 'text-[10px] text-slate-500';
          ucLink.href = '#';
          ucLink.classList.add('opacity-40', 'pointer-events-none');
          ucCopy.onclick = () => showToast('暂无 UC 链接', '⚠️');
        }

        const playStatus = document.getElementById('modalPlayStatus');
        const playTestBtn = document.getElementById('modalPlayTestBtn');
        const playCopy = document.getElementById('modalPlayCopy');
        if (m.online_play_url) {
          playStatus.textContent = '可秒播';
          playStatus.className = 'text-[10px] text-rose-400';
          playTestBtn.classList.remove('opacity-40', 'pointer-events-none');
          playTestBtn.onclick = () => playHlsStream(m.online_play_url);
          playCopy.onclick = () => copyToClipboard(m.online_play_url, '已复制 M3U8 流媒体地址');
        } else {
          playStatus.textContent = '无源';
          playStatus.className = 'text-[10px] text-slate-500';
          playTestBtn.classList.add('opacity-40', 'pointer-events-none');
          playCopy.onclick = () => showToast('暂无在线切片流', '⚠️');
        }

        document.getElementById('modalViews').textContent = m.views || 0;
        document.getElementById('modalClicksQuark').textContent = m.clicks_quark || 0;
        document.getElementById('modalClicksUc').textContent = m.clicks_uc || 0;
        document.getElementById('modalClicksPlay').textContent = m.clicks_play || 0;

        // 3. 上游公开分享源溯源
        document.getElementById('modalSourcePwdId').textContent = m.source_pwd_id || '无记录';
        document.getElementById('modalUcFid').textContent = m.uc_fid || '无记录';
        document.getElementById('modalHarvestTime').textContent = m.last_harvest_at ? new Date(m.last_harvest_at).toLocaleString('zh-CN') : '-';
        document.getElementById('modalEpUpdateTime').textContent = m.last_episode_updated_at ? new Date(m.last_episode_updated_at).toLocaleString('zh-CN') : '-';

        // 前台直达
        const frontLink = document.getElementById('modalFrontLink');
        if (m.has_metadata) {
          frontLink.href = `/movie/${m.id}`;
          frontLink.classList.remove('hidden');
        } else {
          frontLink.classList.add('hidden');
        }

        // 剧照
        const stillsSection = document.getElementById('modalStillsSection');
        const stillsGrid = document.getElementById('modalStillsGrid');
        if (m.stills && Array.isArray(m.stills) && m.stills.length > 0) {
          stillsSection.classList.remove('hidden');
          stillsGrid.innerHTML = m.stills.map(s => `
            <img src="${s}" alt="剧照" class="h-16 w-28 object-cover rounded border border-slate-700 flex-shrink-0" />
          `).join('');
        } else {
          stillsSection.classList.add('hidden');
        }

        // 原始 JSON
        document.getElementById('modalRawJson').textContent = JSON.stringify(m, null, 2);

        // 展开抽屉
        document.getElementById('detailModal').classList.remove('hidden');
      };

      function playHlsStream(url) {
        const playerSection = document.getElementById('playerSection');
        const video = document.getElementById('hlsVideo');
        const streamUrlText = document.getElementById('currentStreamUrl');
        
        playerSection.classList.remove('hidden');
        streamUrlText.textContent = url;

        if (hlsInstance) {
          hlsInstance.destroy();
          hlsInstance = null;
        }

        if (window.Hls && window.Hls.isSupported()) {
          hlsInstance = new window.Hls();
          hlsInstance.loadSource(url);
          hlsInstance.attachMedia(video);
          hlsInstance.on(window.Hls.Events.MANIFEST_PARSED, () => video.play());
          hlsInstance.on(window.Hls.Events.ERROR, (e, data) => {
            if (data.fatal) showToast('M3U8 解析失败或跨域受阻', '⚠️');
          });
        } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = url;
          video.play();
        } else {
          showToast('当前浏览器不支持 HLS 原生播放', '⚠️');
        }
      }

      document.getElementById('closePlayerBtn').addEventListener('click', () => {
        const video = document.getElementById('hlsVideo');
        video.pause();
        if (hlsInstance) { hlsInstance.destroy(); hlsInstance = null; }
        document.getElementById('playerSection').classList.add('hidden');
      });

      const closeDetailModal = () => {
        document.getElementById('closePlayerBtn').click();
        document.getElementById('detailModal').classList.add('hidden');
      };
      document.getElementById('closeModalBtn').addEventListener('click', closeDetailModal);
      document.getElementById('closeModalBottomBtn').addEventListener('click', closeDetailModal);
      document.getElementById('detailModal').addEventListener('click', (e) => {
        if (e.target.id === 'detailModal') closeDetailModal();
      });

      // 名词规范 Modal
      document.getElementById('openGlossaryBtn').addEventListener('click', () => {
        document.getElementById('glossaryModal').classList.remove('hidden');
      });
      document.getElementById('closeGlossaryBtn').addEventListener('click', () => {
        document.getElementById('glossaryModal').classList.add('hidden');
      });
      document.getElementById('glossaryModal').addEventListener('click', (e) => {
        if (e.target.id === 'glossaryModal') {
          document.getElementById('glossaryModal').classList.add('hidden');
        }
      });

      // 绑定分类筛选按钮
      document.querySelectorAll('[data-cat-btn]').forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat-btn');
          state.currentCategory = cat;

          document.querySelectorAll('[data-cat-btn]').forEach(b => {
            b.className = 'cat-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 border cursor-pointer bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-800 hover:text-white';
          });
          btn.className = 'cat-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 border cursor-pointer bg-orange-500/20 text-orange-300 border-orange-500/40 shadow-sm';

          filterAndSortMovies();
        });
      });

      // 搜索框输入（防抖）
      let searchTimer = null;
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        state.searchTerm = val;
        clearSearchBtn.classList.toggle('hidden', !val);
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => filterAndSortMovies(), 150);
      });

      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        state.searchTerm = '';
        clearSearchBtn.classList.add('hidden');
        filterAndSortMovies();
      });

      // 快捷核心状态
      statusFilter.addEventListener('change', (e) => {
        state.quickStatus = e.target.value;
        filterAndSortMovies();
      });

      // 排序
      sortBySelect.addEventListener('change', (e) => {
        state.sortBy = e.target.value;
        filterAndSortMovies();
      });

      // 每页条数
      pageSizeSelect.addEventListener('change', (e) => {
        state.pageSize = parseInt(e.target.value, 10);
        state.currentPage = 1;
        render();
      });

      // 视图切换
      viewTableBtn.addEventListener('click', () => {
        state.viewMode = 'table';
        viewTableBtn.className = 'px-2 py-1 rounded text-xs transition bg-orange-500 text-white cursor-pointer';
        viewGridBtn.className = 'px-2 py-1 rounded text-xs transition text-slate-400 hover:text-white cursor-pointer';
        render();
      });

      viewGridBtn.addEventListener('click', () => {
        state.viewMode = 'grid';
        viewGridBtn.className = 'px-2 py-1 rounded text-xs transition bg-orange-500 text-white cursor-pointer';
        viewTableBtn.className = 'px-2 py-1 rounded text-xs transition text-slate-400 hover:text-white cursor-pointer';
        render();
      });

      // 高级属性筛选面板切换
      toggleAdvancedFilterBtn.addEventListener('click', () => {
        advancedFilterPanel.classList.toggle('hidden');
      });

      // 绑定各个高级属性下拉
      const advInputs = [
        { id: 'advFilterMeta', key: 'meta' },
        { id: 'advFilterReleased', key: 'released' },
        { id: 'advFilterFinished', key: 'finished' },
        { id: 'advFilterQuark', key: 'quark' },
        { id: 'advFilterUc', key: 'uc' },
        { id: 'advFilterPlay', key: 'play' },
        { id: 'advFilterSource', key: 'source' },
        { id: 'advFilterScore', key: 'score' }
      ];

      advInputs.forEach(({ id, key }) => {
        const el = document.getElementById(id);
        if (el) {
          el.addEventListener('change', (e) => {
            state.filters[key] = e.target.value;
            filterAndSortMovies();
          });
        }
      });

      // 重置所有筛选
      document.getElementById('resetFiltersBtn').addEventListener('click', () => {
        state.searchTerm = '';
        searchInput.value = '';
        clearSearchBtn.classList.add('hidden');
        state.currentCategory = '全部';
        state.quickStatus = 'all';
        statusFilter.value = 'all';
        state.sortBy = 'year_score_created';
        sortBySelect.value = 'year_score_created';

        advInputs.forEach(({ id, key }) => {
          state.filters[key] = 'all';
          const el = document.getElementById(id);
          if (el) el.value = 'all';
        });

        document.querySelectorAll('[data-cat-btn]').forEach(b => {
          b.className = 'cat-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 border cursor-pointer bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-800 hover:text-white';
        });
        const allCatBtn = document.querySelector('[data-cat-btn="全部"]');
        if (allCatBtn) allCatBtn.className = 'cat-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 border cursor-pointer bg-orange-500/20 text-orange-300 border-orange-500/40 shadow-sm';

        filterAndSortMovies();
        showToast('已重置所有属性筛选条件', '🔄');
      });

      // 复制 ID 快捷键
      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('copy-btn')) {
          const targetId = e.target.getAttribute('data-copy-target');
          const el = document.getElementById(targetId);
          if (el) copyToClipboard(el.textContent, '已复制');
        }
      });

      // 导出 CSV 功能
      document.getElementById('exportCsvBtn').addEventListener('click', () => {
        const items = state.movies;
        if (items.length === 0) {
          showToast('当前无可用数据导出', '⚠️');
          return;
        }

        const headers = ['UUID', '片名', '原始片名', '分类', '年份', '评分', '国家', '元数据就绪', '夸克网盘链接', 'UC网盘链接', '在线播放M3U8', '连载集数', '完结状态', '上游采集ID', '入库时间'];
        const rows = items.map(m => [
          m.id,
          `"${(m.title || '').replace(/"/g, '""')}"`,
          `"${(m.original_title || '').replace(/"/g, '""')}"`,
          m.category || '',
          m.year || '',
          m.score || '',
          m.country || '',
          m.has_metadata ? '是' : '否',
          `"${(m.share_link || '').replace(/"/g, '""')}"`,
          `"${(m.share_link_uc || '').replace(/"/g, '""')}"`,
          `"${(m.online_play_url || '').replace(/"/g, '""')}"`,
          m.current_episode || '',
          m.is_finished ? '已完结' : '连载中',
          m.source_pwd_id || '',
          m.created_at || ''
        ]);

        const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `starlight_movies_realtime_${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
        showToast(`已导出当前筛选的 ${items.length} 部影视数据为 CSV`, '📥');
      });

      // 导出 JSON 功能
      document.getElementById('exportJsonBtn').addEventListener('click', () => {
        const items = state.movies;
        const blob = new Blob([JSON.stringify(items, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `starlight_movies_realtime_${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast(`已导出当前筛选的 ${items.length} 部影视数据为 JSON`, '📄');
      });

      // ==========================================
      // 5. 真实转化大盘与网盘转存控制开关
      // ==========================================
      async function getSupabaseCount(queryPath) {
        try {
          const res = await fetch(`${SUPABASE_BASE_URL}/${queryPath}`, {
            headers: {
              'apikey': SUPABASE_PUB_KEY,
              'Authorization': `Bearer ${SUPABASE_PUB_KEY}`,
              'Prefer': 'count=exact',
              'Range-Unit': 'items',
              'Range': '0-0'
            }
          });
          const cr = res.headers.get('content-range');
          if (!cr) return 0;
          const parts = cr.split('/');
          return parts[1] ? parseInt(parts[1], 10) : 0;
        } catch (_) {
          return 0;
        }
      }

      async function refreshLiveAnalytics(manual = false) {
        const spinner = document.getElementById('refreshSpinner');
        const statusText = document.getElementById('liveStatusText');
        const lastUpdated = document.getElementById('lastUpdatedTime');
        if (spinner) spinner.classList.add('animate-spin');
        if (statusText) statusText.textContent = manual ? '正在同步最新指标...' : '实时连接中...';

        try {
          // 并发拉取实时 6 维计数器、最近事件流水与 TOP 10 转化最高影视
          const [pv, mobilePv, desktopPv, quark, uc, play, recentRes, topMoviesRes] = await Promise.all([
            getSupabaseCount('analytics_events?event_type=eq.page_view&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.page_view&device=eq.mobile&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.page_view&device=eq.desktop&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.click_quark&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.click_uc&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.click_play&select=id'),
            fetch(`${SUPABASE_BASE_URL}/analytics_events?order=created_at.desc&limit=15`, {
              headers: { 'apikey': SUPABASE_PUB_KEY, 'Authorization': `Bearer ${SUPABASE_PUB_KEY}` }
            }).then(r => r.json()).catch(() => []),
            fetch(`${SUPABASE_BASE_URL}/resources?has_metadata=eq.true&or=(views.gt.0,clicks_quark.gt.0,clicks_uc.gt.0,clicks_play.gt.0)&order=clicks_quark.desc,clicks_uc.desc,views.desc&limit=15`, {
              headers: { 'apikey': SUPABASE_PUB_KEY, 'Authorization': `Bearer ${SUPABASE_PUB_KEY}` }
            }).then(r => r.json()).catch(() => [])
          ]);

          const saves = quark + uc;
          const cvr = pv > 0 ? ((saves / pv) * 100).toFixed(2) : '0.00';
          const playRate = pv > 0 ? ((play / pv) * 100).toFixed(2) : '0.00';

          const elPv = document.getElementById('metricTotalPv');
          const elMobile = document.getElementById('metricMobilePv');
          const elDesktop = document.getElementById('metricDesktopPv');
          const elSaves = document.getElementById('metricTotalSaves');
          const elQuark = document.getElementById('metricQuarkSaves');
          const elUc = document.getElementById('metricUcSaves');
          const elCvr = document.getElementById('metricSaveRate');
          const elCvrBar = document.getElementById('metricSaveRateBar');
          const elPlays = document.getElementById('metricTotalPlays');
          const elPlayRate = document.getElementById('metricPlayRate');

          if (elPv) elPv.textContent = pv.toLocaleString();
          if (elMobile) elMobile.textContent = `📱 移动端 ${mobilePv}`;
          if (elDesktop) elDesktop.textContent = `💻 电脑端 ${desktopPv}`;
          if (elSaves) elSaves.textContent = saves.toLocaleString();
          if (elQuark) elQuark.textContent = `夸克: ${quark}`;
          if (elUc) elUc.textContent = `UC: ${uc}`;
          if (elCvr) elCvr.textContent = `${cvr}%`;
          if (elCvrBar) elCvrBar.style.width = `${Math.min(100, Math.max(0, parseFloat(cvr)))}%`;
          if (elPlays) elPlays.textContent = play.toLocaleString();
          if (elPlayRate) elPlayRate.textContent = `${playRate}%`;

          // 更新流水
          const recentList = document.getElementById('recentEventsList');
          if (recentList && Array.isArray(recentRes)) {
            if (recentRes.length === 0) {
              recentList.innerHTML = `<div class="text-center py-10 text-slate-500 text-xs">等待第一条埋点上报...</div>`;
            } else {
              const evLabels = {
                page_view: { text: 'PV 浏览', color: 'bg-blue-500/20 text-blue-300 border-blue-500/30' },
                click_quark: { text: '夸克保存', color: 'bg-purple-500/20 text-purple-300 border-purple-500/30' },
                click_uc: { text: 'UC保存', color: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30' },
                click_play: { text: '在线播放', color: 'bg-rose-500/20 text-rose-300 border-rose-500/30' }
              };
              recentList.innerHTML = recentRes.map(ev => {
                const badge = evLabels[ev.event_type] || { text: ev.event_type, color: 'bg-slate-800 text-slate-400 border-slate-700' };
                const timeStr = new Date(ev.created_at).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                const uidRaw = ev.visitor_id || (ev.ip ? `ip_${ev.ip}` : '');
                const uidBadge = uidRaw ? `<span class="px-1.5 py-0.5 rounded bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 font-mono text-[9px]" title="${uidRaw}">👤 ${uidRaw.slice(0, 10)}</span>` : '';
                const ipBadge = ev.ip ? `<span class="px-1.5 py-0.5 rounded bg-slate-800/90 text-slate-300 border border-slate-700/60 font-mono text-[9px]">📍 ${ev.ip}${ev.location ? ` (${ev.location.split(',')[0]})` : ''}</span>` : '';
                return `
                  <div class="flex items-center justify-between text-xs p-2 rounded-lg bg-slate-900/60 border border-slate-800/50">
                    <div class="flex items-center gap-2 overflow-hidden">
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-medium border flex-shrink-0 ${badge.color}">${badge.text}</span>
                      <span class="text-slate-200 truncate text-[11px]">${ev.resource_title || '星光影库页面'}</span>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0 text-[10px] font-mono text-slate-400">
                      ${uidBadge}
                      ${ipBadge}
                      <span>${ev.device === 'mobile' ? '📱' : '💻'}</span>
                      <span class="text-slate-500">${timeStr}</span>
                    </div>
                  </div>
                `;
              }).join('');
            }
          }

          // 更新 TOP 10
          const topBody = document.getElementById('topConvertingTableBody');
          if (topBody && Array.isArray(topMoviesRes)) {
            const ranked = topMoviesRes.map(m => {
              const savesCount = (m.clicks_quark || 0) + (m.clicks_uc || 0);
              const viewsCount = m.views || 0;
              const rate = viewsCount > 0 ? ((savesCount / viewsCount) * 100).toFixed(1) : '0.0';
              return { ...m, total_saves: savesCount, rate };
            }).sort((a, b) => b.total_saves - a.total_saves).slice(0, 10);

            topBody.innerHTML = ranked.map((item, idx) => `
              <tr class="hover:bg-slate-900/50 transition">
                <td class="py-2 px-2 text-center font-mono text-slate-500">${idx + 1}</td>
                <td class="py-2 px-3 text-slate-200 font-medium">
                  <a href="/movie/${item.id}" target="_blank" class="hover:text-orange-400 transition hover:underline">${item.title}</a>
                  ${item.year ? `<span class="text-slate-500 font-normal ml-1">(${item.year})</span>` : ''}
                </td>
                <td class="py-2 px-2 text-center text-slate-400">
                  <span class="px-1.5 py-0.5 rounded bg-slate-800 text-[10px]">${item.category || '电影'}</span>
                </td>
                <td class="py-2 px-2 text-center font-mono text-slate-300">${item.views || 0}</td>
                <td class="py-2 px-2 text-center font-mono text-purple-300">${item.clicks_quark || 0}</td>
                <td class="py-2 px-2 text-center font-mono text-cyan-300">${item.clicks_uc || 0}</td>
                <td class="py-2 px-2 text-center font-mono text-amber-300 font-bold">${item.total_saves || 0}</td>
                <td class="py-2 px-3 text-right">
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-orange-500/10 text-orange-400 border border-orange-500/30">${item.rate}%</span>
                </td>
              </tr>
            `).join('');
          }

          const now = new Date();
          const timeStr = now.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          if (statusText) statusText.textContent = '实时已连接';
          if (lastUpdated) lastUpdated.textContent = `最后刷新: ${timeStr}`;

          // 并行拉取转存设置与趋势图表
          fetchTransferSettings();
          loadTrafficChart(currentChartDays);

          if (manual) showToast('大盘与全量资源已完成实时刷新！', '⚡');
        } catch (err) {
          if (statusText) statusText.textContent = '实时刷新失败';
        } finally {
          if (spinner) spinner.classList.remove('animate-spin');
        }
      }

      // ==========================================
      // 6. 转存控制开关管理
      // ==========================================
      let currentTransferState = { uc: true, quark: true };
      const ucToggle = document.getElementById('ucToggleInput');
      const quarkToggle = document.getElementById('quarkToggleInput');

      async function fetchTransferSettings() {
        try {
          const res = await fetch(`${SUPABASE_BASE_URL}/system_settings?key=eq.transfer_settings&select=value,updated_at`, {
            headers: { 'apikey': SUPABASE_PUB_KEY, 'Authorization': `Bearer ${SUPABASE_PUB_KEY}` }
          });
          const data = await res.json();
          if (data?.[0]?.value) {
            updateTransferSwitchUi({
              uc: data[0].value.uc !== false,
              quark: data[0].value.quark !== false,
              updated_at: data[0].updated_at || data[0].value.updated_at
            });
          }
        } catch (_) {}
      }

      function updateTransferSwitchUi(settings) {
        if (!settings) return;
        currentTransferState = { ...currentTransferState, ...settings };

        if (ucToggle && ucToggle.checked !== currentTransferState.uc) ucToggle.checked = currentTransferState.uc;
        const ucBadge = document.getElementById('ucStatusBadge');
        const ucDot = document.getElementById('ucStatusDot');
        const ucLabel = document.getElementById('ucStatusLabel');
        if (ucBadge && ucDot && ucLabel) {
          if (currentTransferState.uc) {
            ucBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium border bg-emerald-500/10 text-emerald-300 border-emerald-500/30';
            ucDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse';
            ucLabel.textContent = '运行中 (允许转存)';
          } else {
            ucBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium border bg-rose-500/10 text-rose-300 border-rose-500/30';
            ucDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-400';
            ucLabel.textContent = '已暂停 (跳过转存)';
          }
        }

        if (quarkToggle && quarkToggle.checked !== currentTransferState.quark) quarkToggle.checked = currentTransferState.quark;
        const qkBadge = document.getElementById('quarkStatusBadge');
        const qkDot = document.getElementById('quarkStatusDot');
        const qkLabel = document.getElementById('quarkStatusLabel');
        if (qkBadge && qkDot && qkLabel) {
          if (currentTransferState.quark) {
            qkBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium border bg-emerald-500/10 text-emerald-300 border-emerald-500/30';
            qkDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse';
            qkLabel.textContent = '运行中 (允许转存)';
          } else {
            qkBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium border bg-rose-500/10 text-rose-300 border-rose-500/30';
            qkDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-400';
            qkLabel.textContent = '已暂停 (跳过转存)';
          }
        }

        const timeEl = document.getElementById('transferSettingsUpdatedTime');
        if (timeEl && currentTransferState.updated_at) {
          try {
            const d = new Date(currentTransferState.updated_at);
            timeEl.textContent = `上次变更: ${d.toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })}`;
          } catch (_) {}
        }
      }

      async function saveTransferSetting(provider, enabled) {
        const syncBadge = document.getElementById('transferSettingsSyncBadge');
        if (syncBadge) {
          syncBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span> 正在保存...';
        }

        const newSettings = {
          uc: provider === 'uc' ? enabled : currentTransferState.uc,
          quark: provider === 'quark' ? enabled : currentTransferState.quark
        };

        updateTransferSwitchUi({ ...newSettings, updated_at: new Date().toISOString() });

        try {
          let success = false;
          try {
            const apiRes = await fetch('/api/transfer-settings', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(newSettings)
            });
            if (apiRes.ok) {
              const resData = await apiRes.json();
              if (resData.success) success = true;
            }
          } catch (_) {}

          if (!success) {
            const patchRes = await fetch(`${SUPABASE_BASE_URL}/system_settings?key=eq.transfer_settings`, {
              method: 'PATCH',
              headers: {
                'apikey': SUPABASE_PUB_KEY,
                'Authorization': `Bearer ${SUPABASE_PUB_KEY}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                value: { ...newSettings, updated_at: new Date().toISOString() },
                updated_at: new Date().toISOString()
              })
            });
            if (patchRes.ok) success = true;
          }

          if (success) {
            const providerName = provider === 'uc' ? 'UC 网盘' : '夸克网盘';
            showToast(`${providerName} ${enabled ? '已开启自动转存' : '已暂停自动转存'}`, enabled ? '🟢' : '⏸️');
            if (syncBadge) syncBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> 实时同步成功';
          }
        } catch (err) {
          showToast('保存失败，请检查网络', '❌');
          if (syncBadge) syncBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> 保存失败';
        }
      }

      ucToggle?.addEventListener('change', (e) => saveTransferSetting('uc', e.target.checked));
      quarkToggle?.addEventListener('change', (e) => saveTransferSetting('quark', e.target.checked));

      // ==========================================
      // 7. 访问量与转存量趋势图表 (Chart.js)
      // ==========================================
      let currentChartDays = 7;
      let trafficChartInstance = null;

      function formatCstDateKey(dateObj) {
        const cst = new Date(dateObj.getTime() + 8 * 3600 * 1000);
        return cst.toISOString().slice(0, 10);
      }

      async function fetchAnalyticsWindow(sinceIso) {
        const allRows = [];
        const pageSize = 1000;
        let offset = 0;
        while (offset < 10000) {
          const url = `${SUPABASE_BASE_URL}/analytics_events?select=event_type,created_at,visitor_id,ip&created_at=gte.${encodeURIComponent(sinceIso)}&event_type=in.(page_view,click_quark,click_uc)&order=created_at.asc&limit=${pageSize}&offset=${offset}`;
          const res = await fetch(url, {
            headers: { 'apikey': SUPABASE_PUB_KEY, 'Authorization': `Bearer ${SUPABASE_PUB_KEY}` }
          });
          if (!res.ok) break;
          const batch = await res.json();
          if (!Array.isArray(batch) || batch.length === 0) break;
          allRows.push(...batch);
          if (batch.length < pageSize) break;
          offset += pageSize;
        }
        return allRows;
      }

      async function loadTrafficChart(days = 7) {
        currentChartDays = days;
        const summaryEl = document.getElementById('chartSummaryBadge');
        const canvas = document.getElementById('trafficSavesChart');
        if (!canvas || typeof window.Chart === 'undefined') {
          if (summaryEl) summaryEl.textContent = '图表引擎加载中...';
          window.addEventListener('DOMContentLoaded', () => loadTrafficChart(currentChartDays), { once: true });
          return;
        }

        try {
          const now = new Date();
          const dayKeys = [];
          const buckets = {};
          for (let i = days - 1; i >= 0; i--) {
            const d = new Date(now.getTime() - i * 86400 * 1000);
            const key = formatCstDateKey(d);
            dayKeys.push(key);
            buckets[key] = { pv: 0, quark: 0, uc: 0, uvSet: new Set() };
          }

          // 从窗口第一天东八区 00:00:00 开始拉取
          const startDate = new Date(`${dayKeys[0]}T00:00:00+08:00`);
          const rows = await fetchAnalyticsWindow(startDate.toISOString());

          let sumPv = 0;
          let sumSaves = 0;
          const periodUvSet = new Set();
          for (const row of rows) {
            const key = formatCstDateKey(new Date(row.created_at));
            const b = buckets[key];
            if (!b) continue;
            const uid = row.visitor_id || (row.ip ? `ip_${row.ip}` : '');
            if (uid) {
              b.uvSet.add(uid);
              periodUvSet.add(uid);
            }
            if (row.event_type === 'page_view') {
              b.pv += 1;
              sumPv += 1;
            } else if (row.event_type === 'click_quark') {
              b.quark += 1;
              sumSaves += 1;
            } else if (row.event_type === 'click_uc') {
              b.uc += 1;
              sumSaves += 1;
            }
          }

          const labels = dayKeys.map(k => k.slice(5)); // MM-DD
          const pvData = dayKeys.map(k => buckets[k].pv);
          const uvData = dayKeys.map(k => buckets[k].uvSet.size);
          const savesData = dayKeys.map(k => buckets[k].quark + buckets[k].uc);
          const quarkData = dayKeys.map(k => buckets[k].quark);
          const ucData = dayKeys.map(k => buckets[k].uc);

          const elPeriodUv = document.getElementById('metricPeriodUv');
          const elUvDelta = document.getElementById('metricUvDelta');

          const todayKey = dayKeys[dayKeys.length - 1];
          const yesterdayKey = dayKeys.length >= 2 ? dayKeys[dayKeys.length - 2] : null;
          const todayUv = buckets[todayKey].uvSet.size;
          const yesterdayUv = yesterdayKey ? buckets[yesterdayKey].uvSet.size : 0;
          const uvDelta = todayUv - yesterdayUv;

          // 计算今日首次来访的新 UV（在前几天窗口中未出现过的独立访客）
          const prevUvSet = new Set();
          for (let i = 0; i < dayKeys.length - 1; i++) {
            for (const uid of buckets[dayKeys[i]].uvSet) prevUvSet.add(uid);
          }
          let newTodayUv = 0;
          for (const uid of buckets[todayKey].uvSet) {
            if (!prevUvSet.has(uid)) newTodayUv += 1;
          }

          if (elPeriodUv) elPeriodUv.textContent = `今日UV ${todayUv} (新客 ${newTodayUv})`;
          if (elUvDelta) {
            const deltaText = uvDelta > 0 ? `+${uvDelta}` : `${uvDelta}`;
            elUvDelta.textContent = `较昨日 ${deltaText}`;
            elUvDelta.className = `font-mono text-[10px] ${uvDelta > 0 ? 'text-emerald-400' : (uvDelta < 0 ? 'text-rose-400' : 'text-slate-400')}`;
          }

          if (summaryEl) {
            const periodCvr = sumPv > 0 ? ((sumSaves / sumPv) * 100).toFixed(1) : '0.0';
            summaryEl.textContent = `近${days}天: ${periodUvSet.size} UV (今日+${newTodayUv}新客) / ${sumPv} PV / ${sumSaves} 转存 (${periodCvr}%)`;
          }

          if (trafficChartInstance) {
            trafficChartInstance.destroy();
          }

          trafficChartInstance = new window.Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
              labels,
              datasets: [
                {
                  type: 'line',
                  label: '网盘总转存',
                  data: savesData,
                  yAxisID: 'ySaves',
                  borderColor: '#f59e0b',
                  backgroundColor: 'rgba(245, 158, 11, 0.15)',
                  borderWidth: 2.5,
                  pointBackgroundColor: '#fbbf24',
                  pointRadius: 3.5,
                  pointHoverRadius: 5,
                  tension: 0.35,
                  fill: true,
                  order: 1
                },
                {
                  type: 'line',
                  label: '独立访客 (UV)',
                  data: uvData,
                  yAxisID: 'yPv',
                  borderColor: '#10b981',
                  borderWidth: 2,
                  pointBackgroundColor: '#34d399',
                  pointRadius: 3,
                  tension: 0.35,
                  fill: false,
                  order: 2
                },
                {
                  type: 'line',
                  label: '夸克转存',
                  data: quarkData,
                  yAxisID: 'ySaves',
                  borderColor: '#a855f7',
                  borderWidth: 1.5,
                  borderDash: [4, 4],
                  pointRadius: 2,
                  tension: 0.35,
                  fill: false,
                  order: 3
                },
                {
                  type: 'line',
                  label: 'UC转存',
                  data: ucData,
                  yAxisID: 'ySaves',
                  borderColor: '#06b6d4',
                  borderWidth: 1.5,
                  borderDash: [4, 4],
                  pointRadius: 2,
                  tension: 0.35,
                  fill: false,
                  order: 4
                },
                {
                  type: 'bar',
                  label: '访问量 (PV)',
                  data: pvData,
                  yAxisID: 'yPv',
                  backgroundColor: 'rgba(59, 130, 246, 0.35)',
                  borderColor: 'rgba(96, 165, 250, 0.8)',
                  borderWidth: 1,
                  borderRadius: 6,
                  maxBarThickness: 28,
                  order: 5
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              interaction: { mode: 'index', intersect: false },
              plugins: {
                legend: {
                  labels: { color: '#cbd5e1', font: { size: 11 }, boxWidth: 12, usePointStyle: true }
                },
                tooltip: {
                  backgroundColor: 'rgba(15, 23, 42, 0.95)',
                  titleColor: '#f8fafc',
                  bodyColor: '#cbd5e1',
                  borderColor: '#334155',
                  borderWidth: 1,
                  padding: 10,
                  callbacks: {
                    afterBody: (items) => {
                      const idx = items?.[0]?.dataIndex;
                      if (idx === undefined) return '';
                      const p = pvData[idx] || 0;
                      const s = savesData[idx] || 0;
                      const rate = p > 0 ? ((s / p) * 100).toFixed(1) : '0.0';
                      return `当日转存转化率: ${rate}%`;
                    }
                  }
                }
              },
              scales: {
                x: {
                  grid: { color: 'rgba(51, 65, 85, 0.25)' },
                  ticks: { color: '#94a3b8', font: { size: 11 } }
                },
                yPv: {
                  type: 'linear',
                  position: 'left',
                  beginAtZero: true,
                  suggestedMax: 10,
                  grid: { color: 'rgba(51, 65, 85, 0.35)' },
                  ticks: { color: '#60a5fa', font: { size: 11 }, precision: 0 },
                  title: { display: true, text: '访问量 (PV)', color: '#60a5fa', font: { size: 10 } }
                },
                ySaves: {
                  type: 'linear',
                  position: 'right',
                  beginAtZero: true,
                  suggestedMax: 5,
                  grid: { drawOnChartArea: false },
                  ticks: { color: '#fbbf24', font: { size: 11 }, precision: 0 },
                  title: { display: true, text: '转存量 (次)', color: '#fbbf24', font: { size: 10 } }
                }
              }
            }
          });
        } catch (err) {
          if (summaryEl) summaryEl.textContent = '图表加载失败';
        }
      }

      document.querySelectorAll('.chart-range-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const days = parseInt(btn.getAttribute('data-days') || '7', 10);
          document.querySelectorAll('.chart-range-btn').forEach(b => {
            b.className = 'chart-range-btn px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-900 text-slate-400 border border-slate-800 hover:text-slate-200 cursor-pointer transition';
          });
          btn.className = 'chart-range-btn px-2.5 py-1 rounded-lg text-[11px] font-medium bg-orange-500/20 text-orange-300 border border-orange-500/40 cursor-pointer transition';
          loadTrafficChart(days);
        });
      });

      // 实时全量刷新按钮
      document.getElementById('refreshLiveMetricsBtn')?.addEventListener('click', () => {
        fetchLiveResources();
        refreshLiveAnalytics(true);
      });

      // 初始化：立即执行实时全量拉取
      fetchLiveResources();
      refreshLiveAnalytics(false);

      // 开启静默轮询（每 25 秒在标签页处于前台时自动刷新）
      setInterval(() => {
        if (!document.hidden) {
          fetchLiveResources();
          refreshLiveAnalytics(false);
        }
      }, 25000);
    </script>
  </body>
</html>
