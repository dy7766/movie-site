---
// 星光影库 · 资产与数据中枢管理后台 (Hub-8f92)
// 100% 纯动态边缘直连大盘架构：零静态构建数据依赖，所有 KPI 指标、分类统计与全量资源列表均在客户端实时查询 Supabase REST / Edge API
const categories = ['全部', '电影', '电视剧', '综艺', '动漫', '纪录片'];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>星光影库 · 资产与数据中枢管理后台 (实时大盘)</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 引入 Hls.js 便于后台直接播放测试 M3U8 视频源 -->
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest" defer></script>
    <!-- 引入 Chart.js 渲染访问量与转存量趋势图表 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js" defer></script>
  </head>
  <body class="bg-[#0b0f19] text-slate-100 min-h-screen antialiased selection:bg-orange-500 selection:text-white flex flex-col font-sans">
    
    <!-- 顶部全局导航栏 -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-[#0b0f19]/90 border-b border-slate-800 px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-orange-500 to-amber-400 flex items-center justify-center shadow-lg shadow-orange-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 text-white fill-current" viewBox="0 0 24 24">
              <path d="M4 6.47v11.06c0 .77.85 1.25 1.51.84l8.84-5.53c.63-.39.63-1.3 0-1.69L5.51 5.63C4.85 5.22 4 5.7 4 6.47z"/>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-base font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-slate-400">
                星光影库
              </span>
              <span class="text-xs px-2 py-0.5 rounded-full font-mono bg-purple-500/20 text-purple-300 border border-purple-500/30">
                Data Hub
              </span>
              <span id="globalLiveBadge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>实时查询模式</span>
              </span>
            </div>
            <p class="text-[11px] text-slate-400 hidden sm:block">采集资产全景监控 · 资源转存状态 · 门禁就绪大盘</p>
          </div>
        </a>
      </div>

      <div class="flex items-center gap-2 sm:gap-2.5">
        <!-- 名词定义说明按钮 -->
        <button id="openGlossaryBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-300 border border-indigo-500/40 transition-colors shadow-sm cursor-pointer">
          <span>💡 数据名词规范</span>
        </button>

        <button id="exportCsvBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors shadow-sm cursor-pointer">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="hidden sm:inline">导出 CSV</span>
        </button>

        <button id="exportJsonBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors shadow-sm cursor-pointer">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="hidden sm:inline">导出 JSON</span>
        </button>

        <a href="/" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-orange-500/20 hover:bg-orange-500/30 text-orange-300 border border-orange-500/40 transition-colors shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>前台首页</span>
        </a>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
      
      <!-- 顶部统计 KPI 指标卡片矩阵 (全动态实时计算) -->
      <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-3">
        <!-- 1. 全库总收录 -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-slate-700 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-400 font-medium">全库总收录</span>
            <span class="p-1.5 rounded-lg bg-blue-500/10 text-blue-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span id="kpiTotalCount" class="text-2xl font-bold tracking-tight text-white font-mono animate-pulse">...</span>
            <span class="text-[11px] text-slate-400">部</span>
          </div>
          <span class="text-[10px] text-slate-400 mt-1">豆瓣+TMDB双源汇聚</span>
        </div>

        <!-- 2. 已上线/元数据就绪 -->
        <div class="bg-slate-900/80 border border-emerald-900/40 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-emerald-800/60 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-emerald-400 font-medium">已上线 (门禁过审)</span>
            <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span id="kpiReadyMetaCount" class="text-2xl font-bold tracking-tight text-emerald-300 font-mono animate-pulse">...</span>
            <span id="kpiReadyMetaPct" class="text-[11px] text-emerald-500 font-mono">(--%)</span>
          </div>
          <span class="text-[10px] text-emerald-500/80 mt-1">前台可独立访问页面</span>
        </div>

        <!-- 3. 待补元数据种子池 -->
        <div class="bg-slate-900/80 border border-amber-900/40 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-amber-800/60 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-amber-400 font-medium">待补元数据种子</span>
            <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span id="kpiPendingMetaCount" class="text-2xl font-bold tracking-tight text-amber-300 font-mono animate-pulse">...</span>
            <span class="text-[11px] text-amber-500">部</span>
          </div>
          <span class="text-[10px] text-amber-500/80 mt-1">门禁隔离 · 待TMDB补齐</span>
        </div>

        <!-- 4. 在线播放源 -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-slate-700 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-rose-400 font-medium">在线播放切片</span>
            <span class="p-1.5 rounded-lg bg-rose-500/10 text-rose-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span id="kpiPlayCount" class="text-2xl font-bold tracking-tight text-rose-300 font-mono animate-pulse">...</span>
            <span class="text-[11px] text-slate-400">部</span>
          </div>
          <span class="text-[10px] text-rose-400/80 mt-1">免广告 M3U8 秒播流</span>
        </div>

        <!-- 5. UC 转存 -->
        <div class="bg-slate-900/80 border border-cyan-900/40 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-cyan-800/60 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-cyan-400 font-medium">UC网盘转存</span>
            <span class="p-1.5 rounded-lg bg-cyan-500/10 text-cyan-400 font-bold text-xs">
              UC
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span id="kpiUcCount" class="text-2xl font-bold tracking-tight text-cyan-300 font-mono animate-pulse">...</span>
            <span class="text-[11px] text-cyan-500">部</span>
          </div>
          <span class="text-[10px] text-cyan-400/80 mt-1">带个人 PID 推广返佣</span>
        </div>

        <!-- 6. 夸克转存 -->
        <div class="bg-slate-900/80 border border-purple-900/40 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-purple-800/60 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-purple-400 font-medium">夸克网盘转存</span>
            <span class="p-1.5 rounded-lg bg-purple-500/10 text-purple-400 font-bold text-xs">
              QK
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span id="kpiQuarkCount" class="text-2xl font-bold tracking-tight text-purple-300 font-mono animate-pulse">...</span>
            <span class="text-[11px] text-purple-500">部</span>
          </div>
          <span class="text-[10px] text-purple-400/80 mt-1">带个人 PID 专属收益</span>
        </div>

        <!-- 7. 连载追更中 -->
        <div class="bg-slate-900/80 border border-amber-900/30 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-amber-800/50 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-orange-400 font-medium">连载追更中</span>
            <span class="p-1.5 rounded-lg bg-orange-500/10 text-orange-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span id="kpiOngoingSeriesCount" class="text-2xl font-bold tracking-tight text-orange-300 font-mono animate-pulse">...</span>
            <span class="text-[11px] text-orange-500">部</span>
          </div>
          <span class="text-[10px] text-orange-400/80 mt-1">每日定时巡检更新集数</span>
        </div>
      </section>

      <!-- 自动化网盘转存控制中心 (Automated Netdisk Transfer Control Center) -->
      <section class="bg-gradient-to-r from-slate-900/90 via-slate-900/80 to-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800/80 pb-3.5">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-500/20 to-purple-500/20 border border-slate-700 flex items-center justify-center text-slate-300">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-white tracking-wide">自动化网盘转存控制中心</h3>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">
                  独立双网盘控制
                </span>
                <span id="transferSettingsSyncBadge" class="inline-flex items-center gap-1 text-[10px] text-slate-400 font-mono">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  实时同步就绪
                </span>
              </div>
              <p class="text-[11px] text-slate-400 mt-0.5">控制定时搜源、电视剧追更与批量入库流水线是否往个人网盘执行转存 · 支持 UC 与 夸克 分离独立热开关</p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-auto text-xs text-slate-400 font-mono" id="transferSettingsUpdatedTime">
            正在读取...
          </div>
        </div>

        <!-- 双控制开关卡片矩阵 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- 1. UC 网盘转存控制 -->
          <div class="bg-slate-950/60 border border-slate-800 hover:border-cyan-500/40 rounded-xl p-4 transition-all duration-300 flex items-center justify-between gap-4 group">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center font-bold text-cyan-400 text-sm shadow-lg shadow-cyan-500/10 group-hover:scale-105 transition-transform flex-shrink-0">
                UC
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <h4 class="text-sm font-semibold text-slate-100">UC 网盘自动转存</h4>
                  <span id="ucStatusBadge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium border bg-slate-800 text-slate-400 border-slate-700">
                    <span id="ucStatusDot" class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                    <span id="ucStatusLabel">检查中...</span>
                  </span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">
                  开启后，流水线将自动把高分电影与热播追更剧秒存至个人 UC 盘并绑定专属 PID 返佣链接；关闭时保留切片与元数据，跳过网盘转存。
                </p>
                <div class="text-[11px] text-cyan-400/80 font-mono">
                  个人空间: 7TB · 推广UID: 100753582621
                </div>
              </div>
            </div>

            <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 select-none">
              <input type="checkbox" id="ucToggleInput" class="sr-only peer" />
              <div class="w-16 h-8 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:bg-gradient-to-r peer-checked:from-cyan-500 peer-checked:to-blue-600 peer-checked:shadow-lg peer-checked:shadow-cyan-500/30 border-2 border-slate-700 peer-checked:border-cyan-400 transition-all duration-300"></div>
              <div class="absolute left-1 top-1 bg-white w-6 h-6 rounded-full transition-transform duration-300 transform peer-checked:translate-x-8 shadow-md pointer-events-none flex items-center justify-center">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 transition-colors"></span>
              </div>
            </label>
          </div>

          <!-- 2. 夸克网盘转存控制 -->
          <div class="bg-slate-950/60 border border-slate-800 hover:border-purple-500/40 rounded-xl p-4 transition-all duration-300 flex items-center justify-between gap-4 group">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center font-bold text-purple-400 text-sm shadow-lg shadow-purple-500/10 group-hover:scale-105 transition-transform flex-shrink-0">
                QK
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <h4 class="text-sm font-semibold text-slate-100">夸克网盘自动转存</h4>
                  <span id="quarkStatusBadge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium border bg-slate-800 text-slate-400 border-slate-700">
                    <span id="quarkStatusDot" class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                    <span id="quarkStatusLabel">检查中...</span>
                  </span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">
                  开启后，流水线将自动将院线大片与热门剧集秒存至 6TB 夸克个人盘并生成专属分佣链接；关闭时跳过夸克转存。
                </p>
                <div class="text-[11px] text-purple-400/80 font-mono">
                  个人空间: 6TB · 推广UID: 100061001997
                </div>
              </div>
            </div>

            <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 select-none">
              <input type="checkbox" id="quarkToggleInput" class="sr-only peer" />
              <div class="w-16 h-8 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:bg-gradient-to-r peer-checked:from-purple-500 peer-checked:to-indigo-600 peer-checked:shadow-lg peer-checked:shadow-purple-500/30 border-2 border-slate-700 peer-checked:border-purple-400 transition-all duration-300"></div>
              <div class="absolute left-1 top-1 bg-white w-6 h-6 rounded-full transition-transform duration-300 transform peer-checked:translate-x-8 shadow-md pointer-events-none flex items-center justify-center">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 transition-colors"></span>
              </div>
            </label>
          </div>
        </div>
      </section>

      <!-- 真实访问量与网盘转存转化率大盘 (Traffic & Conversion Rate Analytics) -->
      <section class="bg-gradient-to-b from-slate-900/90 to-slate-900/50 border border-slate-800 rounded-2xl p-5 space-y-5 shadow-xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800/80 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-orange-500/20 border border-orange-500/40 flex items-center justify-center text-orange-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-white tracking-wide">真实访问与网盘转存转化率全景监控</h3>
                <span id="liveStatusIndicator" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span id="liveStatusText">实时连接就绪</span>
                </span>
                <span id="lastUpdatedTime" class="text-[10px] text-slate-500 font-mono hidden sm:inline"></span>
              </div>
