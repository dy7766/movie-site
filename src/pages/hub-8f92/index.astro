                <div class="font-bold text-slate-100 group-hover:text-orange-400 transition-colors text-sm flex items-center gap-1.5">
                  <span>${m.title}</span>
                  ${m.is_released === false ? `<span class="px-1.5 py-0.2 rounded text-[9px] bg-purple-500/20 text-purple-300 border border-purple-500/30">待公映</span>` : ''}
                </div>
                <div class="text-[11px] text-slate-400 truncate max-w-xs">${m.original_title || m.actors || '暂无译名'}</div>
                <div class="text-[10px] text-slate-500 font-mono mt-0.5">${m.year || '-'} · ${m.country || '华语'} · 👁️ ${m.views || 0} · 💾 ${(m.clicks_quark || 0) + (m.clicks_uc || 0)}</div>
