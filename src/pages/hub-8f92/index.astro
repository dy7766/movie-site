          <!-- 嵌入式 HLS 播放器 -->
          <div id="playerSection" class="hidden bg-black/90 rounded-xl p-3 border border-rose-500/30 space-y-2">
            <div class="flex items-center justify-between text-xs pb-1 border-b border-slate-800">
              <span class="text-rose-400 font-bold flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                <span>HLS 切片流秒播测试 (前台画质直检)</span>
              </span>
              <button id="closePlayerBtn" class="text-slate-400 hover:text-white px-2 py-0.5 rounded hover:bg-slate-800 cursor-pointer">关闭播放</button>
            </div>
            <video id="hlsVideo" controls class="w-full aspect-video rounded-lg bg-black"></video>
            <div class="text-[10px] font-mono text-slate-500 truncate" id="currentStreamUrl"></div>
          </div>

          <!-- 剧照画廊 -->
          <div id="modalStillsSection" class="hidden space-y-2">
            <h4 class="text-xs font-semibold text-slate-400">剧照物料</h4>
            <div id="modalStillsGrid" class="flex gap-2 overflow-x-auto pb-2"></div>
          </div>

          <!-- 原始 JSON 查看折叠 -->
          <details class="text-xs bg-slate-950 rounded-xl p-3 border border-slate-800">
            <summary class="cursor-pointer text-slate-400 hover:text-slate-200 font-mono">展开查看原始完整数据 JSON</summary>
            <pre id="modalRawJson" class="mt-3 p-3 bg-slate-900 rounded-lg overflow-x-auto text-[11px] font-mono text-emerald-400/90 leading-tight max-h-60"></pre>
          </details>
        </div>

        <div class="px-6 py-3 bg-slate-950/80 border-t border-slate-800 flex items-center justify-between">
          <a id="modalFrontLink" href="#" target="_blank" class="text-xs text-orange-400 hover:underline flex items-center gap-1">
            <span>在前台打开该影视页面</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <button id="closeModalBottomBtn" class="px-4 py-1.5 text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg transition cursor-pointer">
            关闭
          </button>
        </div>
      </div>
    </div>

    <!-- 简易 Toast 提示组件 -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-10 opacity-0 pointer-events-none transition-all duration-300 flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900/95 border border-slate-700 text-slate-100 text-xs shadow-2xl backdrop-blur-md">
      <span id="toastIcon">✅</span>
      <span id="toastMsg">操作已执行</span>
    </div>

    <!-- 客户端核心逻辑：100% 实时查询与全属性多维检索 -->
    <script is:inline>
      const SUPABASE_BASE_URL = 'https://oncktqesgpjsilngtcok.supabase.co/rest/v1';
      const SUPABASE_PUB_KEY = 'sb_publishable_pQLb1OOxod2ibn_i1QqoJg_lt9FZPTH';

      // 实时全量数据存储 (在客户端内存中，毫秒级响应全部属性筛选)
      let rawMovies = [];
      
      let state = {
        movies: [],
        currentCategory: '全部',
        quickStatus: 'all',
        searchTerm: '',
        sortBy: 'year_score_created',
        pageSize: 50,
        currentPage: 1,
        viewMode: 'table', // 'table' or 'grid'
        // 全属性高级过滤器
        filters: {
          meta: 'all',
          released: 'all',
          finished: 'all',
          quark: 'all',
          uc: 'all',
          play: 'all',
          source: 'all',
          score: 'all',
          year: 'all'
        }
      };

      let hlsInstance = null;

      // DOM 元素引用
      const tableBody = document.getElementById('tableBody');
      const gridWrapper = document.getElementById('gridViewWrapper');
      const tableViewWrapper = document.getElementById('tableViewWrapper');
      const paginationInfo = document.getElementById('paginationInfo');
      const paginationButtons = document.getElementById('paginationButtons');
      const filterResultSummary = document.getElementById('filterResultSummary');
      const searchInput = document.getElementById('searchInput');
      const clearSearchBtn = document.getElementById('clearSearchBtn');
      const statusFilter = document.getElementById('statusFilter');
      const sortBySelect = document.getElementById('sortBy');
      const pageSizeSelect = document.getElementById('pageSizeSelect');
      const viewTableBtn = document.getElementById('viewTableBtn');
      const viewGridBtn = document.getElementById('viewGridBtn');
      const toggleAdvancedFilterBtn = document.getElementById('toggleAdvancedFilterBtn');
      const advancedFilterPanel = document.getElementById('advancedFilterPanel');
      const activeFilterBadge = document.getElementById('activeFilterBadge');

      // Toast 提醒函数
      function showToast(msg, icon = '✅') {
        const toast = document.getElementById('toast');
        document.getElementById('toastMsg').textContent = msg;
        document.getElementById('toastIcon').textContent = icon;
        toast.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
        setTimeout(() => {
          toast.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
        }, 2200);
      }

      function copyToClipboard(text, successMsg = '已复制到剪贴板') {
        navigator.clipboard.writeText(text).then(() => {
          showToast(successMsg, '📋');
        }).catch(() => {
          showToast('复制失败，请手动选取', '⚠️');
        });
      }

      // ==========================================
      // 1. 核心实时数据拉取引擎 (从不走静态缓存)
      // ==========================================
      async function fetchLiveResources() {
        const statusSummary = document.getElementById('filterResultSummary');
        if (statusSummary) {
          statusSummary.innerHTML = '<span class="text-orange-400 animate-pulse font-mono">正在实时拉取数据库全量影视资产...</span>';
        }

        try {
          let fetchedItems = null;

          // 优先尝试 Cloudflare Pages 边缘专用接口 /api/admin/resources
          try {
            const edgeRes = await fetch('/api/admin/resources?limit=4000', { cache: 'no-store' });
            if (edgeRes.ok) {
              const edgeData = await edgeRes.json();
              if (edgeData.success && Array.isArray(edgeData.resources)) {
                fetchedItems = edgeData.resources;
              }
            }
          } catch (_) {}

          // 降级兜底：直连 Supabase REST API (全球 CDN 毫秒级)
          if (!fetchedItems) {
            const selectCols = [
              'id', 'title', 'original_title', 'poster_url', 'category', 'tags',
              'year', 'score', 'actors', 'intro', 'drive_type', 'share_link',
              'views', 'saves', 'created_at', 'country', 'stills',
              'online_play_url', 'play_sources', 'share_link_uc', 'is_finished',
              'current_episode', 'total_episodes', 'has_metadata', 'status',
              'is_released', 'release_date', 'clicks_quark', 'clicks_uc', 'clicks_play',
              'source_pwd_id', 'uc_fid', 'last_episode_updated_at'
            ].join(',');

            const res = await fetch(`${SUPABASE_BASE_URL}/resources?select=${selectCols}&order=is_released.asc.nullslast,year.desc.nullslast,score.desc.nullslast,created_at.desc&limit=4000`, {
              headers: {
                'apikey': SUPABASE_PUB_KEY,
                'Authorization': `Bearer ${SUPABASE_PUB_KEY}`
              },
              cache: 'no-store'
            });

            if (!res.ok) throw new Error('Supabase 直连拉取失败');
            fetchedItems = await res.json();
          }

          rawMovies = fetchedItems || [];
          console.log(`[Data Hub] 实时拉取完成，共载入 ${rawMovies.length} 部影视数据`);

          // 实时重新计算大盘顶部 KPI 指标
          recalculateTopKpi();

          // 触发筛选与渲染
          filterAndSortMovies();
        } catch (err) {
          console.error('[Data Hub] 实时数据拉取异常:', err);
          if (statusSummary) {
            statusSummary.innerHTML = '<span class="text-rose-400 font-mono">⚠️ 实时数据拉取异常，请检查网络连接</span>';
          }
        }
      }

      // 实时计算顶部 7 大 KPI 指标与频道分布
      function recalculateTopKpi() {
        const total = rawMovies.length;
        const ready = rawMovies.filter(m => m.has_metadata === true).length;
        const pending = rawMovies.filter(m => !m.has_metadata).length;
        const uc = rawMovies.filter(m => !!m.share_link_uc).length;
        const qk = rawMovies.filter(m => !!m.share_link).length;
        const play = rawMovies.filter(m => !!m.online_play_url).length;
        const ongoing = rawMovies.filter(m => (m.category === '电视剧' || m.category === '综艺' || m.category === '动漫') && m.is_finished === false).length;

        const elTotal = document.getElementById('kpiTotalCount');
        const elReady = document.getElementById('kpiReadyMetaCount');
        const elReadyPct = document.getElementById('kpiReadyMetaPct');
        const elPending = document.getElementById('kpiPendingMetaCount');
        const elUc = document.getElementById('kpiUcCount');
        const elQk = document.getElementById('kpiQuarkCount');
        const elPlay = document.getElementById('kpiPlayCount');
        const elOngoing = document.getElementById('kpiOngoingSeriesCount');

        if (elTotal) { elTotal.textContent = total; elTotal.classList.remove('animate-pulse'); }
        if (elReady) { elReady.textContent = ready; elReady.classList.remove('animate-pulse'); }
        if (elReadyPct) elReadyPct.textContent = `(${Math.round(ready / (total || 1) * 100)}%)`;
        if (elPending) { elPending.textContent = pending; elPending.classList.remove('animate-pulse'); }
        if (elUc) { elUc.textContent = uc; elUc.classList.remove('animate-pulse'); }
        if (elQk) { elQk.textContent = qk; elQk.classList.remove('animate-pulse'); }
        if (elPlay) { elPlay.textContent = play; elPlay.classList.remove('animate-pulse'); }
        if (elOngoing) { elOngoing.textContent = ongoing; elOngoing.classList.remove('animate-pulse'); }

        // 计算频道分类
        const cats = ['全部', '电影', '电视剧', '综艺', '动漫', '纪录片'];
        cats.forEach(c => {
          const count = c === '全部' ? total : rawMovies.filter(m => m.category === c).length;
          const el = document.getElementById(`catCount_${c}`);
          if (el) el.textContent = `(${count})`;
        });
      }

      // ==========================================
      // 2. 全属性多维数据过滤与检索核心引擎
      // ==========================================
      function filterAndSortMovies() {
        let list = [...rawMovies];

        // 1. 频道分类过滤
        if (state.currentCategory !== '全部') {
          list = list.filter(m => m.category === state.currentCategory);
        }

        // 2. 快捷状态维度过滤
        if (state.quickStatus === 'ready') {
          list = list.filter(m => m.has_metadata === true);
        } else if (state.quickStatus === 'pending') {
          list = list.filter(m => !m.has_metadata);
        } else if (state.quickStatus === 'has_play') {
          list = list.filter(m => !!m.online_play_url);
        } else if (state.quickStatus === 'has_uc') {
          list = list.filter(m => !!m.share_link_uc);
        } else if (state.quickStatus === 'has_quark') {
          list = list.filter(m => !!m.share_link);
        } else if (state.quickStatus === 'ongoing') {
          list = list.filter(m => (m.category === '电视剧' || m.category === '综艺' || m.category === '动漫') && m.is_finished === false);
        } else if (state.quickStatus === 'finished') {
          list = list.filter(m => m.is_finished === true);
        } else if (state.quickStatus === 'missing_res') {
          list = list.filter(m => !m.share_link_uc && !m.share_link && !m.online_play_url);
        }

        // 3. 高级多维属性组合过滤
        const f = state.filters;
        
        // 门禁状态
        if (f.meta === 'ready') list = list.filter(m => m.has_metadata === true);
        else if (f.meta === 'pending') list = list.filter(m => !m.has_metadata);

        // 上映公映状态
        if (f.released === 'released') list = list.filter(m => m.is_released !== false);
        else if (f.released === 'unreleased') list = list.filter(m => m.is_released === false);

        // 连载完结状态
        if (f.finished === 'ongoing') list = list.filter(m => m.is_finished === false);
        else if (f.finished === 'finished') list = list.filter(m => m.is_finished === true);

        // 夸克网盘
        if (f.quark === 'has') list = list.filter(m => !!m.share_link);
        else if (f.quark === 'none') list = list.filter(m => !m.share_link);

        // UC 网盘
        if (f.uc === 'has') list = list.filter(m => !!m.share_link_uc);
        else if (f.uc === 'none') list = list.filter(m => !m.share_link_uc);

        // 在线播放源
        if (f.play === 'has') list = list.filter(m => !!m.online_play_url);
        else if (f.play === 'none') list = list.filter(m => !m.online_play_url);

        // 上游采集源
        if (f.source === 'has') list = list.filter(m => !!m.source_pwd_id);
        else if (f.source === 'none') list = list.filter(m => !m.source_pwd_id);

        // 口碑评分
        if (f.score === '9') list = list.filter(m => Number(m.score) >= 9.0);
        else if (f.score === '8') list = list.filter(m => Number(m.score) >= 8.0 && Number(m.score) < 9.0);
        else if (f.score === '7') list = list.filter(m => Number(m.score) >= 7.0 && Number(m.score) < 8.0);
        else if (f.score === '6') list = list.filter(m => Number(m.score) >= 6.0 && Number(m.score) < 7.0);
        else if (f.score === 'under6') list = list.filter(m => m.score && Number(m.score) < 6.0);
        else if (f.score === 'none') list = list.filter(m => !m.score || Number(m.score) === 0);

        // 4. 关键词全属性穿透模糊搜索 (匹配任何可能包含该关键词的属性)
        if (state.searchTerm) {
          const q = state.searchTerm.toLowerCase();
          list = list.filter(m => 
            (m.title && m.title.toLowerCase().includes(q)) ||
            (m.original_title && m.original_title.toLowerCase().includes(q)) ||
            (m.actors && m.actors.toLowerCase().includes(q)) ||
            (m.intro && m.intro.toLowerCase().includes(q)) ||
            (m.country && m.country.toLowerCase().includes(q)) ||
            (m.id && m.id.toLowerCase().includes(q)) ||
            (String(m.year).includes(q)) ||
            (m.share_link && m.share_link.toLowerCase().includes(q)) ||
            (m.share_link_uc && m.share_link_uc.toLowerCase().includes(q)) ||
            (m.source_pwd_id && m.source_pwd_id.toLowerCase().includes(q)) ||
            (m.uc_fid && m.uc_fid.toLowerCase().includes(q)) ||
            (m.online_play_url && m.online_play_url.toLowerCase().includes(q)) ||
            (Array.isArray(m.tags) && m.tags.some(t => String(t).toLowerCase().includes(q)))
          );
        }

        // 5. 排序引擎
        list.sort((a, b) => {
          if (state.sortBy === 'saves_desc') {
            const savesA = (a.clicks_quark || 0) + (a.clicks_uc || 0);
            const savesB = (b.clicks_quark || 0) + (b.clicks_uc || 0);
            return savesB - savesA;
          } else if (state.sortBy === 'views_desc') {
            return (b.views || 0) - (a.views || 0);
          } else if (state.sortBy === 'created_desc') {
            return new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime();
          } else if (state.sortBy === 'created_asc') {
            return new Date(a.created_at || 0).getTime() - new Date(b.created_at || 0).getTime();
          } else if (state.sortBy === 'updated_desc') {
            const upA = a.last_episode_updated_at ? new Date(a.last_episode_updated_at).getTime() : 0;
            const upB = b.last_episode_updated_at ? new Date(b.last_episode_updated_at).getTime() : 0;
            return upB - upA;
          } else if (state.sortBy === 'score_desc') {
            return (parseFloat(b.score) || 0) - (parseFloat(a.score) || 0);
          } else if (state.sortBy === 'year_desc') {
            return (b.year || 0) - (a.year || 0);
          } else if (state.sortBy === 'episodes_desc') {
            return (b.current_episode || 0) - (a.current_episode || 0);
          } else {
            // 默认：综合最新（未上映置后，按上映年份倒序、评分倒序、入库时间倒序）
            const relA = a.is_released === false ? 1 : 0;
            const relB = b.is_released === false ? 1 : 0;
            if (relA !== relB) return relA - relB;
            const yA = a.year || 0;
            const yB = b.year || 0;
            if (yA !== yB) return yB - yA;
            const sA = parseFloat(a.score) || 0;
            const sB = parseFloat(b.score) || 0;
            if (sA !== sB) return sB - sA;
            return new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime();
          }
        });

        state.movies = list;
        state.currentPage = 1;
        render();
        updateActiveFilterBadge();
      }

      function updateActiveFilterBadge() {
        let count = 0;
        const f = state.filters;
        Object.keys(f).forEach(k => {
          if (f[k] !== 'all') count++;
        });
        if (state.quickStatus !== 'all') count++;
        if (state.currentCategory !== '全部') count++;
        if (state.searchTerm) count++;

        if (activeFilterBadge) {
          if (count > 0) {
            activeFilterBadge.textContent = count;
            activeFilterBadge.classList.remove('hidden');
          } else {
            activeFilterBadge.classList.add('hidden');
          }
        }
      }

      // ==========================================
      // 3. 渲染视图与分页
      // ==========================================
      function render() {
        const total = state.movies.length;
        const totalPages = Math.ceil(total / state.pageSize) || 1;
        
        if (state.currentPage > totalPages) state.currentPage = totalPages;
        if (state.currentPage < 1) state.currentPage = 1;

        const startIdx = (state.currentPage - 1) * state.pageSize;
        const endIdx = Math.min(startIdx + state.pageSize, total);
        const pagedList = state.movies.slice(startIdx, endIdx);

        // 渲染顶部结果摘要
        filterResultSummary.innerHTML = `
          已检索到 <strong class="text-orange-400 font-bold font-mono">${total}</strong> 部影视
          <span class="text-slate-500 ml-1">(${rawMovies.length} 全库实时)</span>
          ${state.searchTerm ? `<span class="ml-2 px-2 py-0.5 rounded bg-slate-800 text-[11px] text-slate-300">关键词: "${state.searchTerm}"</span>` : ''}
        `;

        if (state.viewMode === 'table') {
          tableViewWrapper.classList.remove('hidden');
          gridWrapper.classList.add('hidden');
          renderTable(pagedList);
        } else {
          tableViewWrapper.classList.add('hidden');
          gridWrapper.classList.remove('hidden');
          renderGrid(pagedList);
        }

        paginationInfo.textContent = total > 0 
          ? `显示第 ${startIdx + 1} 到 ${endIdx} 条，共 ${total} 条` 
          : '暂无匹配的影视数据';

        renderPagination(totalPages);
      }

      function renderTable(list) {
        if (list.length === 0) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="9" class="text-center py-12 text-slate-500">
                <p>没有找到符合条件的影视记录</p>
                <p class="text-[11px] text-slate-600 mt-1">请尝试放宽检索关键词或点击“重置所有筛选”</p>
              </td>
            </tr>
          `;
          return;
        }

        let html = '';
        for (const m of list) {
          const score = m.score ? parseFloat(m.score).toFixed(1) : '-';
          const hasMeta = m.has_metadata === true;
          const isTv = m.category === '电视剧' || m.category === '综艺' || m.category === '动漫';

          const ucBadge = m.share_link_uc 
            ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30" title="已转存至个人 UC 网盘">UC</span>`
            : `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono text-slate-600 bg-slate-900 border border-slate-800/80">UC-</span>`;

          const quarkBadge = m.share_link 
            ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30" title="已转存至个人夸克网盘">QK</span>`
            : `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono text-slate-600 bg-slate-900 border border-slate-800/80">QK-</span>`;

          const playBadge = m.online_play_url 
            ? `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30" title="有免流 M3U8 在线点播切片">播</span>`
            : `<span class="px-1.5 py-0.5 rounded text-[10px] font-mono text-slate-600 bg-slate-900 border border-slate-800/80">播-</span>`;

          let seriesStatus = '-';
          if (isTv) {
            if (m.is_finished) {
              seriesStatus = `<span class="text-emerald-400 font-mono">完结 (${m.total_episodes || m.current_episode}集)</span>`;
            } else {
              seriesStatus = `<span class="text-orange-400 font-mono font-bold">连载 ${m.current_episode || 1}/${m.total_episodes || '?'}集</span>`;
