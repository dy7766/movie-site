    </div>

    <!-- 浮动提示 Toast -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-10 opacity-0 pointer-events-none transition-all duration-300 px-4 py-2.5 rounded-xl bg-slate-800/95 border border-slate-700 text-slate-100 text-xs shadow-xl flex items-center gap-2">
      <span id="toastIcon">📋</span>
      <span id="toastMsg">已复制到剪贴板</span>
    </div>

    <!-- 原始全量数据安全存放在客户端供即时秒级检索 -->
    <script id="allMoviesData" type="application/json" set:html={serializedMovies}></script>

    <script is:inline>
      // 客户端管理面板核心逻辑
      const rawMovies = JSON.parse(document.getElementById('allMoviesData').textContent);
      
      let state = {
        movies: [...rawMovies],
        currentCategory: '全部',
        currentStatus: 'all',
        searchTerm: '',
        sortBy: 'year_score_created',
        pageSize: 50,
        currentPage: 1,
        viewMode: 'table', // 'table' or 'grid'
      };

      let hlsInstance = null;

      // DOM 元素引用
      const tableBody = document.getElementById('tableBody');
      const gridWrapper = document.getElementById('gridViewWrapper');
      const tableViewWrapper = document.getElementById('tableViewWrapper');
      const paginationInfo = document.getElementById('paginationInfo');
      const paginationButtons = document.getElementById('paginationButtons');
      const filterResultSummary = document.getElementById('filterResultSummary');
      const searchInput = document.getElementById('searchInput');
      const clearSearchBtn = document.getElementById('clearSearchBtn');
      const statusFilter = document.getElementById('statusFilter');
      const sortBySelect = document.getElementById('sortBy');
      const pageSizeSelect = document.getElementById('pageSizeSelect');
      const viewTableBtn = document.getElementById('viewTableBtn');
      const viewGridBtn = document.getElementById('viewGridBtn');

      // Toast 提醒函数
      function showToast(msg, icon = '✅') {
        const toast = document.getElementById('toast');
        document.getElementById('toastMsg').textContent = msg;
        document.getElementById('toastIcon').textContent = icon;
        toast.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
        setTimeout(() => {
          toast.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
        }, 2200);
      }

      // 复制工具函数
      function copyToClipboard(text, successMsg = '已复制到剪贴板') {
        navigator.clipboard.writeText(text).then(() => {
          showToast(successMsg, '📋');
        }).catch(() => {
          showToast('复制失败，请手动选取', '⚠️');
        });
      }

      // 数据筛选与排序核心函数
      function filterAndSortMovies() {
        let list = [...rawMovies];

        // 1. 频道分类过滤
        if (state.currentCategory !== '全部') {
          list = list.filter(m => m.category === state.currentCategory);
        }

        // 2. 状态维度过滤
        if (state.currentStatus === 'ready') {
          list = list.filter(m => m.has_metadata === true);
        } else if (state.currentStatus === 'pending') {
          list = list.filter(m => !m.has_metadata);
        } else if (state.currentStatus === 'has_play') {
          list = list.filter(m => !!m.online_play_url);
        } else if (state.currentStatus === 'has_uc') {
          list = list.filter(m => !!m.share_link_uc);
        } else if (state.currentStatus === 'has_quark') {
          list = list.filter(m => !!m.share_link);
        } else if (state.currentStatus === 'ongoing') {
          list = list.filter(m => (m.category === '电视剧' || m.category === '综艺') && m.is_finished === false);
        } else if (state.currentStatus === 'missing_res') {
          list = list.filter(m => !m.share_link_uc && !m.share_link && !m.online_play_url);
        }

        // 3. 搜索关键词模糊匹配
        if (state.searchTerm) {
          const q = state.searchTerm.toLowerCase();
          list = list.filter(m => 
            (m.title && m.title.toLowerCase().includes(q)) ||
            (m.original_title && m.original_title.toLowerCase().includes(q)) ||
            (m.actors && m.actors.toLowerCase().includes(q)) ||
            (m.country && m.country.toLowerCase().includes(q)) ||
            (m.id && m.id.toLowerCase().includes(q)) ||
            (String(m.year).includes(q))
          );
        }

        // 4. 排序
        if (state.sortBy === 'year_score_created') {
          list.sort((a, b) => {
            const yDiff = (b.year || 0) - (a.year || 0);
            if (yDiff !== 0) return yDiff;
            const sDiff = (parseFloat(b.score) || 0) - (parseFloat(a.score) || 0);
            if (sDiff !== 0) return sDiff;
            return new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime();
          });
        } else if (state.sortBy === 'created_desc') {
          list.sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());
        } else if (state.sortBy === 'score_desc') {
          list.sort((a, b) => (parseFloat(b.score) || 0) - (parseFloat(a.score) || 0));
        } else if (state.sortBy === 'year_desc') {
          list.sort((a, b) => (b.year || 0) - (a.year || 0));
        } else if (state.sortBy === 'saves_desc') {
          list.sort((a, b) => ((b.clicks_quark || 0) + (b.clicks_uc || 0)) - ((a.clicks_quark || 0) + (a.clicks_uc || 0)));
        } else if (state.sortBy === 'views_desc') {
          list.sort((a, b) => (b.views || 0) - (a.views || 0));
        }

        state.movies = list;
        state.currentPage = 1;
        render();
      }

      // 主渲染函数
      function render() {
        const total = state.movies.length;
        const totalPages = Math.ceil(total / state.pageSize) || 1;
        if (state.currentPage > totalPages) state.currentPage = totalPages;

        const startIndex = (state.currentPage - 1) * state.pageSize;
        const endIndex = Math.min(startIndex + state.pageSize, total);
        const currentSlice = state.movies.slice(startIndex, endIndex);

        // 更新统计文本
        filterResultSummary.innerHTML = `展示筛选结果 <span class="text-orange-400 font-bold font-mono">${total}</span> 部 (第 ${state.currentPage}/${totalPages} 页)`;
        paginationInfo.textContent = total > 0 
          ? `显示第 ${startIndex + 1} 到 ${endIndex} 条，共 ${total} 条`
          : '暂无匹配的影视资产';

        // 渲染表格或网格
        if (state.viewMode === 'table') {
          tableViewWrapper.classList.remove('hidden');
          gridWrapper.classList.add('hidden');
          renderTable(currentSlice);
        } else {
          tableViewWrapper.classList.add('hidden');
          gridWrapper.classList.remove('hidden');
          renderGrid(currentSlice);
        }

        // 渲染分页按钮
        renderPagination(totalPages);
      }

      // 渲染表格视图
      function renderTable(list) {
        if (list.length === 0) {
          tableBody.innerHTML = `<tr><td colspan="9" class="text-center py-12 text-slate-500">没有找到符合条件的影视记录</td></tr>`;
          return;
        }

        let html = '';
        for (const m of list) {
          const dateStr = m.created_at ? new Date(m.created_at).toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '-';
          const hasMeta = m.has_metadata === true;
          const score = m.score ? parseFloat(m.score).toFixed(1) : '-';
          
          // 资源状态胶囊
          const ucBadge = m.share_link_uc 
            ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-cyan-500/20 text-cyan-300 border border-cyan-500/30" title="已转存个人 UC 盘">UC</span>` 
            : `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-slate-800 text-slate-500">无UC</span>`;
          
          const quarkBadge = m.share_link 
            ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-purple-500/20 text-purple-300 border border-purple-500/30" title="已转存夸克盘">夸克</span>` 
            : `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-slate-800 text-slate-500">无夸克</span>`;
          
          const playBadge = m.online_play_url 
            ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-rose-500/20 text-rose-300 border border-rose-500/30" title="已切片在线播">在线播</span>` 
            : `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] bg-slate-800 text-slate-500">无切片</span>`;

          // 连载进度
          let seriesStatus = '-';
          if (m.category === '电视剧' || m.category === '综艺') {
            if (m.is_finished) {
              seriesStatus = `<span class="text-slate-400">已完结 (${m.total_episodes || m.current_episode || '-'}集)</span>`;
            } else {
              seriesStatus = `<span class="text-orange-400 font-medium">连载至 ${m.current_episode || 1} 集</span>`;
            }
          }

          html += `
            <tr class="hover:bg-slate-800/40 transition-colors group cursor-pointer" onclick="openDetailModal('${m.id}')">
              <td class="py-2.5 px-3 text-center">
                <img src="${m.poster_url || '/favicon.svg'}" alt="${m.title}" loading="lazy" class="w-9 h-13 object-cover rounded bg-slate-800 border border-slate-700/60 mx-auto group-hover:scale-105 transition-transform" />
              </td>
              <td class="py-2.5 px-4">
                <div class="font-bold text-slate-100 group-hover:text-orange-400 transition-colors text-sm">${m.title}</div>
                <div class="text-[11px] text-slate-400 truncate max-w-xs">${m.original_title || m.actors || '暂无译名'}</div>
                <div class="text-[10px] text-slate-500 font-mono mt-0.5">${m.year || '-'} · ${m.country || '华语'} · 👁️ ${m.views || 0} · 💾 ${(m.clicks_quark || 0) + (m.clicks_uc || 0)}</div>
              </td>
              <td class="py-2.5 px-3 text-center">
                <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800 text-slate-300 border border-slate-700">
                  ${m.category || '电影'}
                </span>
              </td>
              <td class="py-2.5 px-3 text-center">
                <span class="font-bold text-amber-400 font-mono text-sm">${score}</span>
              </td>
              <td class="py-2.5 px-3 text-center">
                ${hasMeta 
                  ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                       <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                       <span>已过审就绪</span>
                     </span>`
                  : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30">
                       <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                       <span>待补元数据</span>
                     </span>`
                }
              </td>
              <td class="py-2.5 px-3 text-center">
                <div class="flex items-center justify-center gap-1">
                  ${ucBadge}
                  ${quarkBadge}
                  ${playBadge}
                </div>
              </td>
              <td class="py-2.5 px-3 text-center text-[11px]">
                ${seriesStatus}
              </td>
              <td class="py-2.5 px-3 text-center text-slate-400 text-[11px] font-mono">
                ${dateStr}
              </td>
              <td class="py-2.5 px-4 text-center" onclick="event.stopPropagation()">
                <div class="flex items-center justify-center gap-1.5">
                  ${hasMeta 
                    ? `<a href="/movie/${m.id}" target="_blank" class="px-2 py-1 bg-orange-500/20 hover:bg-orange-500/30 text-orange-300 rounded text-[11px] border border-orange-500/40 transition">
                         直达 ↗
                       </a>`
                    : `<span class="px-2 py-1 bg-slate-800 text-slate-500 rounded text-[11px] cursor-not-allowed" title="门禁拦截中：尚未通过 TMDB 补齐元数据">
                         门禁拦截
                       </span>`
                  }
                  <button onclick="openDetailModal('${m.id}')" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-[11px] border border-slate-700 transition">
                    详情
                  </button>
                </div>
              </td>
            </tr>
          `;
        }
        tableBody.innerHTML = html;
      }

      // 渲染网格卡片视图
      function renderGrid(list) {
        if (list.length === 0) {
          gridWrapper.innerHTML = `<div class="col-span-full text-center py-12 text-slate-500">没有找到符合条件的影视记录</div>`;
          return;
        }

        let html = '';
        for (const m of list) {
          const score = m.score ? parseFloat(m.score).toFixed(1) : '-';
          const hasMeta = m.has_metadata === true;

          html += `
            <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden hover:border-slate-700 transition shadow flex flex-col group cursor-pointer" onclick="openDetailModal('${m.id}')">
              <div class="relative aspect-[2/3] bg-slate-950 overflow-hidden">
                <img src="${m.poster_url || '/favicon.svg'}" alt="${m.title}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                <div class="absolute top-2 left-2 flex flex-col gap-1">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-black/60 backdrop-blur-md text-amber-300 border border-amber-500/30">
                    ★ ${score}
                  </span>
                </div>
                <div class="absolute top-2 right-2">
                  ${hasMeta 
                    ? `<span class="w-2 h-2 rounded-full bg-emerald-400 block shadow" title="已发布"></span>`
                    : `<span class="w-2 h-2 rounded-full bg-amber-400 block animate-pulse" title="待补元数据"></span>`
                  }
                </div>
                <div class="absolute bottom-2 left-2 right-2 flex items-center gap-1 justify-end">
                  ${m.share_link_uc ? `<span class="px-1 bg-cyan-600/80 text-white text-[9px] rounded font-bold">UC</span>` : ''}
                  ${m.share_link ? `<span class="px-1 bg-purple-600/80 text-white text-[9px] rounded font-bold">QK</span>` : ''}
                  ${m.online_play_url ? `<span class="px-1 bg-rose-600/80 text-white text-[9px] rounded font-bold">播</span>` : ''}
                </div>
              </div>
              <div class="p-2.5 flex-1 flex flex-col justify-between space-y-1">
                <div class="font-bold text-xs text-slate-100 truncate group-hover:text-orange-400 transition-colors">
                  ${m.title}
                </div>
                <div class="flex items-center justify-between text-[10px] text-slate-400">
                  <span>${m.category}</span>
                  <span class="font-mono">${m.year || '-'}</span>
                </div>
              </div>
            </div>
          `;
        }
        gridWrapper.innerHTML = html;
      }

      // 渲染分页器
      function renderPagination(totalPages) {
        if (totalPages <= 1) {
          paginationButtons.innerHTML = '';
          return;
        }

        let btns = '';
        // 上一页
        btns += `
          <button 
            onclick="goToPage(${state.currentPage - 1})" 
            ${state.currentPage === 1 ? 'disabled class="opacity-40 cursor-not-allowed"' : 'class="hover:bg-slate-800 text-slate-300"'}
            class="px-2.5 py-1 text-xs rounded-lg bg-slate-900 border border-slate-800 transition"
          >
            上一页
          </button>
        `;

        // 简易页码逻辑
        for (let i = 1; i <= totalPages; i++) {
          if (i === 1 || i === totalPages || (i >= state.currentPage - 2 && i <= state.currentPage + 2)) {
            const isActive = i === state.currentPage;
            btns += `
              <button 
                onclick="goToPage(${i})" 
                class="px-2.5 py-1 text-xs rounded-lg transition font-mono ${
                  isActive 
                    ? 'bg-orange-500 text-white font-bold' 
                    : 'bg-slate-900 text-slate-300 border border-slate-800 hover:bg-slate-800'
                }"
              >
                ${i}
              </button>
            `;
          } else if (i === state.currentPage - 3 || i === state.currentPage + 3) {
            btns += `<span class="text-xs text-slate-600 px-1">...</span>`;
          }
        }

        // 下一页
        btns += `
          <button 
            onclick="goToPage(${state.currentPage + 1})" 
            ${state.currentPage === totalPages ? 'disabled class="opacity-40 cursor-not-allowed"' : 'class="hover:bg-slate-800 text-slate-300"'}
            class="px-2.5 py-1 text-xs rounded-lg bg-slate-900 border border-slate-800 transition"
          >
            下一页
          </button>
        `;

        paginationButtons.innerHTML = btns;
      }

      window.goToPage = function(page) {
        state.currentPage = page;
        render();
        window.scrollTo({ top: 380, behavior: 'smooth' });
      };

      // 详情弹窗控制
      window.openDetailModal = function(id) {
        const m = rawMovies.find(x => x.id === id);
        if (!m) return;

        document.getElementById('modalTitle').textContent = m.title;
        document.getElementById('modalCategory').textContent = m.category || '电影';
        document.getElementById('modalYear').textContent = m.year ? `${m.year} 年` : '';
        document.getElementById('modalPoster').src = m.poster_url || '/favicon.svg';
        document.getElementById('modalId').textContent = m.id;
        document.getElementById('modalOriginalTitle').textContent = m.original_title || '与中文名同名';
        document.getElementById('modalScore').textContent = m.score ? `★ ${parseFloat(m.score).toFixed(1)} 分` : '暂无评分';
        document.getElementById('modalActors').textContent = m.actors || '暂未录入演员列表';
        document.getElementById('modalIntro').textContent = m.intro || '暂无详细剧情介绍';
        document.getElementById('modalCreatedAt').textContent = `入库时间: ${m.created_at ? new Date(m.created_at).toLocaleString('zh-CN') : '-'}`;

        // 门禁状态
        const metaBadge = document.getElementById('modalMetaBadge');
        if (m.has_metadata) {
          metaBadge.innerHTML = `<span class="px-2 py-0.5 rounded text-[11px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">✅ TMDB官方元数据已就绪 · 已解锁前台发布</span>`;
        } else {
          metaBadge.innerHTML = `<span class="px-2 py-0.5 rounded text-[11px] bg-amber-500/20 text-amber-300 border border-amber-500/30">⏳ 豆瓣热门种子 · 待 TMDB 补齐 (门禁隔离中)</span>`;
        }

        // UC 网盘
        const ucLink = document.getElementById('modalUcLink');
        const ucStatus = document.getElementById('modalUcStatus');
        const ucCopy = document.getElementById('modalUcCopy');
        if (m.share_link_uc) {
          ucStatus.textContent = '已转存';
          ucStatus.className = 'text-[10px] text-cyan-400';
          ucLink.href = m.share_link_uc;
          ucLink.classList.remove('opacity-40', 'pointer-events-none');
          ucCopy.onclick = () => copyToClipboard(m.share_link_uc, '已复制 UC 网盘转存链接');
        } else {
          ucStatus.textContent = '未搜得';
          ucStatus.className = 'text-[10px] text-slate-500';
          ucLink.href = '#';
          ucLink.classList.add('opacity-40', 'pointer-events-none');
          ucCopy.onclick = () => showToast('暂无 UC 链接', '⚠️');
        }

        // 夸克网盘
        const quarkLink = document.getElementById('modalQuarkLink');
        const quarkStatus = document.getElementById('modalQuarkStatus');
        const quarkCopy = document.getElementById('modalQuarkCopy');
        if (m.share_link) {
          quarkStatus.textContent = '已挂载';
          quarkStatus.className = 'text-[10px] text-purple-400';
          quarkLink.href = m.share_link;
          quarkLink.classList.remove('opacity-40', 'pointer-events-none');
          quarkCopy.onclick = () => copyToClipboard(m.share_link, '已复制夸克转存链接');
        } else {
          quarkStatus.textContent = '未挂载';
          quarkStatus.className = 'text-[10px] text-slate-500';
          quarkLink.href = '#';
          quarkLink.classList.add('opacity-40', 'pointer-events-none');
          quarkCopy.onclick = () => showToast('暂无夸克链接', '⚠️');
        }

        // 在线播放源
        const playStatus = document.getElementById('modalPlayStatus');
        const playTestBtn = document.getElementById('modalPlayTestBtn');
        const playCopy = document.getElementById('modalPlayCopy');
        if (m.online_play_url) {
          playStatus.textContent = '可秒播';
          playStatus.className = 'text-[10px] text-rose-400';
          playTestBtn.classList.remove('opacity-40', 'pointer-events-none');
          playTestBtn.onclick = () => playHlsStream(m.online_play_url);
          playCopy.onclick = () => copyToClipboard(m.online_play_url, '已复制 M3U8 流媒体地址');
        } else {
          playStatus.textContent = '无源';
          playStatus.className = 'text-[10px] text-slate-500';
          playTestBtn.classList.add('opacity-40', 'pointer-events-none');
          playCopy.onclick = () => showToast('暂无在线切片流', '⚠️');
        }

        // 前台直达链接
        const frontLink = document.getElementById('modalFrontLink');
        if (m.has_metadata) {
          frontLink.href = `/movie/${m.id}`;
          frontLink.classList.remove('hidden');
        } else {
          frontLink.classList.add('hidden');
        }

        // 剧照画廊
        const stillsSection = document.getElementById('modalStillsSection');
        const stillsGrid = document.getElementById('modalStillsGrid');
        if (m.stills && Array.isArray(m.stills) && m.stills.length > 0) {
          stillsSection.classList.remove('hidden');
          stillsGrid.innerHTML = m.stills.map(s => `
            <img src="${s}" alt="剧照" class="h-16 w-28 object-cover rounded border border-slate-700 flex-shrink-0" />
          `).join('');
        } else {
          stillsSection.classList.add('hidden');
        }

        // 原始 JSON
        document.getElementById('modalRawJson').textContent = JSON.stringify(m, null, 2);

        // 展开弹窗
        document.getElementById('detailModal').classList.remove('hidden');
      };

      // 播放 HLS 视频流
      function playHlsStream(url) {
        const playerSection = document.getElementById('playerSection');
        const video = document.getElementById('hlsVideo');
        const streamUrlText = document.getElementById('currentStreamUrl');
        
        playerSection.classList.remove('hidden');
        streamUrlText.textContent = url;

        if (hlsInstance) {
          hlsInstance.destroy();
          hlsInstance = null;
        }

        if (window.Hls && window.Hls.isSupported()) {
          hlsInstance = new window.Hls();
          hlsInstance.loadSource(url);
          hlsInstance.attachMedia(video);
          hlsInstance.on(window.Hls.Events.MANIFEST_PARSED, () => {
            video.play();
          });
          hlsInstance.on(window.Hls.Events.ERROR, (event, data) => {
            if (data.fatal) {
              showToast('M3U8 解析失败或跨域受阻', '⚠️');
            }
          });
        } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = url;
          video.play();
        } else {
          showToast('当前浏览器不支持 HLS 原生播放', '⚠️');
        }
      }

      // 关闭播放器
      document.getElementById('closePlayerBtn').addEventListener('click', () => {
        const video = document.getElementById('hlsVideo');
        video.pause();
        if (hlsInstance) {
          hlsInstance.destroy();
          hlsInstance = null;
        }
        document.getElementById('playerSection').classList.add('hidden');
      });

      // 关闭弹窗
      document.getElementById('closeModalBtn').addEventListener('click', () => {
        document.getElementById('closePlayerBtn').click();
        document.getElementById('detailModal').classList.add('hidden');
      });

      document.getElementById('detailModal').addEventListener('click', (e) => {
        if (e.target.id === 'detailModal') {
          document.getElementById('closeModalBtn').click();
        }
      });

      // 绑定分类筛选按钮
      document.querySelectorAll('[data-cat-btn]').forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat-btn');
          state.currentCategory = cat;

          // 更新按钮样式
          document.querySelectorAll('[data-cat-btn]').forEach(b => {
            b.className = 'cat-filter-btn px-3 py-1 rounded-lg text-xs font-medium transition-all duration-200 border bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-800 hover:text-white';
          });
          btn.className = 'cat-filter-btn px-3 py-1 rounded-lg text-xs font-medium transition-all duration-200 border bg-orange-500/20 text-orange-300 border-orange-500/40 shadow-sm';

          filterAndSortMovies();
        });
      });

      // 搜索框输入事件（防抖）
      let searchTimer = null;
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.trim();
        state.searchTerm = val;
        clearSearchBtn.classList.toggle('hidden', !val);

        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          filterAndSortMovies();
        }, 150);
      });

      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        state.searchTerm = '';
        clearSearchBtn.classList.add('hidden');
        filterAndSortMovies();
      });

      // 状态筛选下拉
      statusFilter.addEventListener('change', (e) => {
        state.currentStatus = e.target.value;
        filterAndSortMovies();
      });

      // 排序下拉
      sortBySelect.addEventListener('change', (e) => {
        state.sortBy = e.target.value;
        filterAndSortMovies();
      });

      // 每页条数下拉
      pageSizeSelect.addEventListener('change', (e) => {
        state.pageSize = parseInt(e.target.value, 10);
        state.currentPage = 1;
        render();
      });

      // 视图切换
      viewTableBtn.addEventListener('click', () => {
        state.viewMode = 'table';
        viewTableBtn.className = 'px-2 py-1 rounded text-xs transition bg-orange-500 text-white';
        viewGridBtn.className = 'px-2 py-1 rounded text-xs transition text-slate-400 hover:text-white';
        render();
      });

      viewGridBtn.addEventListener('click', () => {
        state.viewMode = 'grid';
        viewGridBtn.className = 'px-2 py-1 rounded text-xs transition bg-orange-500 text-white';
        viewTableBtn.className = 'px-2 py-1 rounded text-xs transition text-slate-400 hover:text-white';
        render();
      });

      // 导出 CSV 功能
      document.getElementById('exportCsvBtn').addEventListener('click', () => {
        const items = state.movies;
        if (items.length === 0) {
          showToast('当前无可用数据导出', '⚠️');
          return;
        }

        const headers = ['ID', '片名', '原始片名', '分类', '年份', '评分', '国家', '元数据就绪', 'UC网盘链接', '夸克网盘链接', '在线播放M3U8', '连载集数', '完结状态', '入库时间'];
        const rows = items.map(m => [
          m.id,
          `"${(m.title || '').replace(/"/g, '""')}"`,
          `"${(m.original_title || '').replace(/"/g, '""')}"`,
          m.category || '',
          m.year || '',
          m.score || '',
          m.country || '',
          m.has_metadata ? '是' : '否',
          `"${(m.share_link_uc || '').replace(/"/g, '""')}"`,
          `"${(m.share_link || '').replace(/"/g, '""')}"`,
          `"${(m.online_play_url || '').replace(/"/g, '""')}"`,
          m.current_episode || '',
          m.is_finished ? '已完结' : '连载中',
          m.created_at || ''
        ]);

        const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `starlight_movies_${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
        showToast(`已导出 ${items.length} 部影视数据为 CSV`, '📥');
      });

      // 导出 JSON 功能
      document.getElementById('exportJsonBtn').addEventListener('click', () => {
        const items = state.movies;
        const blob = new Blob([JSON.stringify(items, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `starlight_movies_${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast(`已导出 ${items.length} 部影视数据为 JSON`, '📄');
      });

      // ==========================================
      // 真实访问与网盘转存大盘：客户端秒级实时拉取逻辑
      // ==========================================
      const SUPABASE_BASE_URL = 'https://oncktqesgpjsilngtcok.supabase.co/rest/v1';
      const SUPABASE_PUB_KEY = 'sb_publishable_pQLb1OOxod2ibn_i1QqoJg_lt9FZPTH';

      async function getSupabaseCount(queryPath) {
        try {
          const res = await fetch(`${SUPABASE_BASE_URL}/${queryPath}`, {
            headers: {
              'apikey': SUPABASE_PUB_KEY,
              'Authorization': `Bearer ${SUPABASE_PUB_KEY}`,
              'Prefer': 'count=exact',
              'Range-Unit': 'items',
              'Range': '0-0'
            }
          });
          const cr = res.headers.get('content-range');
          if (!cr) return 0;
          const parts = cr.split('/');
          return parts[1] ? parseInt(parts[1], 10) : 0;
        } catch (_) {
          return 0;
        }
      }

      async function refreshLiveAnalytics(manual = false) {
        const spinner = document.getElementById('refreshSpinner');
        const statusText = document.getElementById('liveStatusText');
        const lastUpdated = document.getElementById('lastUpdatedTime');
        if (spinner) spinner.classList.add('animate-spin');
        if (statusText) statusText.textContent = manual ? '正在同步最新指标...' : '实时连接中...';

        try {
          // 并发拉取实时 6 维计数器、最近事件流水与 TOP 10 转化最高影视
          const [pv, mobilePv, desktopPv, quark, uc, play, recentRes, topMoviesRes] = await Promise.all([
            getSupabaseCount('analytics_events?event_type=eq.page_view&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.page_view&device=eq.mobile&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.page_view&device=eq.desktop&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.click_quark&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.click_uc&select=id'),
            getSupabaseCount('analytics_events?event_type=eq.click_play&select=id'),
            fetch(`${SUPABASE_BASE_URL}/analytics_events?order=created_at.desc&limit=15`, {
              headers: { 'apikey': SUPABASE_PUB_KEY, 'Authorization': `Bearer ${SUPABASE_PUB_KEY}` }
            }).then(r => r.json()).catch(() => []),
            fetch(`${SUPABASE_BASE_URL}/resources?has_metadata=eq.true&or=(views.gt.0,clicks_quark.gt.0,clicks_uc.gt.0,clicks_play.gt.0)&order=clicks_quark.desc,clicks_uc.desc,views.desc&limit=15`, {
              headers: { 'apikey': SUPABASE_PUB_KEY, 'Authorization': `Bearer ${SUPABASE_PUB_KEY}` }
            }).then(r => r.json()).catch(() => [])
          ]);

          const saves = quark + uc;
          const cvr = pv > 0 ? ((saves / pv) * 100).toFixed(2) : '0.00';
          const playRate = pv > 0 ? ((play / pv) * 100).toFixed(2) : '0.00';

          // 更新 4 核心指标卡 DOM
          const elPv = document.getElementById('metricTotalPv');
          const elMobile = document.getElementById('metricMobilePv');
          const elDesktop = document.getElementById('metricDesktopPv');
          const elSaves = document.getElementById('metricTotalSaves');
          const elQuark = document.getElementById('metricQuarkSaves');
          const elUc = document.getElementById('metricUcSaves');
          const elCvr = document.getElementById('metricSaveRate');
          const elCvrBar = document.getElementById('metricSaveRateBar');
          const elPlays = document.getElementById('metricTotalPlays');
          const elPlayRate = document.getElementById('metricPlayRate');

          if (elPv) elPv.textContent = pv.toLocaleString();
          if (elMobile) elMobile.textContent = `📱 移动端 ${mobilePv}`;
          if (elDesktop) elDesktop.textContent = `💻 电脑端 ${desktopPv}`;
          if (elSaves) elSaves.textContent = saves.toLocaleString();
          if (elQuark) elQuark.textContent = `夸克: ${quark}`;
          if (elUc) elUc.textContent = `UC: ${uc}`;
          if (elCvr) elCvr.textContent = `${cvr}%`;
          if (elCvrBar) elCvrBar.style.width = `${Math.min(100, Math.max(0, parseFloat(cvr)))}%`;
          if (elPlays) elPlays.textContent = play.toLocaleString();
          if (elPlayRate) elPlayRate.textContent = `${playRate}%`;

          // 更新实时流水事件
          const recentList = document.getElementById('recentEventsList');
          if (recentList && Array.isArray(recentRes)) {
            if (recentRes.length === 0) {
              recentList.innerHTML = `
                <div class="text-center py-10 text-slate-500 text-xs">
                  <p>等待第一条埋点上报...</p>
                  <p class="text-[11px] text-slate-600 mt-1">访客浏览或点击转存时自动上报并实时写入流水</p>
                </div>
              `;
            } else {
              const evLabels = {
                page_view: { text: 'PV 浏览', color: 'bg-blue-500/20 text-blue-300 border-blue-500/30' },
                click_quark: { text: '夸克保存', color: 'bg-purple-500/20 text-purple-300 border-purple-500/30' },
                click_uc: { text: 'UC保存', color: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30' },
                click_play: { text: '在线播放', color: 'bg-rose-500/20 text-rose-300 border-rose-500/30' }
              };
              recentList.innerHTML = recentRes.map(ev => {
                const badge = evLabels[ev.event_type] || { text: ev.event_type, color: 'bg-slate-800 text-slate-400 border-slate-700' };
                const timeStr = new Date(ev.created_at).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                const ipBadge = ev.ip ? `
                  <span class="px-1.5 py-0.5 rounded bg-slate-800/90 text-slate-300 border border-slate-700/60 font-mono text-[9px]" title="${ev.location || ''}">
                    📍 ${ev.ip}${ev.location ? ` (${ev.location.split(',')[0]})` : ''}
                  </span>
                ` : '';
                return `
                  <div class="flex items-center justify-between text-xs p-2 rounded-lg bg-slate-900/60 border border-slate-800/50 hover:border-slate-700 transition">
                    <div class="flex items-center gap-2 overflow-hidden">
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-medium border flex-shrink-0 ${badge.color}">
                        ${badge.text}
                      </span>
                      <span class="text-slate-200 truncate text-[11px]" title="${ev.resource_title || ev.page_url}">
                        ${ev.resource_title || '星光影库页面'}
                      </span>
                    </div>
                    <div class="flex items-center gap-1.5 flex-shrink-0 text-[10px] font-mono text-slate-500">
                      ${ipBadge}
                      <span>${ev.device === 'mobile' ? '📱' : '💻'}</span>
                      <span>${timeStr}</span>
                    </div>
                  </div>
                `;
              }).join('');
            }
          }

          // 动态更新 TOP 10 真实转存转化排行榜
          const topTableBody = document.getElementById('topConvertingTableBody');
          if (topTableBody && Array.isArray(topMoviesRes) && topMoviesRes.length > 0) {
            const sorted = topMoviesRes.map(m => {
              const saves = (m.clicks_quark || 0) + (m.clicks_uc || 0);
              const views = m.views || 0;
              const rate = views > 0 ? ((saves / views) * 100).toFixed(2) : '0.00';
              return { ...m, total_saves: saves, rate };
            }).sort((a, b) => (b.total_saves - a.total_saves) || (b.views - a.views));

            topTableBody.innerHTML = sorted.slice(0, 10).map((item, idx) => {
              const rankBadge = idx < 3 ? `
                <span class="inline-block w-5 h-5 rounded-full text-center leading-5 text-[10px] font-bold ${
                  idx === 0 ? 'bg-amber-400/20 text-amber-300 border border-amber-400/30' :
                  idx === 1 ? 'bg-slate-300/20 text-slate-200 border border-slate-300/30' :
                  'bg-orange-500/20 text-orange-300 border border-orange-500/30'
                }">
                  ${idx + 1}
                </span>
              ` : `<span>${idx + 1}</span>`;

              return `
                <tr class="hover:bg-slate-900/50 transition">
                  <td class="py-2 px-2 text-center font-mono text-slate-500">${rankBadge}</td>
                  <td class="py-2 px-3 text-slate-200 font-medium">
                    <a href="/movie/${item.id}" target="_blank" class="hover:text-orange-400 transition hover:underline">
                      ${item.title}
                    </a>
                    ${item.year ? `<span class="text-slate-500 font-normal ml-1">(${item.year})</span>` : ''}
                  </td>
                  <td class="py-2 px-2 text-center text-slate-400">
                    <span class="px-1.5 py-0.5 rounded bg-slate-800 text-[10px]">${item.category || '电影'}</span>
                  </td>
                  <td class="py-2 px-2 text-center font-mono text-slate-300">${item.views || 0}</td>
                  <td class="py-2 px-2 text-center font-mono text-purple-300">${item.clicks_quark || 0}</td>
                  <td class="py-2 px-2 text-center font-mono text-cyan-300">${item.clicks_uc || 0}</td>
                  <td class="py-2 px-2 text-center font-mono text-amber-300 font-bold">${item.total_saves || 0}</td>
                  <td class="py-2 px-3 text-right">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-orange-500/10 text-orange-400 border border-orange-500/30">
                      ${item.rate}%
                    </span>
                  </td>
                </tr>
              `;
            }).join('');
          }

          const now = new Date();
          const timeStr = now.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          if (statusText) statusText.textContent = '实时已连接';
          if (lastUpdated) lastUpdated.textContent = `最后刷新: ${timeStr}`;
          if (manual) showToast('已刷新并同步最新真实转化大盘数据', '⚡');
        } catch (err) {
          if (statusText) statusText.textContent = '实时刷新失败';
        } finally {
          if (spinner) spinner.classList.remove('animate-spin');
        }
      }

      // 绑定实时刷新按钮
      document.getElementById('refreshLiveMetricsBtn')?.addEventListener('click', () => {
        refreshLiveAnalytics(true);
      });

      // 页面加载完成后立即拉取最新实时数据
      refreshLiveAnalytics(false);

      // 开启无感静默轮询（每 20 秒在标签页处于前台时自动刷新）
      setInterval(() => {
        if (!document.hidden) {
          refreshLiveAnalytics(false);
        }
      }, 20000);

      // 初始渲染
      render();
    </script>
  </body>
</html>
