---
import { getAllMoviesForAdmin, getAnalyticsMetrics } from '../../lib/db.js';

// 获取全量影视资源数据与实时转化大盘指标
const [allMovies, analyticsMetrics] = await Promise.all([
  getAllMoviesForAdmin(),
  getAnalyticsMetrics()
]);

// 基础统计大盘指标计算
const totalCount = allMovies.length;
const readyMetaCount = allMovies.filter(m => m.has_metadata === true).length;
const pendingMetaCount = allMovies.filter(m => !m.has_metadata).length;
const ucCount = allMovies.filter(m => !!m.share_link_uc).length;
const quarkCount = allMovies.filter(m => !!m.share_link).length;
const playCount = allMovies.filter(m => !!m.online_play_url).length;
const ongoingSeriesCount = allMovies.filter(m => (m.category === '电视剧' || m.category === '综艺') && m.is_finished === false).length;

// 分类数量汇总
const categories = ['全部', '电影', '电视剧', '综艺', '动漫', '纪录片'];
const categoryCounts: Record<string, number> = { 全部: totalCount };
for (const cat of categories.slice(1)) {
  categoryCounts[cat] = allMovies.filter(m => m.category === cat).length;
}

// 格式化数据传递给客户端（避免超长不可序列化数据）
const serializedMovies = JSON.stringify(allMovies);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>星光影库 · 资产与数据中枢管理后台</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 引入 Hls.js 便于后台直接播放测试 M3U8 视频源 -->
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest" defer></script>
  </head>
  <body class="bg-[#0b0f19] text-slate-100 min-h-screen antialiased selection:bg-orange-500 selection:text-white flex flex-col font-sans">
    
    <!-- 顶部全局导航栏 -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-[#0b0f19]/90 border-b border-slate-800 px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-orange-500 to-amber-400 flex items-center justify-center shadow-lg shadow-orange-500/20 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 text-white fill-current" viewBox="0 0 24 24">
              <path d="M4 6.47v11.06c0 .77.85 1.25 1.51.84l8.84-5.53c.63-.39.63-1.3 0-1.69L5.51 5.63C4.85 5.22 4 5.7 4 6.47z"/>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-base font-bold bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-slate-400">
                星光影库
              </span>
              <span class="text-xs px-2 py-0.5 rounded-full font-mono bg-purple-500/20 text-purple-300 border border-purple-500/30">
                Data Hub
              </span>
            </div>
            <p class="text-[11px] text-slate-400 hidden sm:block">采集资产全景监控 · 资源转存状态 · 门禁就绪大盘</p>
          </div>
        </a>
      </div>

      <div class="flex items-center gap-2.5">
        <button id="exportCsvBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors shadow-sm">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>导出 CSV</span>
        </button>

        <button id="exportJsonBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors shadow-sm">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>导出 JSON</span>
        </button>

        <a href="/" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-orange-500/20 hover:bg-orange-500/30 text-orange-300 border border-orange-500/40 transition-colors shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>前台首页</span>
        </a>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
      
      <!-- 顶部统计 KPI 指标卡片矩阵 -->
      <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-3">
        <!-- 1. 全库收录 -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-slate-700 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-400 font-medium">全库总收录</span>
            <span class="p-1.5 rounded-lg bg-blue-500/10 text-blue-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tracking-tight text-white">{totalCount}</span>
            <span class="text-[11px] text-slate-400">部</span>
          </div>
          <span class="text-[10px] text-slate-400 mt-1">豆瓣+TMDB双源汇聚</span>
        </div>

        <!-- 2. 已上线/元数据就绪 -->
        <div class="bg-slate-900/80 border border-emerald-900/40 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-emerald-800/60 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-emerald-400 font-medium">已上线 (门禁过审)</span>
            <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tracking-tight text-emerald-300">{readyMetaCount}</span>
            <span class="text-[11px] text-emerald-500 font-mono">({Math.round(readyMetaCount / (totalCount || 1) * 100)}%)</span>
          </div>
          <span class="text-[10px] text-emerald-500/80 mt-1">前台可独立访问页面</span>
        </div>

        <!-- 3. 待补元数据种子池 -->
        <div class="bg-slate-900/80 border border-amber-900/40 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-amber-800/60 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-amber-400 font-medium">待补元数据种子</span>
            <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tracking-tight text-amber-300">{pendingMetaCount}</span>
            <span class="text-[11px] text-amber-500">部</span>
          </div>
          <span class="text-[10px] text-amber-500/80 mt-1">门禁隔离 · 待TMDB补齐</span>
        </div>

        <!-- 4. 在线播放源 -->
        <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-slate-700 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-rose-400 font-medium">在线播放切片</span>
            <span class="p-1.5 rounded-lg bg-rose-500/10 text-rose-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tracking-tight text-rose-300">{playCount}</span>
            <span class="text-[11px] text-slate-400">部</span>
          </div>
          <span class="text-[10px] text-rose-400/80 mt-1">免广告 M3U8 秒播流</span>
        </div>

        <!-- 5. UC 转存 -->
        <div class="bg-slate-900/80 border border-cyan-900/40 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-cyan-800/60 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-cyan-400 font-medium">UC网盘转存</span>
            <span class="p-1.5 rounded-lg bg-cyan-500/10 text-cyan-400 font-bold text-xs">
              UC
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tracking-tight text-cyan-300">{ucCount}</span>
            <span class="text-[11px] text-cyan-500">部</span>
          </div>
          <span class="text-[10px] text-cyan-400/80 mt-1">带个人 PID 推广返佣</span>
        </div>

        <!-- 6. 夸克转存 -->
        <div class="bg-slate-900/80 border border-purple-900/40 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-purple-800/60 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-purple-400 font-medium">夸克网盘转存</span>
            <span class="p-1.5 rounded-lg bg-purple-500/10 text-purple-400 font-bold text-xs">
              QK
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tracking-tight text-purple-300">{quarkCount}</span>
            <span class="text-[11px] text-purple-500">部</span>
          </div>
          <span class="text-[10px] text-purple-400/80 mt-1">带个人 PID 专属收益</span>
        </div>

        <!-- 7. 连载追更中 -->
        <div class="bg-slate-900/80 border border-amber-900/30 rounded-xl p-3.5 flex flex-col justify-between shadow-sm hover:border-amber-800/50 transition">
          <div class="flex items-center justify-between">
            <span class="text-xs text-orange-400 font-medium">连载追更中</span>
            <span class="p-1.5 rounded-lg bg-orange-500/10 text-orange-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </span>
          </div>
          <div class="mt-2 flex items-baseline gap-1.5">
            <span class="text-2xl font-bold tracking-tight text-orange-300">{ongoingSeriesCount}</span>
            <span class="text-[11px] text-orange-500">部</span>
          </div>
          <span class="text-[10px] text-orange-400/80 mt-1">每日定时巡检更新集数</span>
        </div>
      </section>

      <!-- 真实访问量与网盘转存转化率大盘 (Traffic & Conversion Rate Analytics) -->
      <section class="bg-gradient-to-b from-slate-900/90 to-slate-900/50 border border-slate-800 rounded-2xl p-5 space-y-5 shadow-xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800/80 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-orange-500/20 border border-orange-500/40 flex items-center justify-center text-orange-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-white tracking-wide">真实访问与网盘转存转化率全景监控</h3>
                <span id="liveStatusIndicator" class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span id="liveStatusText">实时连接就绪</span>
                </span>
                <span id="lastUpdatedTime" class="text-[10px] text-slate-500 font-mono hidden sm:inline"></span>
              </div>
              <p class="text-[11px] text-slate-400 mt-0.5">全站 PV 访问无感上报 · 夸克与 UC 转存点击归因 · 客户端秒级实时拉取最新转化</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button id="refreshLiveMetricsBtn" type="button" class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/30 transition shadow-sm cursor-pointer active:scale-95">
              <svg id="refreshSpinner" class="w-3.5 h-3.5 text-emerald-400 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>实时刷新</span>
            </button>
            <a href="/" target="_blank" class="text-xs px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">
              前台验证点击 ↗
            </a>
          </div>
        </div>

        <!-- 4 核心转化指标卡 -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5">
          <!-- 1. 全站真实访问量 (PV) -->
          <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-400">全站真实浏览量 (PV)</span>
              <span class="text-xs text-blue-400 bg-blue-500/10 px-1.5 py-0.5 rounded">Views</span>
            </div>
            <div class="my-2 flex items-baseline gap-2">
              <span id="metricTotalPv" class="text-2xl font-bold text-white font-mono">{analyticsMetrics.totalPv.toLocaleString()}</span>
              <span class="text-[11px] text-slate-400">次浏览</span>
            </div>
            <div class="text-[11px] text-slate-400 flex items-center justify-between">
              <span id="metricMobilePv">📱 移动端 {analyticsMetrics.deviceBreakdown.mobile}</span>
              <span id="metricDesktopPv">💻 电脑端 {analyticsMetrics.deviceBreakdown.desktop}</span>
            </div>
          </div>

          <!-- 2. 网盘总转存量 -->
          <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs text-amber-400 font-medium">网盘总转存保存</span>
              <span class="text-xs text-amber-400 bg-amber-500/10 px-1.5 py-0.5 rounded">Saves</span>
            </div>
            <div class="my-2 flex items-baseline gap-2">
              <span id="metricTotalSaves" class="text-2xl font-bold text-amber-300 font-mono">{analyticsMetrics.totalSaves.toLocaleString()}</span>
              <span class="text-[11px] text-slate-400">次点击</span>
            </div>
            <div class="text-[11px] text-slate-400 flex items-center justify-between">
              <span id="metricQuarkSaves" class="text-purple-300">夸克: {analyticsMetrics.totalQuark}</span>
              <span id="metricUcSaves" class="text-cyan-300">UC: {analyticsMetrics.totalUc}</span>
            </div>
          </div>

          <!-- 3. 网盘转存转化率 -->
          <div class="bg-slate-950/60 border border-orange-500/30 rounded-xl p-3.5 flex flex-col justify-between bg-gradient-to-br from-orange-500/5 to-transparent">
            <div class="flex items-center justify-between">
              <span class="text-xs text-orange-300 font-medium">网盘转存综合转化率</span>
              <span class="text-xs text-orange-400 bg-orange-500/10 px-1.5 py-0.5 rounded font-mono">CVR</span>
            </div>
            <div class="my-2 flex items-baseline gap-1.5">
              <span id="metricSaveRate" class="text-3xl font-extrabold text-orange-400 font-mono">{analyticsMetrics.overallSaveRate}%</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-1.5 overflow-hidden">
              <div id="metricSaveRateBar" class="bg-gradient-to-r from-orange-500 to-amber-400 h-1.5 rounded-full transition-all duration-500" style={`width: ${Math.min(100, Math.max(0, parseFloat(analyticsMetrics.overallSaveRate)))}%`}></div>
            </div>
          </div>

          <!-- 4. 在线播放转化率 -->
          <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-3.5 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-400">在线播放点播量</span>
              <span class="text-xs text-rose-400 bg-rose-500/10 px-1.5 py-0.5 rounded">Plays</span>
            </div>
            <div class="my-2 flex items-baseline gap-2">
              <span id="metricTotalPlays" class="text-2xl font-bold text-rose-300 font-mono">{analyticsMetrics.totalPlay.toLocaleString()}</span>
              <span class="text-[11px] text-slate-400">次播放</span>
            </div>
            <div class="text-[11px] text-slate-400">
              播放转化率: <span id="metricPlayRate" class="text-rose-400 font-mono font-medium">{analyticsMetrics.overallPlayRate}%</span>
            </div>
          </div>
        </div>

        <!-- 下层双栏：TOP 10 转化最高影视榜单 + 实时流水与端分布 -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          <!-- 左栏：TOP 10 转化最高影视 (8列) -->
          <div class="lg:col-span-8 bg-slate-950/70 border border-slate-800/80 rounded-xl p-4">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-1.5">
                  🏆 转存转化率排行榜 (TOP 10)
                </span>
                <span class="text-[10px] text-slate-500">按网盘保存量与转化效率排行</span>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs">
                <thead>
                  <tr class="text-slate-400 border-b border-slate-800/80 pb-2">
                    <th class="py-2 px-2 w-10 text-center font-medium">#</th>
                    <th class="py-2 px-3 font-medium">影视片名</th>
                    <th class="py-2 px-2 text-center font-medium">分类</th>
                    <th class="py-2 px-2 text-center font-medium">浏览PV</th>
                    <th class="py-2 px-2 text-center font-medium text-purple-400">夸克转存</th>
                    <th class="py-2 px-2 text-center font-medium text-cyan-400">UC转存</th>
                    <th class="py-2 px-2 text-center font-medium text-amber-400">总保存</th>
                    <th class="py-2 px-3 text-right font-medium text-orange-400">转存转化率</th>
                  </tr>
                </thead>
                <tbody id="topConvertingTableBody" class="divide-y divide-slate-800/40">
                  {analyticsMetrics.topConverting.map((item, idx) => (
                    <tr class="hover:bg-slate-900/50 transition">
                      <td class="py-2 px-2 text-center font-mono text-slate-500">
                        {idx < 3 ? (
                          <span class={`inline-block w-5 h-5 rounded-full text-center leading-5 text-[10px] font-bold ${
                            idx === 0 ? 'bg-amber-400/20 text-amber-300 border border-amber-400/30' :
                            idx === 1 ? 'bg-slate-300/20 text-slate-200 border border-slate-300/30' :
                            'bg-orange-500/20 text-orange-300 border border-orange-500/30'
                          }`}>
                            {idx + 1}
                          </span>
                        ) : (
                          <span>{idx + 1}</span>
                        )}
                      </td>
                      <td class="py-2 px-3 text-slate-200 font-medium">
                        <a href={`/movie/${item.id}`} target="_blank" class="hover:text-orange-400 transition hover:underline">
                          {item.title}
                        </a>
