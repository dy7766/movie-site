---
import Layout from '../../layouts/Layout.astro';
import { getMovies } from '../../lib/db.js';

export async function getStaticPaths() {
  const movies = await getMovies({ limit: 2000 });
  return movies.map((movie) => ({
    params: { id: movie.id },
    props: { movie }
  }));
}

const { movie } = Astro.props;

const isTvShow = movie.category === '电视剧' || movie.category === '动漫' || movie.category === '综艺';
const epUnit = movie.category === '综艺' ? '期' : '集';

// 智能提取剧集与连载状态
let totalEpisodes = movie.total_episodes || 0;
let currentEpisodes = movie.current_episode || 0;
const isFinished = movie.is_finished !== false;

if (isTvShow) {
  if (!totalEpisodes) {
    const allText = (movie.tags?.join(' ') || '') + ' ' + (movie.title || '') + ' ' + (movie.intro || '');
    const match = allText.match(/全?(\d+)集/);
    if (match) {
      totalEpisodes = parseInt(match[1]);
    } else {
      if (movie.title.includes('繁花')) totalEpisodes = 30;
      else if (movie.title.includes('狂飙')) totalEpisodes = 39;
      else if (movie.title.includes('阿勒泰')) totalEpisodes = 8;
      else if (movie.title.includes('庆余年')) totalEpisodes = 36;
      else if (movie.title.includes('进击的巨人')) totalEpisodes = 28;
      else if (movie.title.includes('歌手')) totalEpisodes = 12;
      else if (movie.title.includes('喜人')) totalEpisodes = 11;
      else if (movie.title.includes('脱口秀')) totalEpisodes = 10;
      else if (movie.title.includes('种地吧')) totalEpisodes = 50;
      else totalEpisodes = 24; // 常见剧集默认集数
    }
  }
  if (!currentEpisodes) {
    currentEpisodes = isFinished ? totalEpisodes : Math.min(totalEpisodes, 12);
  }
}

const episodesList = Array.from({ length: totalEpisodes }, (_, i) => {
  const ep = i + 1;
  const isAvailable = Boolean(movie.share_link_uc || movie.share_link) && ep <= currentEpisodes;
  const targetUrl = movie.share_link_uc || movie.share_link;
  return { ep, isAvailable, targetUrl };
});

const epStatusText = isTvShow 
  ? (isFinished ? `全${totalEpisodes}${epUnit}完整版` : `连载追更至第${currentEpisodes}${epUnit}`)
  : '4K超清完整版';

const pageTitle = `《${movie.title}》${movie.year ? `(${movie.year})` : ''}${epStatusText}在线观看_免费下载/夸克UC网盘资源 - 星光影库`;

const cleanActors = (movie.actors || '')
  .split(/[\/,、\s]+/)
  .map(a => a.trim())
  .filter(a => a.length >= 2 && a.length <= 10)
  .slice(0, 5);

const genreTags: string[] = Array.isArray(movie.tags)
  ? movie.tags
  : (typeof movie.tags === 'string' ? JSON.parse(movie.tags || '[]') : []);

const dynamicKeywords = Array.from(new Set([
  movie.title,
  `${movie.title}在线观看`,
  `${movie.title}高清完整版`,
  `${movie.title}免费下载`,
  `${movie.title}4K原盘`,
  `${movie.title}夸克网盘`,
  `${movie.title}UC网盘`,
  `${movie.title}迅雷下载`,
  `${movie.title}大结局`,
  movie.category || '电影',
  movie.year ? `${movie.year}${movie.category || '电影'}` : '',
  ...cleanActors,
  ...genreTags.map(t => `${t}${movie.category || '电影'}`),
  '星光影库'
])).filter(Boolean).join(',');

const actorsSnippet = cleanActors.length > 0 ? `由${cleanActors.join('、')}等主演，` : '';
const genresSnippet = genreTags.length > 0 ? `类型涵盖${genreTags.slice(0, 4).join('/')}，` : '';
const introSnippet = movie.intro ? movie.intro.replace(/\s+/g, ' ').slice(0, 140) + '...' : '精彩剧作不容错过。';

const pageDesc = `星光影库为您提供《${movie.title}》${movie.year ? `(${movie.year})` : ''}超高清4K原画在线观看与无损原盘转存下载服务。本片${actorsSnippet}${genresSnippet}豆瓣高分口碑力作。剧情简介：${introSnippet}`;

// Schema.org 结构化数据
const movieSchema = {
  "@context": "https://schema.org",
  "@type": isTvShow ? "TVSeries" : "Movie",
  "name": movie.title,
  "alternateName": movie.original_title || undefined,
  "image": movie.poster_url || "https://xkykmovie.com/favicon.svg",
  "description": movie.intro || pageDesc,
  "datePublished": movie.release_date || (movie.year ? `${movie.year}-01-01` : undefined),
  "genre": genreTags,
  "actor": cleanActors.map(name => ({ "@type": "Person", "name": name })),
  "aggregateRating": movie.score ? {
    "@type": "AggregateRating",
    "ratingValue": String(movie.score),
    "bestRating": "10",
    "worstRating": "1",
    "ratingCount": "100"
  } : undefined
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首页",
      "item": "https://xkykmovie.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": movie.category || "电影",
      "item": `https://xkykmovie.com/tag/${encodeURIComponent(movie.category || '电影')}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": movie.title,
      "item": `https://xkykmovie.com/movie/${movie.id}`
    }
  ]
};

// 解析剧照与短评
const stills: string[] = Array.isArray(movie.stills)
  ? movie.stills
  : (typeof movie.stills === 'string' ? JSON.parse(movie.stills || '[]') : []);

interface Review {
  id: string;
  author: string;
  avatar?: string;
  rating: number;
  date: string;
  votes?: number;
  content: string;
}

const reviews: Review[] = Array.isArray(movie.reviews)
  ? movie.reviews
  : (typeof movie.reviews === 'string' ? JSON.parse(movie.reviews || '[]') : []);

// 解析在线播放源与分集
interface Episode {
  name: string;
  url: string;
}

interface PlaySource {
  source: string;
  type: string;
  episodes: Episode[];
}

const playSources: PlaySource[] = Array.isArray(movie.play_sources)
  ? movie.play_sources
  : (typeof movie.play_sources === 'string' ? JSON.parse(movie.play_sources || '[]') : []);
---

<Layout 
  title={pageTitle} 
  description={pageDesc} 
  keywords={dynamicKeywords}
  image={movie.poster_url}
  type="video.movie"
  schemaJsonLd={[movieSchema, breadcrumbSchema]}
  movieId={movie.id} 
  movieTitle={movie.title} 
  hideMobileTabBar={true}
>
  <div class="max-w-6xl mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-12 pb-24 sm:pb-12">
    <!-- 面包屑导航 -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8">
      <a href="/" class="hover:text-orange-400 transition-colors">首页</a>
      <span>/</span>
      <a href={`/?cat=${movie.category || '电影'}`} class="hover:text-orange-400 transition-colors">{movie.category || '电影'}</a>
      <span>/</span>
      <span class="text-slate-200 font-medium line-clamp-1">{movie.title}</span>
    </nav>

    <!-- 影视核心信息板块 -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 bg-slate-900/40 rounded-3xl p-6 sm:p-8 border border-slate-800/80 backdrop-blur-xl">
      <!-- 左侧：高清海报 -->
      <div class="md:col-span-4 lg:col-span-4 flex flex-col items-center">
        <div class="relative w-full max-w-[280px] aspect-[2/3] rounded-2xl overflow-hidden shadow-2xl border border-slate-700/60 group">
          <img 
            src={movie.poster_url || 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=600&auto=format&fit=crop'} 
            alt={movie.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          {movie.score && (
            <div class="absolute top-3 right-3 px-2.5 py-1 rounded-lg bg-black/70 backdrop-blur-md border border-white/10 text-amber-400 text-sm font-extrabold shadow-lg">
              ★ {Number(movie.score).toFixed(1)}
            </div>
          )}
        </div>
      </div>

      <!-- 右侧：影视详情与转存操作 -->
      <div class="md:col-span-8 lg:col-span-8 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="px-3 py-1 rounded-lg bg-orange-500/20 text-orange-400 border border-orange-500/30 text-xs font-semibold">
              {movie.category || '电影'}
            </span>
            {movie.is_released === false ? (
              <span class="px-2.5 py-1 rounded-lg bg-purple-500/20 text-purple-300 border border-purple-500/40 text-xs font-semibold flex items-center gap-1.5 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
                ⏳ 待上映 / 尚未公映
              </span>
            ) : isTvShow && (
              isFinished ? (
                <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-semibold flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  已完结 · 全 {totalEpisodes} {epUnit}完整版
                </span>
              ) : (
                <span class="px-2.5 py-1 rounded-lg bg-orange-500/20 text-orange-400 border border-orange-500/30 text-xs font-semibold flex items-center gap-1.5 shadow-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
                  🔥 连载追更中 · 每日更新至第 {currentEpisodes} {epUnit}
                </span>
              )
            )}
            {movie.year && (
              <span class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 text-xs font-medium">
                {movie.year} 年
              </span>
            )}
            {(movie.share_link && movie.share_link_uc) ? (
              <span class="px-2.5 py-1 rounded-lg bg-gradient-to-r from-orange-500/15 via-amber-500/15 to-orange-500/15 text-orange-400 border border-orange-500/30 text-xs font-semibold flex items-center gap-1.5 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
                🔥 4K HDR 杜比原盘 · 夸克+UC双转存
              </span>
            ) : movie.share_link ? (
              <span class="px-2.5 py-1 rounded-lg bg-orange-500/15 text-orange-400 border border-orange-500/30 text-xs font-semibold flex items-center gap-1.5 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
                ⚡ 夸克 4K HDR 原盘就绪
              </span>
            ) : movie.share_link_uc ? (
              <span class="px-2.5 py-1 rounded-lg bg-amber-500/15 text-amber-300 border border-amber-500/30 text-xs font-semibold flex items-center gap-1.5 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                💾 UC 4K 原盘极速就绪
              </span>
            ) : movie.online_play_url ? (
              <span class="px-2.5 py-1 rounded-lg bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 text-xs font-medium flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
                1080P 网页轻量预览
              </span>
            ) : (
              <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                暂无网盘资源 · 排期中
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
            {movie.title}
          </h1>

          {movie.original_title && movie.original_title !== movie.title && (
            <p class="text-sm text-slate-400 font-mono">
              原名：{movie.original_title}
            </p>
          )}

          <!-- 标签分类 -->
          {movie.tags && movie.tags.length > 0 && (
            <div class="flex items-center gap-2 flex-wrap pt-1">
              <span class="text-xs text-slate-500">类型标签：</span>
              {movie.tags.map((tag: string) => (
                <span class="px-2 py-0.5 rounded bg-slate-800/80 border border-slate-700/60 text-slate-300 text-[11px]">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <!-- 主演阵容 -->
          <div class="pt-2 border-t border-slate-800/80">
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              <strong class="text-slate-400">演职阵容：</strong> {movie.actors || '暂无详细演职员信息'}
            </p>
          </div>

          <!-- 剧情简介 -->
          <div class="pt-2">
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">剧情简介</h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed bg-slate-950/40 p-4 rounded-xl border border-slate-800/60">
              {movie.intro || '暂无详细剧情介绍。'}
            </p>
          </div>
        </div>

        <!-- 核心变现与播放行动区（电影 / 电视剧 / 综艺 / 动漫 通用） -->
        <div class="pt-6 border-t border-slate-800/80 space-y-4">
          <!-- 未上映/待播状态友好提示 -->
          {movie.is_released === false && (
            <div class="rounded-2xl border border-purple-500/30 bg-purple-950/20 p-5 space-y-2.5">
              <div class="flex items-center gap-2 text-purple-300 font-bold text-sm">
                <span class="w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse"></span>
                <span>本片尚未公映 / 敬请期待</span>
              </div>
              <p class="text-xs text-purple-200/80 leading-relaxed">
                官方预计上映/首播时间：<strong class="text-white">{movie.release_date || (movie.year ? `${movie.year} 年` : '敬请期待')}</strong>。星光影库自动化巡检系统正在持续跟踪，一旦公映首播，将第一时间为您自动转存 4K 原盘并更新极速播放源！
              </p>
            </div>
          )}

          <!-- 网盘转存按钮组 (如果有网盘链接且已开播) -->
          {movie.is_released !== false && (movie.share_link || movie.share_link_uc) && (
            <div class="space-y-3.5">
              <div class="flex items-center justify-between text-xs text-slate-400">
                <span class="flex items-center gap-1.5 font-bold text-slate-200">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>{isTvShow ? '4K 全集无损杜比原盘已就绪（支持 TV 投屏 / 离线追剧）：' : '4K 杜比视界原盘已就绪（原画无损 / 免流播放 / 高速下载）：'}</span>
                </span>
                {(movie.share_link && movie.share_link_uc) && (
                  <span class="text-[11px] px-2 py-0.5 rounded-full bg-orange-500/10 text-orange-400 border border-orange-500/30 font-bold">
                    双网盘线路极速秒存
                  </span>
                )}
              </div>

              <div class={`grid gap-3.5 ${(movie.share_link && movie.share_link_uc) ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1'}`}>
                {movie.share_link && (
                  <a 
                    href={movie.share_link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    data-track="quark"
                    data-resource-id={movie.id}
                    data-resource-title={movie.title}
                    class="relative py-3.5 px-5 rounded-2xl bg-gradient-to-r from-orange-500 via-orange-600 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-sm text-center shadow-xl shadow-orange-500/25 transition-all transform hover:-translate-y-0.5 flex flex-col items-center justify-center gap-1 group overflow-hidden border border-orange-400/40"
                  >
                    <span class="absolute top-2 right-2.5 px-2 py-0.5 rounded-md bg-amber-400 text-slate-950 text-[10px] font-black uppercase tracking-tight shadow">
                      新用户送1TB
                    </span>
                    <div class="flex items-center justify-center gap-2">
                      <svg class="w-5 h-5 fill-current group-hover:scale-110 transition-transform text-amber-200" viewBox="0 0 24 24">
                        <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
                      </svg>
                      <span class="text-sm sm:text-base font-extrabold tracking-wide">
                        {movie.share_link_uc ? (isTvShow ? '【首选推荐】夸克全集打包秒存' : '【首选推荐】夸克 4K 杜比原盘秒存') : (isTvShow ? '立即转存全集（夸克 4K 原画）' : '转存完整版（夸克 4K 杜比视界原盘）')}
                      </span>
                    </div>
                    <p class="text-[11px] text-orange-100 font-medium">无损杜比全景声 · 支持电视投屏 · 手机离线缓存</p>
                  </a>
                )}

                {movie.share_link_uc && (
                  <a 
                    href={movie.share_link_uc} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    data-track="uc"
                    data-resource-id={movie.id}
                    data-resource-title={movie.title}
                    class="relative py-3.5 px-5 rounded-2xl bg-gradient-to-r from-amber-500 via-yellow-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-slate-950 font-extrabold text-sm text-center shadow-xl shadow-amber-500/25 transition-all transform hover:-translate-y-0.5 flex flex-col items-center justify-center gap-1 group overflow-hidden border border-yellow-400/40"
                  >
                    <span class="absolute top-2 right-2.5 px-2 py-0.5 rounded-md bg-slate-950 text-amber-300 text-[10px] font-black uppercase tracking-tight shadow">
                      官方特权
                    </span>
                    <div class="flex items-center justify-center gap-2">
                      <svg class="w-5 h-5 fill-current group-hover:scale-110 transition-transform text-slate-900" viewBox="0 0 24 24">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
                      </svg>
                      <span class="text-sm sm:text-base font-extrabold tracking-wide">
                        {movie.share_link ? (isTvShow ? '【备用线路】UC 全集极速秒存' : '【备用线路】UC 网盘 4K 原盘秒存') : (isTvShow ? '立即转存全集（UC 网盘极速秒存）' : '转存完整版（UC 网盘 4K 极速秒存）')}
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-900 font-bold">原盘不限速秒转 · 免费领取 1TB 官方空间</p>
                  </a>
                )}
              </div>

              <!-- 画质反差与心智说明卡片 -->
              <div class="p-3 sm:p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 flex items-start gap-2.5 text-xs text-slate-400">
                <span class="text-amber-400 font-bold shrink-0 text-sm">💡 画质说明：</span>
                <p class="leading-relaxed">
                  下方网页播放受公网切片带宽限制，已压缩为 <span class="text-slate-300 font-medium">1080P 轻量预览流</span>；如需影院级 <strong class="text-amber-300 font-bold">4K 60帧 HDR 杜比视界原盘、无删减版本及原声无损音轨</strong>，强烈推荐免费转存至网盘原画欣赏！
                </p>
              </div>

              <!-- 网盘空间扩容福利指引卡片 (促转存提转化率) -->
              <div class="p-3 sm:p-3.5 rounded-xl bg-gradient-to-r from-amber-500/10 via-yellow-500/5 to-transparent border border-amber-500/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5">
                <div class="flex items-center gap-2">
                  <span class="text-base sm:text-lg">🎁</span>
                  <div class="text-xs">
                    <span class="font-bold text-amber-300">网盘空间不够用？</span>
                    <span class="text-slate-400 ml-1">星光影库官方通道支持免费领取 <strong class="text-white font-semibold">UC 网盘 1TB 永久免费空间</strong></span>
                  </div>
                </div>
                <a 
                  href="https://broccoli.uc.cn/apps/uc2024_expert_benefits_activity/routes/receive-welfare?_t=AAQ%2BiiOTPRTIukDBF6n4NBoQZhT3i6qoy6iZofqalCKHC4NLBXK7Dp1iO8vFNdiV8WR6VrmXe2p0XU%2BEgtK5TOE5" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-3 py-1 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition-all flex items-center gap-1 shrink-0 shadow-sm"
                >
                  <span>立即免费领 1TB</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          )}

          <!-- 在线播放直达按钮 (如果有在线播放源) -->
          {movie.online_play_url && (
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <a 
                href="#onlinePlayerSection" 
