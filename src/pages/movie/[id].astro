  <!-- 在线播放器脚本注入 (仅当有在线播放资源时激活) -->
  {movie.online_play_url && (
    <>
      <script is:inline src="https://cdn.jsdelivr.net/npm/hls.js@1.5.8/dist/hls.min.js"></script>
      <script is:inline src="https://cdn.jsdelivr.net/npm/artplayer@5.1.7/dist/artplayer.legacy.js"></script>
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const playerEl = document.getElementById('artplayer-app');
          if (!playerEl) return;

          const initialUrl = playerEl.dataset.url;
          const initialPoster = playerEl.dataset.poster;
          const hasDriveLinks = playerEl.dataset.hasDrive === 'true';
          const loadingNotice = document.getElementById('playerLoadingNotice');
          const badge = document.getElementById('currentEpisodeBadge');
          const pauseOverlay = document.getElementById('playerPauseOverlay');
          const cutoffOverlay = document.getElementById('previewCutoffOverlay');
          const cutoffTitle = document.getElementById('cutoffOverlayTitle');
          const cutoffSub = document.getElementById('cutoffOverlaySub');
          const resumeBtn = document.getElementById('resumePlayBtn');

          const PREVIEW_LIMIT = 360; // 6 分钟试看限制（秒）
          let isCutoffActive = false;
          let art = null;

          function triggerCutoff(titleText, subText) {
            isCutoffActive = true;
            if (art) {
              try {
                art.pause();
                if (art.currentTime > PREVIEW_LIMIT) {
                  art.currentTime = PREVIEW_LIMIT;
                }
              } catch (_) {}
            }
            if (pauseOverlay) pauseOverlay.classList.add('hidden');
            if (cutoffOverlay) {
              if (cutoffTitle && titleText) cutoffTitle.textContent = titleText;
              if (cutoffSub && subText) cutoffSub.textContent = subText;
              cutoffOverlay.classList.remove('hidden');
            }
          }

          function initPlayer(streamUrl) {
            if (art) {
              try { art.destroy(false); } catch (e) {}
            }

            art = new Artplayer({
              container: '#artplayer-app',
              url: streamUrl,
              poster: initialPoster || '',
              volume: 0.8,
              isLive: false,
              muted: false,
              autoplay: false,
              pip: true,
              autoSize: false,
              autoMini: false,
              screenshot: true,
              setting: true,
              loop: false,
              flip: true,
              playbackRate: true,
              aspectRatio: true,
              fullscreen: true,
              fullscreenWeb: true,
              miniProgressBar: true,
              mutex: true,
              backdrop: true,
              playsInline: true,
              autoPlayback: true,
              airplay: true,
              theme: '#6366f1',
              lang: 'zh-cn',
              customType: {
                m3u8: function (video, playUrl, artInstance) {
                  if (window.Hls && window.Hls.isSupported()) {
                    if (artInstance.hls) artInstance.hls.destroy();
                    const hls = new window.Hls();
                    hls.loadSource(playUrl);
                    hls.attachMedia(video);
                    artInstance.hls = hls;
                    artInstance.on('destroy', () => hls.destroy());

                    hls.on(window.Hls.Events.MANIFEST_PARSED, () => {
                      if (loadingNotice) loadingNotice.classList.add('hidden');
                    });
                    hls.on(window.Hls.Events.ERROR, (event, data) => {
                      if (data.fatal) {
                        if (loadingNotice) {
                          loadingNotice.classList.remove('hidden');
                          loadingNotice.innerHTML = '<span class="text-amber-400">视频切片加载中，请稍候或尝试刷新重试</span>';
                        }
                      }
                    });
                  } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                    video.src = playUrl;
                    if (loadingNotice) loadingNotice.classList.add('hidden');
                  } else {
                    artInstance.notice.show = '当前浏览器不支持播放该格式视频';
                  }
                }
              }
            });

            art.on('ready', () => {
              if (loadingNotice) loadingNotice.classList.add('hidden');
            });

            // ⏱️ 核心转化机制：试看 6 分钟强制截断拦截
            if (hasDriveLinks) {
              art.on('video:timeupdate', () => {
                if (art.currentTime >= PREVIEW_LIMIT) {
                  triggerCutoff('🎬 本片精彩试看已结束 · 解锁完整版', '网页轻量预览仅支持前 6 分钟试看');
                }
              });

              art.on('video:seeked', () => {
                if (art.currentTime >= PREVIEW_LIMIT) {
                  triggerCutoff('🎬 本片精彩试看已结束 · 解锁完整版', '网页轻量预览仅支持前 6 分钟试看');
                }
              });
            }

            // 监听暂停与播放事件
            art.on('pause', () => {
              if (!isCutoffActive && pauseOverlay) {
                pauseOverlay.classList.remove('hidden');
              }
            });

            art.on('play', () => {
              if (isCutoffActive) {
                art.pause();
                if (cutoffOverlay) cutoffOverlay.classList.remove('hidden');
                return;
              }
              if (pauseOverlay) pauseOverlay.classList.add('hidden');
            });

            art.on('video:ended', () => {
              if (hasDriveLinks) {
                triggerCutoff('🎬 本片精彩试看已结束 · 解锁完整版', '无删减 4K 完整版已就绪，转存后畅享全片');
              } else if (pauseOverlay) {
                pauseOverlay.classList.remove('hidden');
              }
            });

            if (resumeBtn) {
              resumeBtn.onclick = (e) => {
                e.preventDefault();
                if (pauseOverlay) pauseOverlay.classList.add('hidden');
                if (art && !isCutoffActive) art.play();
              };
            }
          }

          if (initialUrl) {
            initPlayer(initialUrl);
          }

          // 选集切换（第 1 集试看，第 2 集及后续分集必须转存网盘）
          const episodeBtns = document.querySelectorAll('.episode-play-btn');
          episodeBtns.forEach(btn => {
            btn.addEventListener('click', () => {
              const isLocked = btn.getAttribute('data-locked') === 'true';
              const newName = btn.getAttribute('data-name');
              const newUrl = btn.getAttribute('data-url');

              if (isLocked) {
                triggerCutoff(`🔒 解锁 ${newName} 及后续全集`, '第 2 集及后续剧集已全部打包在网盘，转存即可解锁畅看');
                return;
              }

              // 第 1 集正常切换试看
              isCutoffActive = false;
              if (cutoffOverlay) cutoffOverlay.classList.add('hidden');
              if (pauseOverlay) pauseOverlay.classList.add('hidden');

              episodeBtns.forEach(b => {
                b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-500', 'shadow-md', 'shadow-indigo-600/30', 'font-bold');
                b.classList.add('bg-slate-800/80', 'text-slate-300', 'border-slate-700/60');
              });
              btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-500', 'shadow-md', 'shadow-indigo-600/30', 'font-bold');
              btn.classList.remove('bg-slate-800/80', 'text-slate-300', 'border-slate-700/60');

              if (badge) badge.textContent = '正在播放：' + newName + (hasDriveLinks ? ' (试看6分钟)' : '');
              if (loadingNotice) loadingNotice.classList.remove('hidden');

              initPlayer(newUrl);
            });
          });

          // 刷新按钮
          const reloadBtn = document.getElementById('reloadPlayerBtn');
          if (reloadBtn) {
            reloadBtn.addEventListener('click', () => {
              const currentUrl = (art && art.url) ? art.url : initialUrl;
              isCutoffActive = false;
              if (cutoffOverlay) cutoffOverlay.classList.add('hidden');
              if (loadingNotice) loadingNotice.classList.remove('hidden');
              initPlayer(currentUrl);
            });
          }
        });
      </script>
    </>
  )}

  <!-- 📱 移动端专属常驻吸底转存栏 (大拇指友好原生体验，高转化专属 CTA) -->
