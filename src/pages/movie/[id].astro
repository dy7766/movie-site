---
import Layout from '../../layouts/Layout.astro';
import { getMovies } from '../../lib/db.js';

export async function getStaticPaths() {
  const movies = await getMovies({ limit: 500 });
  return movies.map((movie) => ({
    params: { id: movie.id },
    props: { movie }
  }));
}

const { movie } = Astro.props;

const isTvShow = movie.category === '电视剧' || movie.category === '动漫' || movie.category === '综艺';

// 智能提取剧集总集数
let totalEpisodes = 0;
if (isTvShow) {
  const allText = (movie.tags?.join(' ') || '') + ' ' + (movie.title || '') + ' ' + (movie.intro || '');
  const match = allText.match(/全?(\d+)集/);
  if (match) {
    totalEpisodes = parseInt(match[1]);
  } else {
    if (movie.title.includes('繁花')) totalEpisodes = 30;
    else if (movie.title.includes('狂飙')) totalEpisodes = 39;
    else if (movie.title.includes('阿勒泰')) totalEpisodes = 8;
    else if (movie.title.includes('庆余年')) totalEpisodes = 36;
    else if (movie.title.includes('进击的巨人')) totalEpisodes = 28;
    else totalEpisodes = 24; // 常见剧集默认集数
  }
}

const pageTitle = `《${movie.title}》${movie.year ? `(${movie.year})` : ''} ${isTvShow ? `全${totalEpisodes}集完整版` : '4K完整版'} - 夸克/迅雷网盘在线转存下载`;
const pageDesc = `免费提供《${movie.title}》高清4K原盘资源高速转存与在线播放。主演：${movie.actors || '精选演员'}。剧情简介：${movie.intro ? movie.intro.slice(0, 120) : '暂无简介'}...`;

// 解析剧照与短评
const stills: string[] = Array.isArray(movie.stills)
  ? movie.stills
  : (typeof movie.stills === 'string' ? JSON.parse(movie.stills || '[]') : []);

interface Review {
  id: string;
  author: string;
  avatar?: string;
  rating: number;
  date: string;
  votes?: number;
  content: string;
}

const reviews: Review[] = Array.isArray(movie.reviews)
  ? movie.reviews
  : (typeof movie.reviews === 'string' ? JSON.parse(movie.reviews || '[]') : []);
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- 面包屑导航 -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8">
      <a href="/" class="hover:text-orange-400 transition-colors">首页</a>
      <span>/</span>
      <a href={`/?cat=${movie.category || '电影'}`} class="hover:text-orange-400 transition-colors">{movie.category || '电影'}</a>
      <span>/</span>
      <span class="text-slate-200 font-medium line-clamp-1">{movie.title}</span>
    </nav>

    <!-- 影视核心信息板块 -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 bg-slate-900/40 rounded-3xl p-6 sm:p-8 border border-slate-800/80 backdrop-blur-xl">
      <!-- 左侧：高清海报 -->
      <div class="md:col-span-4 lg:col-span-4 flex flex-col items-center">
        <div class="relative w-full max-w-[280px] aspect-[2/3] rounded-2xl overflow-hidden shadow-2xl border border-slate-700/60 group">
          <img 
            src={movie.poster_url || 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=600&auto=format&fit=crop'} 
            alt={movie.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          {movie.score && (
            <div class="absolute top-3 right-3 px-2.5 py-1 rounded-lg bg-black/70 backdrop-blur-md border border-white/10 text-amber-400 text-sm font-extrabold shadow-lg">
              ★ {Number(movie.score).toFixed(1)}
            </div>
          )}
        </div>
      </div>

      <!-- 右侧：影视详情与转存操作 -->
      <div class="md:col-span-8 lg:col-span-8 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="flex items-center gap-3 flex-wrap">
            <span class="px-3 py-1 rounded-lg bg-orange-500/20 text-orange-400 border border-orange-500/30 text-xs font-semibold">
              {movie.category || '电影'}
            </span>
            {isTvShow && (
              <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-semibold">
                更新至全 {totalEpisodes} 集完整版
              </span>
            )}
            {movie.year && (
              <span class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 text-xs font-medium">
                {movie.year} 年
              </span>
            )}
            {movie.share_link ? (
              <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                4K 原盘 / 资源就绪
              </span>
            ) : (
              <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                暂无网盘资源 · 排期中
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
            {movie.title}
          </h1>

          {movie.original_title && movie.original_title !== movie.title && (
            <p class="text-sm text-slate-400 font-mono">
              原名：{movie.original_title}
            </p>
          )}

          <!-- 标签分类 -->
          {movie.tags && movie.tags.length > 0 && (
            <div class="flex items-center gap-2 flex-wrap pt-1">
              <span class="text-xs text-slate-500">类型标签：</span>
              {movie.tags.map((tag: string) => (
                <span class="px-2 py-0.5 rounded bg-slate-800/80 border border-slate-700/60 text-slate-300 text-[11px]">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <!-- 主演阵容 -->
          <div class="pt-2 border-t border-slate-800/80">
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              <strong class="text-slate-400">演职阵容：</strong> {movie.actors || '暂无详细演职员信息'}
            </p>
          </div>

          <!-- 剧情简介 -->
          <div class="pt-2">
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">剧情简介</h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed bg-slate-950/40 p-4 rounded-xl border border-slate-800/60">
              {movie.intro || '暂无详细剧情介绍。'}
            </p>
          </div>
        </div>

        <!-- 核心变现行动转化区 (电影快速转存) -->
        {!isTvShow && (
          <div class="pt-6 border-t border-slate-800/80 space-y-4">
            {movie.share_link ? (
              <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                <a 
                  href={movie.share_link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="flex-1 py-4 px-6 rounded-2xl bg-gradient-to-r from-orange-500 via-orange-600 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-sm sm:text-base text-center shadow-xl shadow-orange-500/25 transition-all transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
                >
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
                  </svg>
                  <span>立即一键转存完整版（原画免流播放 / 高速下载）</span>
                </a>
              </div>
            ) : (
              <div class="rounded-2xl bg-slate-950/70 border border-amber-500/30 p-5 space-y-3">
                <div class="flex items-center gap-2.5 text-amber-400 font-semibold text-sm">
                  <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span>该片暂无可用网盘资源（正在排期整理中）</span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">
                  本片的高清 4K 原盘资源正在由管理员转存测试与校验中，暂未开放下载链接。您可以收藏本页面稍后访问，或优先观看当前已上线的热门力作：
                </p>
                <div class="pt-2 flex flex-wrap gap-2.5 items-center">
                  <a href="/movie/b25c137c-8ee5-4f4b-8640-0578e3f8c061" class="px-3.5 py-2 rounded-xl bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold shadow-md shadow-orange-500/20 transition-all flex items-center gap-1.5">
                    <span>🔥 推荐观看《空枪》（朱一龙 4K完整版）</span>
                  </a>
                  <a href="/movie/4eb48c96-df04-4e0f-ac19-49dd029fda9e" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 text-xs font-medium transition-all flex items-center gap-1.5">
                    <span>🎬 推荐观看《夜王》（黄子华 4K完整版）</span>
                  </a>
                  <a href="/" class="text-xs text-slate-500 hover:text-slate-400 transition-colors ml-auto">
                    返回首页发现更多 →
                  </a>
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- 电视剧 / 动漫专用：选集网格板块 -->
    {isTvShow && (
      <div class="mt-8 bg-slate-900/40 rounded-3xl p-6 sm:p-8 border border-slate-800/80 backdrop-blur-xl space-y-6">
        <div class="flex items-center justify-between flex-wrap gap-4 border-b border-slate-800 pb-4">
          <div class="flex items-center gap-2">
            <div class={`w-2.5 h-2.5 rounded-full ${movie.share_link ? 'bg-orange-500' : 'bg-slate-600'}`}></div>
            <h2 class="text-lg font-bold text-white">剧集选集播放与转存</h2>
            <span class="text-xs text-slate-400">（共 {totalEpisodes} 集 · 4K原画无损）</span>
          </div>

          <!-- 全集打包转存大按钮或待更新 -->
          {movie.share_link ? (
            <a 
              href={movie.share_link} 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl bg-orange-500 hover:bg-orange-600 text-white text-xs font-bold transition-all shadow-md shadow-orange-500/20 flex items-center gap-1.5"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
              </svg>
              <span>全集一键打包转存</span>
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-800/80 text-slate-400 text-xs font-medium border border-slate-700/60 flex items-center gap-1.5">
              <span>⏳ 剧集资源排期上传中</span>
            </span>
          )}
        </div>

        {!movie.share_link && (
          <div class="rounded-xl bg-slate-950/50 border border-amber-500/30 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
            <span class="text-amber-400">⚠️ 本剧全集 4K 原盘链接正在处理校验中，暂未开放下载。推荐先观看已上线大片：</span>
            <div class="flex gap-2">
              <a href="/movie/b25c137c-8ee5-4f4b-8640-0578e3f8c061" class="text-orange-400 hover:underline font-semibold">《空枪》4K完整版 →</a>
              <a href="/movie/4eb48c96-df04-4e0f-ac19-49dd029fda9e" class="text-slate-300 hover:underline">《夜王》→</a>
            </div>
          </div>
        )}

        <!-- 选集网格按钮 -->
        <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 gap-2.5 sm:gap-3">
          {Array.from({ length: totalEpisodes }, (_, i) => i + 1).map((ep) => (
            movie.share_link ? (
              <a 
                href={movie.share_link} 
                target="_blank" 
                rel="noopener noreferrer"
                class="group relative py-3 px-2 rounded-xl bg-slate-800/80 hover:bg-orange-500 text-slate-200 hover:text-white border border-slate-700/70 hover:border-orange-500 text-center transition-all flex flex-col items-center justify-center shadow-sm"
                title={`点击转存并观看 第 ${ep} 集`}
              >
                <span class="text-xs font-bold">第 {ep < 10 ? `0${ep}` : ep} 集</span>
                <span class="text-[9px] text-slate-400 group-hover:text-orange-100 scale-90">4K超清</span>
              </a>
            ) : (
              <div 
                class="relative py-3 px-2 rounded-xl bg-slate-900/60 text-slate-500 border border-slate-800/80 text-center flex flex-col items-center justify-center cursor-not-allowed select-none opacity-60"
                title="该集资源正在排期上传中"
              >
                <span class="text-xs font-medium">第 {ep < 10 ? `0${ep}` : ep} 集</span>
                <span class="text-[9px] text-slate-600 scale-90">待上线</span>
              </div>
            )
          ))}
        </div>

        <p class="text-xs text-slate-400 italic">
          💡 说明：{movie.share_link ? '点击上方任意分集，即可直接打开网盘对应剧集目录进行保存或原画在线播放。' : '本剧正在批量排期录入网盘，上线后点击任意分集即可直接转存播放。'}
        </p>
      </div>
    )}

    <!-- 高清精彩剧照与官方物料画廊 -->
    {stills && stills.length > 0 && (
      <div class="mt-8 bg-slate-900/40 rounded-3xl p-6 sm:p-8 border border-slate-800/80 backdrop-blur-xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-orange-500"></div>
            <h2 class="text-base sm:text-lg font-bold text-white">官方高清剧照与精彩瞬间</h2>
            <span class="text-xs text-slate-400">（共 {stills.length} 张高清剧照）</span>
          </div>
          <span class="text-xs text-slate-500 hidden sm:inline">点击剧照查看高清大图</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
          {stills.map((still: string, idx: number) => (
            <a 
              href={still} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative aspect-[16/10] sm:aspect-video rounded-xl sm:rounded-2xl overflow-hidden bg-slate-800 border border-slate-700/60 hover:border-orange-500/60 shadow-md hover:shadow-xl hover:shadow-orange-500/10 transition-all block"
            >
              <img 
                src={still} 
                alt={`${movie.title} 剧照 ${idx + 1}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                <span class="text-[11px] text-white font-medium flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                  </svg>
                  查看高清原图
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- 豆瓣热门短评 · 真实影迷口碑 -->
    {reviews && reviews.length > 0 && (
      <div class="mt-8 bg-slate-900/40 rounded-3xl p-6 sm:p-8 border border-slate-800/80 backdrop-blur-xl space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-bold flex items-center gap-1">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
              </svg>
              豆瓣口碑
            </span>
            <h2 class="text-base sm:text-lg font-bold text-white">热门精选短评</h2>
            <span class="text-xs text-slate-400">（影迷真实打分）</span>
          </div>
          <div class="flex items-center gap-1.5 text-xs text-amber-400 font-bold bg-amber-400/10 px-2.5 py-1 rounded-lg border border-amber-400/20">
            ★ {movie.score ? Number(movie.score).toFixed(1) : '8.0'} 综合评分
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {reviews.map((rev: Review) => (
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-950/50 border border-slate-800/70 hover:border-slate-700 transition-all flex flex-col justify-between space-y-3">
              <!-- 用户头部与评分 -->
              <div class="flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-orange-500 to-amber-400 text-white font-bold text-xs flex items-center justify-center shadow-sm">
                    {rev.avatar || rev.author[0]}
                  </div>
                  <div>
                    <div class="font-bold text-slate-200">{rev.author}</div>
                    <div class="text-[10px] text-slate-500">{rev.date}</div>
                  </div>
                </div>

                <!-- 评价星级 -->
                <div class="text-amber-400 text-xs tracking-wider">
                  {'★'.repeat(rev.rating || 4)}{'☆'.repeat(Math.max(0, 5 - (rev.rating || 4)))}
                </div>
              </div>

              <!-- 评价内容 -->
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed italic bg-slate-900/40 p-3 rounded-xl border border-slate-800/40">
                “{rev.content}”
              </p>

              <!-- 底部有用赞数 -->
              <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1">
                <span class="text-slate-500">来自豆瓣热门影评</span>
                <span class="hover:text-orange-400 transition-colors flex items-center gap-1 font-medium">
                  👍 {rev.votes || 320} 人觉得有用
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- 新手转存与使用指引卡片 -->
    <div class="mt-8 p-5 rounded-2xl bg-orange-500/5 border border-orange-500/15 text-xs text-slate-400 space-y-2">
      <div class="flex items-center gap-1.5 text-orange-400 font-semibold text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>新手观看与转存小指引</span>
      </div>
      <p>1. 点击上方【分集按钮】或【全集打包转存】，系统将安全跳转至夸克网盘官方页面，点击【保存到我的网盘】；</p>
      <p>2. 转存后手机端或电脑端打开夸克 App，在【网盘 - 最近转存】中即可享受<strong>免广告 4K/1080P 原画在线播放</strong>，支持倍速、投屏电视及离线缓存。</p>
    </div>

    <!-- 底部返回按钮 -->
    <div class="mt-10 text-center">
      <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-xs font-semibold text-slate-300 hover:text-white transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>返回首页发现更多好剧</span>
      </a>
    </div>
  </div>
</Layout>
