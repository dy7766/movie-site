      {movie.online_play_url && (
        <a 
          href="#onlinePlayerSection" 
          class="py-2.5 px-3 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 font-bold text-xs flex flex-col items-center justify-center border border-slate-700/80 active:scale-95 transition shrink-0 min-w-[52px]"
          data-track="play"
          data-resource-id={movie.id}
          data-resource-title={movie.title}
          title="跳转至网页播放器"
        >
          <svg class="w-4 h-4 text-indigo-400 fill-current" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <span class="text-[9px] text-slate-300">{(movie.share_link || movie.share_link_uc) ? '试看6分' : '试看'}</span>
        </a>
      )}
      {movie.share_link && (
        <a 
          href={movie.share_link} 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 py-2 px-2.5 rounded-xl bg-gradient-to-r from-orange-500 via-orange-600 to-amber-500 text-white font-extrabold text-xs flex flex-col items-center justify-center shadow-lg shadow-orange-500/25 active:scale-95 transition relative overflow-hidden"
          data-track="quark"
          data-resource-id={movie.id}
          data-resource-title={movie.title}
        >
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 fill-current text-amber-200" viewBox="0 0 24 24">
              <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
            </svg>
            <span>夸克 4K 秒存</span>
          </div>
          <span class="text-[9px] text-orange-100 font-medium scale-90 -mt-0.5">送1TB·支持投屏</span>
        </a>
      )}
      {movie.share_link_uc && (
        <a 
          href={movie.share_link_uc} 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex-1 py-2 px-2.5 rounded-xl bg-gradient-to-r from-amber-400 via-yellow-500 to-orange-500 text-slate-950 font-extrabold text-xs flex flex-col items-center justify-center shadow-lg shadow-amber-500/25 active:scale-95 transition relative overflow-hidden"
          data-track="uc"
          data-resource-id={movie.id}
          data-resource-title={movie.title}
        >
          <div class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 fill-current text-slate-950" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
            </svg>
            <span>UC 极速秒存</span>
          </div>
          <span class="text-[9px] text-slate-950 font-bold scale-90 -mt-0.5">官方特权·极速免流</span>
        </a>
      )}
    </div>
  )}
</Layout>
