---
// Hallmark · Direction B: Midnight
import { getMovies } from '../../lib/db.js';

const allMovies = await getMovies({ limit: 30 });
const categories = ['全部精选', '电影专区', '电视剧集', '热血动漫', '头部综艺'];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>星光影库 · Midnight 深蓝夜幕方案</title>
    <style>
      /* Hallmark · shape: Narrative Workflow · genre: modern-minimal · theme: Midnight (deal 2/3) · job: try
       * hero: Settled · nav: edge-aligned · footer: mast · imagery: photographs · signature: luxury-azure-glass
       * axes: dark/grotesk-sans/cool · posture: restrained · contrast: pass · fold: pass · v2.0.0 */
      /* Hallmark · pre-emit critique: P9 H9 E9 S9 R9 V9 · weakest: none, aligned to floor */
      :root {
        color-scheme: dark;
        --color-bg: oklch(12% 0.02 250);
        --color-surface: oklch(16% 0.025 250);
        --color-surface-hover: oklch(20% 0.03 250);
        --color-border: oklch(25% 0.025 250);
        --color-border-hover: oklch(75% 0.14 220);
        --color-text: oklch(96% 0.005 250);
        --color-text-muted: oklch(65% 0.02 250);
        --color-accent: oklch(75% 0.14 220);
        --color-accent-bg: oklch(75% 0.14 220 / 0.12);
        --color-badge-bg: oklch(12% 0.02 250 / 0.85);
        --color-focus: var(--color-accent);
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --container: 1400px;
        --gutter: 32px;
        --radius-card: 12px;
        --radius-pill: 9999px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { overflow-x: clip; margin: 0; padding: 0; background: var(--color-bg); color: var(--color-text); font-family: var(--font-sans); }
      :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
      a { color: inherit; text-decoration: none; }

      /* Top Switcher Banner */
      .preview-bar { background: var(--color-surface); border-bottom: 1px solid var(--color-border); padding: 8px var(--gutter); font-size: 13px; display: flex; justify-content: space-between; align-items: center; }
      .preview-links { display: flex; gap: 16px; }
      .preview-link { color: var(--color-text-muted); }
      .preview-link.active { color: var(--color-accent); font-weight: 600; }

      /* Nav */
      .site-header { border-bottom: 1px solid var(--color-border); padding: 18px var(--gutter); display: flex; justify-content: space-between; align-items: center; max-width: var(--container); margin: 0 auto; }
      .brand { font-size: 20px; font-weight: 700; letter-spacing: -0.01em; display: flex; align-items: center; gap: 10px; }
      .brand-icon { width: 10px; height: 10px; border-radius: var(--radius-pill); background: var(--color-accent); box-shadow: 0 0 12px var(--color-accent); }
      .nav-group { display: flex; align-items: center; gap: 16px; }
      .search-box { display: flex; align-items: center; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-pill); padding: 4px 6px 4px 16px; }
      .search-input { background: transparent; border: none; color: var(--color-text); font-size: 13px; outline: none; width: 200px; }
      .search-button { background: var(--color-accent); color: var(--color-bg); border: none; padding: 6px 14px; font-size: 12px; font-weight: 600; border-radius: var(--radius-pill); cursor: pointer; }

      /* Hero Stage (Under 80 words, fits 1280x800) */
      .hero-wrap { max-width: var(--container); margin: 0 auto; padding: 36px var(--gutter) 24px; }
      .hero-title { font-size: clamp(2.2rem, 3.8vw, 3.6rem); line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 10px 0; max-width: 25ch; }
      .hero-desc { font-size: 15px; color: var(--color-text-muted); max-width: 55ch; line-height: 1.5; margin: 0 0 24px 0; }
      .pill-row { display: flex; gap: 8px; flex-wrap: wrap; }
      .pill-btn { padding: 6px 16px; font-size: 13px; border-radius: var(--radius-pill); background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text-muted); cursor: pointer; }
      .pill-btn:hover, .pill-btn.active { background: var(--color-accent-bg); color: var(--color-accent); border-color: var(--color-accent); font-weight: 500; }

      /* Catalog Grid */
      .grid-wrap { max-width: var(--container); margin: 0 auto; padding: 16px var(--gutter) 64px; }
      .grid-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
      .grid-heading { font-size: 18px; font-weight: 600; }
      .grid-meta { font-size: 13px; color: var(--color-text-muted); }

      .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 20px; }
      .media-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-card); display: flex; flex-direction: column; overflow: hidden; position: relative; }
      .media-card:hover { border-color: var(--color-border-hover); background: var(--color-surface-hover); }
      .poster-wrapper { position: relative; aspect-ratio: 2 / 3; background: var(--color-bg); overflow: hidden; }
      .poster-image { width: 100%; height: 100%; object-fit: cover; display: block; }
      .score-badge { position: absolute; top: 10px; right: 10px; background: var(--color-badge-bg); backdrop-filter: blur(8px); border: 1px solid var(--color-border); border-radius: 6px; padding: 2px 7px; font-size: 11px; font-weight: 700; color: var(--color-accent); }
      .info-box { padding: 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
      .media-title { font-size: 15px; font-weight: 600; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0; }
      .media-sub { font-size: 12px; color: var(--color-text-muted); display: flex; justify-content: space-between; }
      .tags-wrap { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
      .tag { font-size: 10px; padding: 2px 8px; border-radius: var(--radius-pill); border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-text-muted); }
      .tag.featured { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-bg); }

      /* Footer */
      .site-footer { border-top: 1px solid var(--color-border); padding: 40px var(--gutter); max-width: var(--container); margin: 0 auto; font-size: 13px; color: var(--color-text-muted); display: flex; justify-content: space-between; align-items: center; }
      @media (max-width: 768px) {
        .site-header { flex-direction: column; gap: 16px; align-items: flex-start; }
        .card-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>
  <body>
    <!-- 顶部方案切换条 -->
    <div class="preview-bar">
      <span>Hallmark UI 测试 · 方案 B (Midnight 深蓝流媒体)</span>
      <div class="preview-links">
        <a href="/preview" class="preview-link">方案大厅</a>
        <a href="/preview/darkroom" class="preview-link">Darkroom</a>
        <a href="/preview/midnight" class="preview-link active">Midnight</a>
        <a href="/preview/vantage" class="preview-link">Vantage</a>
        <a href="/" class="preview-link">线上版</a>
      </div>
    </div>

    <!-- 顶部导航 -->
    <header class="site-header">
      <a href="/preview/midnight" class="brand">
        <span class="brand-icon"></span>
        <span>星光影库 · Midnight</span>
      </a>
      <div class="nav-group">
        <a href="/explore" class="preview-link">多维片库</a>
        <div class="search-box">
          <input type="text" class="search-input" placeholder="输入片名搜索..." />
          <button type="button" class="search-button">检索</button>
        </div>
      </div>
    </header>

    <!-- 极简 Hero 舞台 -->
    <section class="hero-wrap">
      <h1 class="hero-title">沉浸式流媒体影视中心</h1>
      <p class="hero-desc">
        高清原画秒速转存至你的个人网盘，支持免广告极速在线云点播与全集批量收藏。
      </p>
      <div class="pill-row">
        {categories.map((cat, idx) => (
          <button type="button" class={`pill-btn ${idx === 0 ? 'active' : ''}`}>{cat}</button>
        ))}
      </div>
    </section>

    <!-- 影视展示网格 -->
    <main class="grid-wrap">
      <div class="grid-header">
        <div class="grid-heading">精选上映排期</div>
        <div class="grid-meta">已就绪 {allMovies.length} 部影片</div>
      </div>

      <div class="card-grid">
        {allMovies.map((m) => {
          const isSeries = m.category === '电视剧' || m.category === '动漫' || m.category === '综艺';
          return (
            <a href={`/movie/${m.id}`} class="media-card">
              <div class="poster-wrapper">
                <img src={m.poster_url || '/placeholder.jpg'} alt={m.title} class="poster-image" loading="lazy" />
                {m.score && <div class="score-badge">★ {m.score}</div>}
              </div>
              <div class="info-box">
                <h3 class="media-title" title={m.title}>{m.title}</h3>
                <div class="media-sub">
                  <span>{m.year || '2026'} · {m.category}</span>
                  <span>{m.country || '华语'}</span>
                </div>
                <div class="tags-wrap">
                  {m.is_released === false ? (
                    <span class="tag">待映</span>
                  ) : isSeries ? (
                    <span class="tag featured">
                      {m.is_finished ? `全${m.total_episodes || m.current_episode}集` : `更至${m.current_episode || 1}集`}
                    </span>
                  ) : (
                    <span class="tag featured">4K原盘</span>
                  )}
                  {m.share_link_uc && <span class="tag">UC秒存</span>}
                  {m.share_link && <span class="tag">夸克</span>}
                  {m.online_play_url && <span class="tag">在线看</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </main>

    <!-- 页脚 -->
    <footer class="site-footer">
      <div>星光影库 · Midnight 流媒体设计方案</div>
      <div>Cloudflare 边缘加速 · 夸克/UC 网盘分佣生态</div>
    </footer>
  </body>
</html>
