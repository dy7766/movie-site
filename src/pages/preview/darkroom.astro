---
// Hallmark · Direction A: Darkroom
import { getMovies } from '../../lib/db.js';

const allMovies = await getMovies({ limit: 30 });
const categories = ['全部', '电影', '电视剧', '动漫', '综艺'];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>星光影库 · Darkroom 胶片暗室方案</title>
    <style>
      /* Hallmark · shape: Photographic · genre: atmospheric · theme: Darkroom (deal 1/3) · job: try
       * hero: Stage · nav: edge-aligned · footer: mast · imagery: photographs · signature: film-grain-archive
       * axes: dark/display-condensed/chromatic-amber · posture: restrained · contrast: pass · fold: pass · v2.0.0 */
      /* Hallmark · pre-emit critique: P9 H9 E9 S9 R9 V9 · weakest: none, aligned to floor */
      :root {
        color-scheme: dark;
        --color-paper: oklch(13% 0.008 50);
        --color-paper-2: oklch(17% 0.01 50);
        --color-paper-3: oklch(21% 0.012 50);
        --color-rule: oklch(28% 0.012 50);
        --color-rule-light: oklch(35% 0.015 50);
        --color-ink: oklch(93% 0.015 75);
        --color-muted: oklch(65% 0.015 70);
        --color-accent: oklch(74% 0.16 65);
        --color-accent-dim: oklch(40% 0.09 65);
        --color-focus: var(--color-accent);
        --font-display: "Sofia Sans Extra Condensed", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --container: 1400px;
        --gutter: 32px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { overflow-x: clip; margin: 0; padding: 0; background: var(--color-paper); color: var(--color-ink); font-family: var(--font-body); }
      :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
      a { color: inherit; text-decoration: none; }

      /* Top Switcher Banner */
      .preview-bar { background: var(--color-paper-3); border-bottom: 1px solid var(--color-rule); padding: 8px var(--gutter); font-size: 13px; display: flex; justify-content: space-between; align-items: center; }
      .preview-links { display: flex; gap: 16px; }
      .preview-link { color: var(--color-muted); }
      .preview-link.active { color: var(--color-accent); font-weight: 600; }

      /* Nav */
      .site-header { border-bottom: 1px solid var(--color-rule); padding: 20px var(--gutter); display: flex; justify-content: space-between; align-items: center; max-width: var(--container); margin: 0 auto; }
      .brand { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; display: flex; align-items: center; gap: 10px; }
      .brand-lamp { width: 8px; height: 8px; background: var(--color-accent); }
      .nav-actions { display: flex; align-items: center; gap: 20px; font-size: 14px; }
      .search-form { display: flex; align-items: center; background: var(--color-paper-2); border: 1px solid var(--color-rule); }
      .search-input { background: transparent; border: none; padding: 8px 12px; color: var(--color-ink); font-size: 13px; outline: none; width: 220px; }
      .search-btn { background: var(--color-accent); color: var(--color-paper); border: none; padding: 8px 14px; font-size: 13px; font-weight: 600; cursor: pointer; }

      /* Hero Stage (Under 80 words, fits 1280x800) */
      .hero-wrap { max-width: var(--container); margin: 0 auto; padding: 40px var(--gutter) 24px; border-bottom: 1px solid var(--color-rule); }
      .hero-headline { font-size: clamp(2.2rem, 4vw, 3.8rem); line-height: 1.05; letter-spacing: -0.03em; margin: 0 0 12px 0; font-weight: 700; max-width: 25ch; }
      .hero-sentence { font-size: 15px; color: var(--color-muted); max-width: 55ch; line-height: 1.5; margin: 0 0 20px 0; }
      .hero-filters { display: flex; gap: 8px; flex-wrap: wrap; }
      .filter-tab { padding: 6px 14px; font-size: 13px; background: var(--color-paper-2); border: 1px solid var(--color-rule); color: var(--color-muted); cursor: pointer; }
      .filter-tab:hover, .filter-tab.active { background: var(--color-paper-3); color: var(--color-ink); border-color: var(--color-accent); }

      /* Catalog Grid */
      .catalog-wrap { max-width: var(--container); margin: 0 auto; padding: 32px var(--gutter) 64px; }
      .catalog-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24px; }
      .catalog-title { font-size: 18px; font-weight: 600; }
      .catalog-count { font-size: 13px; color: var(--color-muted); }

      .film-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
      .film-cell { background: var(--color-paper-2); border: 1px solid var(--color-rule); display: flex; flex-direction: column; overflow: hidden; position: relative; }
      .film-cell:hover { border-color: var(--color-accent); }
      .poster-box { position: relative; aspect-ratio: 2 / 3; background: var(--color-paper-3); overflow: hidden; }
      .poster-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: contrast(1.03); }
      .score-flag { position: absolute; top: 8px; right: 8px; background: var(--color-paper); border: 1px solid var(--color-rule); padding: 2px 6px; font-size: 11px; font-weight: 700; color: var(--color-accent); }
      .film-meta { padding: 12px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
      .film-name { font-size: 15px; font-weight: 600; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0; }
      .film-sub { font-size: 12px; color: var(--color-muted); display: flex; justify-content: space-between; align-items: center; }
      .badge-row { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
      .film-badge { font-size: 10px; padding: 2px 6px; border: 1px solid var(--color-rule); background: var(--color-paper); color: var(--color-muted); }
      .film-badge.status { border-color: var(--color-accent-dim); color: var(--color-accent); }

      /* Masthead Footer */
      .site-footer { border-top: 1px solid var(--color-rule); padding: 48px var(--gutter); max-width: var(--container); margin: 0 auto; font-size: 13px; color: var(--color-muted); display: flex; justify-content: space-between; align-items: center; }
      @media (max-width: 768px) {
        .site-header { flex-direction: column; gap: 16px; align-items: flex-start; }
        .film-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>
  <body>
    <!-- 顶部方案切换条 -->
    <div class="preview-bar">
      <span>Hallmark UI 测试 · 方案 A (Darkroom 胶片暗室)</span>
      <div class="preview-links">
        <a href="/preview" class="preview-link">方案大厅</a>
        <a href="/preview/darkroom" class="preview-link active">Darkroom</a>
        <a href="/preview/midnight" class="preview-link">Midnight</a>
        <a href="/preview/vantage" class="preview-link">Vantage</a>
        <a href="/" class="preview-link">线上版</a>
      </div>
    </div>

    <!-- 导航栏 -->
    <header class="site-header">
      <a href="/preview/darkroom" class="brand">
        <span class="brand-lamp"></span>
        <span>星光影库 · 胶片馆</span>
      </a>
      <div class="nav-actions">
        <a href="/explore" class="preview-link">分类档案</a>
        <div class="search-form">
          <input type="text" class="search-input" placeholder="检索影片、导演或演员..." />
          <button type="button" class="search-btn">搜索</button>
        </div>
      </div>
    </header>

    <!-- 极简 Hero 舞台（符合 Hallmark 规则：80 字以内、首屏免滚可见） -->
    <section class="hero-wrap">
      <h1 class="hero-headline">海量原盘影片，瞬时转存入盘</h1>
      <p class="hero-sentence">
        专为影迷打造的纯净光影宝库。支持夸克网盘、UC网盘原画极速转存与在线切片点播，无广告干扰。
      </p>
      <div class="hero-filters">
        {categories.map((cat, idx) => (
          <button type="button" class={`filter-tab ${idx === 0 ? 'active' : ''}`}>{cat}</button>
        ))}
      </div>
    </section>

    <!-- 影片目录网格 -->
    <main class="catalog-wrap">
      <div class="catalog-header">
        <div class="catalog-title">档案陈列 · 最新入库精选</div>
        <div class="catalog-count">收录 {allMovies.length} 部已就绪影视</div>
      </div>

      <div class="film-grid">
        {allMovies.map((m) => {
          const isSeries = m.category === '电视剧' || m.category === '动漫' || m.category === '综艺';
          return (
            <a href={`/movie/${m.id}`} class="film-cell">
              <div class="poster-box">
                <img src={m.poster_url || '/placeholder.jpg'} alt={m.title} class="poster-img" loading="lazy" />
                {m.score && <div class="score-flag">{m.score}</div>}
              </div>
              <div class="film-meta">
                <h3 class="film-name" title={m.title}>{m.title}</h3>
                <div class="film-sub">
                  <span>{m.year || '2026'} / {m.category}</span>
                  <span>{m.country || '华语'}</span>
                </div>
                <div class="badge-row">
                  {m.is_released === false ? (
                    <span class="film-badge">待映</span>
                  ) : isSeries ? (
                    <span class="film-badge status">
                      {m.is_finished ? `全${m.total_episodes || m.current_episode}集` : `更至${m.current_episode || 1}集`}
                    </span>
                  ) : (
                    <span class="film-badge status">4K原盘</span>
                  )}
                  {m.share_link_uc && <span class="film-badge">UC</span>}
                  {m.share_link && <span class="film-badge">夸克</span>}
                  {m.online_play_url && <span class="film-badge">在线播</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </main>

    <!-- 页脚 -->
    <footer class="site-footer">
      <div>星光影库 · 暗室胶片档案方案</div>
      <div>零服务器带宽 · 网盘极速分发驱动</div>
    </footer>
  </body>
</html>
