---
// Hallmark · Direction F: Arcade (Cyber Retro CRT)
import { getMovies } from '../../lib/db.js';

const allMovies = await getMovies({ limit: 30 });
const categories = ['全部', '院线大片', '连载热播', '极客动画', '爆笑综艺'];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>星光影库 · Arcade 赛博霓虹方案</title>
    <style>
      /* Hallmark · shape: Arcade CRT · genre: playful · theme: Arcade (deal 2/3) · job: try
       * hero: Stage · nav: edge-aligned · footer: mast · imagery: photographs · signature: retro-crt-glow
       * axes: dark/pixel/chromatic-ember · posture: restrained · contrast: pass · fold: pass · v2.0.0 */
      /* Hallmark · pre-emit critique: P9 H9 E9 S9 R9 V9 · weakest: none, aligned to floor */
      :root {
        color-scheme: dark;
        --color-bg: oklch(14% 0.025 310);
        --color-surface: oklch(18% 0.03 310);
        --color-surface-hover: oklch(22% 0.035 310);
        --color-border: oklch(28% 0.03 310);
        --color-ink: oklch(95% 0.015 310);
        --color-muted: oklch(68% 0.02 310);
        --color-ember: oklch(70% 0.22 25);
        --color-ember-dim: oklch(70% 0.22 25 / 0.12);
        --color-acid: oklch(82% 0.2 145);
        --color-focus: var(--color-ember);
        --font-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --container: 1400px;
        --gutter: 32px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { overflow-x: clip; margin: 0; padding: 0; background: var(--color-bg); color: var(--color-ink); font-family: var(--font-sans); }
      :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
      a { color: inherit; text-decoration: none; }

      /* Top Switcher Banner */
      .preview-bar { background: var(--color-surface); border-bottom: 2px solid var(--color-border); padding: 8px var(--gutter); font-size: 13px; font-family: var(--font-mono); display: flex; justify-content: space-between; align-items: center; }
      .preview-links { display: flex; gap: 14px; flex-wrap: wrap; }
      .preview-link { color: var(--color-muted); }
      .preview-link.active { color: var(--color-ember); font-weight: 600; }

      /* Nav */
      .site-header { border-bottom: 2px solid var(--color-border); padding: 18px var(--gutter); display: flex; justify-content: space-between; align-items: center; max-width: var(--container); margin: 0 auto; }
      .brand { font-size: 20px; font-weight: 700; font-family: var(--font-mono); display: flex; align-items: center; gap: 10px; color: var(--color-ink); }
      .brand-badge { background: var(--color-ember); color: var(--color-bg); padding: 2px 6px; font-size: 12px; font-weight: 800; border-radius: 2px; }
      .nav-tools { display: flex; align-items: center; gap: 16px; }
      .search-form { display: flex; align-items: center; border: 2px solid var(--color-border); background: var(--color-surface); }
      .search-input { background: transparent; border: none; padding: 8px 12px; color: var(--color-ink); font-size: 13px; font-family: var(--font-mono); outline: none; width: 220px; }
      .search-btn { background: var(--color-ember); color: var(--color-bg); border: none; padding: 8px 14px; font-size: 12px; font-weight: 700; font-family: var(--font-mono); cursor: pointer; }

      /* Hero Stage (Under 80 words, fits 1280x800) */
      .hero-wrap { max-width: var(--container); margin: 0 auto; padding: 36px var(--gutter) 24px; border-bottom: 2px solid var(--color-border); }
      .hero-title { font-size: clamp(2.2rem, 3.8vw, 3.6rem); line-height: 1.1; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 10px 0; max-width: 25ch; }
      .hero-desc { font-size: 15px; color: var(--color-muted); max-width: 55ch; line-height: 1.5; margin: 0 0 20px 0; }
      .tag-row { display: flex; gap: 8px; flex-wrap: wrap; }
      .tag-btn { padding: 6px 14px; font-size: 12px; font-family: var(--font-mono); font-weight: 600; border: 2px solid var(--color-border); background: var(--color-surface); color: var(--color-muted); cursor: pointer; }
      .tag-btn:hover, .tag-btn.active { border-color: var(--color-ember); color: var(--color-ember); background: var(--color-ember-dim); }

      /* Grid */
      .catalog-wrap { max-width: var(--container); margin: 0 auto; padding: 28px var(--gutter) 64px; }
      .catalog-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
      .catalog-heading { font-size: 16px; font-weight: 700; font-family: var(--font-mono); }
      .catalog-stat { font-size: 12px; font-family: var(--font-mono); color: var(--color-acid); }

      .arcade-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 20px; }
      .arcade-card { background: var(--color-surface); border: 2px solid var(--color-border); display: flex; flex-direction: column; overflow: hidden; position: relative; }
      .arcade-card:hover { border-color: var(--color-ember); background: var(--color-surface-hover); transform: translateY(-2px); }
      .poster-slot { position: relative; aspect-ratio: 2 / 3; background: var(--color-bg); overflow: hidden; border-bottom: 2px solid var(--color-border); }
      .poster-slot img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .score-box { position: absolute; top: 8px; right: 8px; background: var(--color-bg); border: 2px solid var(--color-ember); padding: 2px 6px; font-size: 11px; font-family: var(--font-mono); font-weight: 800; color: var(--color-ember); }
      .meta-box { padding: 12px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
      .title-text { font-size: 14px; font-weight: 700; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0; }
      .sub-text { font-size: 11px; font-family: var(--font-mono); color: var(--color-muted); display: flex; justify-content: space-between; }
      .badge-rack { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
      .arcade-badge { font-size: 10px; font-family: var(--font-mono); padding: 2px 6px; border: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-muted); }
      .arcade-badge.special { border-color: var(--color-ember); color: var(--color-ember); }

      /* Footer */
      .site-footer { border-top: 2px solid var(--color-border); padding: 36px var(--gutter); max-width: var(--container); margin: 0 auto; font-size: 12px; font-family: var(--font-mono); color: var(--color-muted); display: flex; justify-content: space-between; align-items: center; }
      @media (max-width: 768px) {
        .site-header { flex-direction: column; gap: 16px; align-items: flex-start; }
        .arcade-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>
  <body>
    <!-- 顶部方案切换条 -->
    <div class="preview-bar">
      <span>Hallmark UI 测试 · 方案 F (Arcade 赛博霓虹放映厅)</span>
      <div class="preview-links">
        <a href="/preview" class="preview-link">方案大厅</a>
        <a href="/preview/darkroom" class="preview-link">Darkroom</a>
        <a href="/preview/midnight" class="preview-link">Midnight</a>
        <a href="/preview/vantage" class="preview-link">Vantage</a>
        <a href="/preview/newsprint" class="preview-link">Newsprint</a>
        <a href="/preview/dusk" class="preview-link">Dusk</a>
        <a href="/preview/arcade" class="preview-link active">Arcade</a>
      </div>
    </div>

    <!-- 导航栏 -->
    <header class="site-header">
      <a href="/preview/arcade" class="brand">
        <span class="brand-badge">ARCADE</span>
        <span>星光影库 · 潮酷放映厅</span>
      </a>
      <div class="nav-tools">
        <a href="/explore" class="preview-link">片库总览</a>
        <div class="search-form">
          <input type="text" class="search-input" placeholder="输入关键词检索..." />
          <button type="button" class="search-btn">搜索</button>
        </div>
      </div>
    </header>

    <!-- 极简 Hero 舞台 -->
    <section class="hero-wrap">
      <h1 class="hero-title">赛博潮酷放映厅，光速秒存入盘</h1>
      <p class="hero-desc">
        高饱和度霓虹视效与复古电波放映美学。全网优质剧集与热门大片秒存私盘，高清在线切片即开即播。
      </p>
      <div class="tag-row">
        {categories.map((cat, idx) => (
          <button type="button" class={`tag-btn ${idx === 0 ? 'active' : ''}`}>{cat}</button>
        ))}
      </div>
    </section>

    <!-- 影视展示网格 -->
    <main class="catalog-wrap">
      <div class="catalog-head">
        <div class="catalog-heading">PLAYLIST // 热门影视条目</div>
        <div class="catalog-stat">ONLINE: {allMovies.length} ITEMS</div>
      </div>

      <div class="arcade-grid">
        {allMovies.map((m) => {
          const isSeries = m.category === '电视剧' || m.category === '动漫' || m.category === '综艺';
          return (
            <a href={`/movie/${m.id}`} class="arcade-card">
              <div class="poster-slot">
                <img src={m.poster_url || '/placeholder.jpg'} alt={m.title} loading="lazy" />
                {m.score && <div class="score-box">{m.score}</div>}
              </div>
              <div class="meta-box">
                <h3 class="title-text" title={m.title}>{m.title}</h3>
                <div class="sub-text">
                  <span>{m.year || '2026'} / {m.category}</span>
                  <span>{m.country || '华语'}</span>
                </div>
                <div class="badge-row">
                  {m.is_released === false ? (
                    <span class="arcade-badge">待映</span>
                  ) : isSeries ? (
                    <span class="arcade-badge special">
                      {m.is_finished ? `全${m.total_episodes || m.current_episode}集` : `更至${m.current_episode || 1}集`}
                    </span>
                  ) : (
                    <span class="arcade-badge special">4K原盘</span>
                  )}
                  {m.share_link_uc && <span class="arcade-badge">UC转存</span>}
                  {m.share_link && <span class="arcade-badge">夸克</span>}
                  {m.online_play_url && <span class="arcade-badge">在线播</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </main>

    <!-- 页脚 -->
    <footer class="site-footer">
      <div>星光影库 · Arcade 赛博放映厅方案</div>
      <div>复古霓虹街机排版 · 动漫游戏影迷私享</div>
    </footer>
  </body>
</html>
