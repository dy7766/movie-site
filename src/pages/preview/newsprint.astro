---
// Hallmark · Direction D: Newsprint (Light Editorial)
import { getMovies } from '../../lib/db.js';

const allMovies = await getMovies({ limit: 30 });
const categories = ['全部收录', '经典院线', '热播连载', '独立动画', '纪录专题'];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>星光影库 · Newsprint 电影志周刊方案</title>
    <style>
      /* Hallmark · shape: Broadsheet Front · genre: editorial · theme: Newsprint (deal 1/3) · job: try
       * hero: Stage · nav: edge-aligned · footer: mast · imagery: photographs · signature: newsprint-journal
       * axes: light/slab-serif/warm · posture: restrained · contrast: pass · fold: pass · v2.0.0 */
      /* Hallmark · pre-emit critique: P9 H9 E9 S9 R9 V9 · weakest: none, aligned to floor */
      :root {
        color-scheme: light;
        --color-paper: oklch(97% 0.008 85);
        --color-paper-2: oklch(94% 0.01 85);
        --color-paper-3: oklch(91% 0.015 85);
        --color-rule: oklch(80% 0.01 85);
        --color-rule-dark: oklch(25% 0.01 85);
        --color-ink: oklch(20% 0.01 60);
        --color-muted: oklch(50% 0.01 60);
        --color-brick: oklch(55% 0.18 30);
        --color-brick-dim: oklch(55% 0.18 30 / 0.1);
        --shadow-film: 0 4px 12px oklch(20% 0.01 60 / 0.06);
        --color-focus: var(--color-brick);
        --font-serif: "Spectral", "Songti SC", SimSun, Georgia, serif;
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --container: 1400px;
        --gutter: 32px;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { overflow-x: clip; margin: 0; padding: 0; background: var(--color-paper); color: var(--color-ink); font-family: var(--font-sans); }
      :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
      a { color: inherit; text-decoration: none; }

      /* Top Switcher Banner */
      .preview-bar { background: var(--color-paper-3); border-bottom: 1px solid var(--color-rule); padding: 8px var(--gutter); font-size: 13px; display: flex; justify-content: space-between; align-items: center; }
      .preview-links { display: flex; gap: 14px; flex-wrap: wrap; }
      .preview-link { color: var(--color-muted); }
      .preview-link.active { color: var(--color-brick); font-weight: 600; }

      /* Masthead Nav */
      .site-header { border-bottom: 2px solid var(--color-rule-dark); padding: 24px var(--gutter) 16px; max-width: var(--container); margin: 0 auto; display: flex; justify-content: space-between; align-items: flex-end; }
      .brand-box { display: flex; flex-direction: column; gap: 2px; }
      .brand-title { font-family: var(--font-serif); font-size: 26px; font-weight: 700; letter-spacing: -0.01em; margin: 0; line-height: 1; }
      .brand-sub { font-size: 11px; color: var(--color-muted); letter-spacing: 0.02em; }
      .header-right { display: flex; align-items: center; gap: 20px; }
      .search-form { display: flex; align-items: center; border: 1px solid var(--color-rule-dark); background: var(--color-paper); }
      .search-input { border: none; padding: 8px 12px; font-size: 13px; background: transparent; outline: none; width: 220px; color: var(--color-ink); }
      .search-btn { background: var(--color-rule-dark); color: var(--color-paper); border: none; padding: 8px 14px; font-size: 12px; font-weight: 600; cursor: pointer; }

      /* Hero Stage (Under 80 words, fits 1280x800) */
      .hero-wrap { max-width: var(--container); margin: 0 auto; padding: 36px var(--gutter) 24px; border-bottom: 1px solid var(--color-rule); display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; }
      .hero-headline { font-family: var(--font-serif); font-size: clamp(2.2rem, 3.8vw, 3.6rem); line-height: 1.1; font-weight: 700; margin: 0 0 10px 0; max-width: 25ch; }
      .hero-desc { font-size: 15px; color: var(--color-muted); max-width: 55ch; line-height: 1.5; margin: 0 0 20px 0; }
      .tab-row { display: flex; gap: 6px; flex-wrap: wrap; }
      .tab-btn { padding: 6px 14px; font-size: 13px; font-family: var(--font-serif); background: var(--color-paper-2); border: 1px solid var(--color-rule); color: var(--color-muted); cursor: pointer; }
      .tab-btn:hover, .tab-btn.active { background: var(--color-paper); color: var(--color-brick); border-color: var(--color-brick); font-weight: 600; }
      .issue-stamp { border: 1px solid var(--color-rule-dark); padding: 8px 16px; font-family: var(--font-serif); font-size: 12px; color: var(--color-muted); text-align: center; }

      /* Catalog Grid */
      .catalog-wrap { max-width: var(--container); margin: 0 auto; padding: 28px var(--gutter) 64px; }
      .catalog-header { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--color-rule); padding-bottom: 12px; margin-bottom: 24px; }
      .catalog-title { font-family: var(--font-serif); font-size: 18px; font-weight: 600; }
      .catalog-meta { font-size: 13px; color: var(--color-muted); }

      .broadsheet-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 24px; }
      .film-card { background: var(--color-paper); border: 1px solid var(--color-rule); display: flex; flex-direction: column; }
      .film-card:hover { border-color: var(--color-rule-dark); box-shadow: var(--shadow-film); }
      .poster-frame { position: relative; aspect-ratio: 2 / 3; background: var(--color-paper-3); overflow: hidden; }
      .poster-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .score-stamp { position: absolute; top: 8px; right: 8px; background: var(--color-paper); border: 1px solid var(--color-rule-dark); padding: 2px 6px; font-family: var(--font-serif); font-size: 11px; font-weight: 700; color: var(--color-brick); }
      .card-info { padding: 12px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
      .card-title { font-family: var(--font-serif); font-size: 15px; font-weight: 600; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0; }
      .card-row { font-size: 12px; color: var(--color-muted); display: flex; justify-content: space-between; margin-top: 2px; }
      .tag-row { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
      .tag-item { font-size: 11px; padding: 1px 6px; border: 1px solid var(--color-rule); background: var(--color-paper-2); color: var(--color-muted); }
      .tag-item.primary { border-color: var(--color-brick); color: var(--color-brick); background: var(--color-brick-dim); }

      /* Footer */
      .site-footer { border-top: 2px solid var(--color-rule-dark); padding: 36px var(--gutter); max-width: var(--container); margin: 0 auto; font-size: 12px; color: var(--color-muted); display: flex; justify-content: space-between; align-items: center; }
      @media (max-width: 768px) {
        .hero-wrap { grid-template-columns: 1fr; }
        .site-header { flex-direction: column; gap: 16px; align-items: flex-start; }
        .broadsheet-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>
  <body>
    <!-- 顶部方案切换条 -->
    <div class="preview-bar">
      <span>Hallmark UI 测试 · 方案 D (Newsprint 电影志周刊)</span>
      <div class="preview-links">
        <a href="/preview" class="preview-link">方案大厅</a>
        <a href="/preview/darkroom" class="preview-link">Darkroom</a>
        <a href="/preview/midnight" class="preview-link">Midnight</a>
        <a href="/preview/vantage" class="preview-link">Vantage</a>
        <a href="/preview/newsprint" class="preview-link active">Newsprint</a>
        <a href="/preview/dusk" class="preview-link">Dusk</a>
        <a href="/preview/arcade" class="preview-link">Arcade</a>
      </div>
    </div>

    <!-- 刊头导航 -->
    <header class="site-header">
      <div class="brand-box">
        <h2 class="brand-title">星光影志 · 独立电影周刊</h2>
        <div class="brand-sub">STARLIGHT CINEMA GAZETTE // ISSUE 2026</div>
      </div>
      <div class="header-right">
        <div class="search-form">
          <input type="text" class="search-input" placeholder="查阅影志名录或导演..." />
          <button type="button" class="search-btn">检索</button>
        </div>
      </div>
    </header>

    <!-- 极简 Hero 舞台 -->
    <section class="hero-wrap">
      <div>
        <h1 class="hero-headline">典藏级原盘影录，一键收归私盘</h1>
        <p class="hero-desc">
          以独立电影志排印美学，呈现国内外高分院线与热播大剧。支持双网盘极速转存与在线流媒体回放。
        </p>
        <div class="tab-row">
          {categories.map((cat, idx) => (
            <button type="button" class={`tab-btn ${idx === 0 ? 'active' : ''}`}>{cat}</button>
          ))}
        </div>
      </div>
      <div class="issue-stamp">
        <div>WEEKLY REVIEW</div>
        <div style="font-size: 14px; font-weight: 700; color: var(--color-ink); margin-top: 4px;">VOL. 46</div>
      </div>
    </section>

    <!-- 目录索引网格 -->
    <main class="catalog-wrap">
      <div class="catalog-header">
        <div class="catalog-title">本期特刊 · 重点篇目</div>
        <div class="catalog-meta">当前收录 {allMovies.length} 篇作品</div>
      </div>

      <div class="broadsheet-grid">
        {allMovies.map((m) => {
          const isSeries = m.category === '电视剧' || m.category === '动漫' || m.category === '综艺';
          return (
            <a href={`/movie/${m.id}`} class="film-card">
              <div class="poster-frame">
                <img src={m.poster_url || '/placeholder.jpg'} alt={m.title} loading="lazy" />
                {m.score && <div class="score-stamp">{m.score}</div>}
              </div>
              <div class="card-info">
                <h3 class="card-title" title={m.title}>{m.title}</h3>
                <div class="card-row">
                  <span>{m.year || '2026'} / {m.category}</span>
                  <span>{m.country || '华语'}</span>
                </div>
                <div class="tag-row">
                  {m.is_released === false ? (
                    <span class="tag-item">待映</span>
                  ) : isSeries ? (
                    <span class="tag-item primary">
                      {m.is_finished ? `全${m.total_episodes || m.current_episode}集` : `更至${m.current_episode || 1}集`}
                    </span>
                  ) : (
                    <span class="tag-item primary">4K典藏</span>
                  )}
                  {m.share_link_uc && <span class="tag-item">UC</span>}
                  {m.share_link && <span class="tag-item">夸克</span>}
                  {m.online_play_url && <span class="tag-item">在线</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </main>

    <!-- 刊尾 -->
    <footer class="site-footer">
      <div>星光影志 · 独立电影周刊版式方案</div>
      <div>印本排印美学 · 高分口碑影评引流</div>
    </footer>
  </body>
</html>
